# Build output.
#
# `build/` holds generated Roblox files -- run `python3 tools/build_rbxmx.py` to
# recreate them from src/ at any time. They are deliberately NOT committed: they
# are a derived artifact of the source, and checking in a few hundred KB of
# generated XML on every code change makes the history unreadable.
/build/
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx
*.rbxl.lock
*.rbxlx.lock
*.zip
!build/*.rbxlx

# Source archives produced with `git archive` for sharing. Regenerable from any
# commit, and a copy of the repo inside the repo -- never commit these.
/DollysHome-source.zip
/*.zip
/*.tar.gz

# Tooling
/sourcemap.json
/.rokit/
/.aftman/
/roblox.toml

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
!.vscode/settings.json
.idea/

# Luau LSP artifacts
/globalTypes.d.luau
/*.d.luau
