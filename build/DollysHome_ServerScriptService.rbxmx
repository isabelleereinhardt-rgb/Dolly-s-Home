<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="Script" referent="RBX36">
		<Properties>
			<string name="Name">DollysHome</string>
			<ProtectedString name="Source"><![CDATA[--!strict
--[[
	init.server.luau
	--------------------------------------------------------------------------
	Server bootstrap for Dolly's Home.

	Start order matters. Services that only wire up event handlers can go in any
	order, but a few have real dependencies:

	  * Net must exist before anything fires a remote (requiring Shared.Net
	    builds the folder, which the first require below does).
	  * TeamService creates the teams every other service checks membership
	    against.
	  * MapService.buildLobby must run before ShopService looks for the shop
	    stand and before GameStateManager tries to teleport anyone.
	  * GameStateManager goes last, because starting it starts the round loop.
	--------------------------------------------------------------------------
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net) -- builds ReplicatedStorage.DollysHome
local StateKeys = require(Shared.StateKeys)

--[[
	Atmosphere.

	These are set here rather than left to the Rojo project file, so the game
	looks right whether it was synced with Rojo or dragged in from an .rbxmx.
	Each is applied on its own so that one unwritable property (Technology is
	Studio-only on some versions) can't take the rest down with it.
]]
local function applyAtmosphere()
	local lightingProps = {
		Ambient = Color3.fromRGB(13, 13, 18),
		OutdoorAmbient = Color3.fromRGB(23, 26, 33),
		Brightness = 1,
		ClockTime = 0,
		GeographicLatitude = 30,
		FogColor = Color3.fromRGB(23, 26, 23),
		FogStart = 40,
		FogEnd = 260,
		GlobalShadows = true,
		EnvironmentDiffuseScale = 0.35,
		EnvironmentSpecularScale = 0.2,
		Technology = Enum.Technology.ShadowMap,
	}

	for property, value in lightingProps do
		pcall(function()
			(Lighting :: any)[property] = value
		end)
	end

	-- Players who reset come back to the lobby; three seconds is long enough to
	-- read the results screen but short enough not to feel like a punishment.
	pcall(function()
		Players.RespawnTime = 3
	end)
end

applyAtmosphere()

local Services = script.Services

local AvaService = require(Services.AvaService)
local CombatService = require(Services.CombatService)
local DataService = require(Services.DataService)
local GameStateManager = require(Services.GameStateManager)
local HidingService = require(Services.HidingService)
local MapService = require(Services.MapService)
local NoiseService = require(Services.NoiseService)
local ObjectiveService = require(Services.ObjectiveService)
local PlayerService = require(Services.PlayerService)
local RevivalService = require(Services.RevivalService)
local SafeZoneService = require(Services.SafeZoneService)
local ShopService = require(Services.ShopService)
local StatsService = require(Services.StatsService)
local TeamService = require(Services.TeamService)
local VoteService = require(Services.VoteService)

Net.setStateValue(StateKeys.Game.Phase, StateKeys.Phase.Booting)

local START_ORDER: { { Name: string, Start: () -> () } } = {
	{ Name = "TeamService", Start = TeamService.start },
	{ Name = "DataService", Start = DataService.start },
	{ Name = "NoiseService", Start = NoiseService.start },
	{ Name = "PlayerService", Start = PlayerService.start },
	{ Name = "RevivalService", Start = RevivalService.start },
	{ Name = "HidingService", Start = HidingService.start },
	{ Name = "SafeZoneService", Start = SafeZoneService.start },
	{ Name = "ObjectiveService", Start = ObjectiveService.start },
	{ Name = "CombatService", Start = CombatService.start },
	{ Name = "VoteService", Start = VoteService.start },
	{ Name = "StatsService", Start = StatsService.start },
	{ Name = "AvaService", Start = AvaService.start },
	{ Name = "ShopService", Start = ShopService.start },
}

MapService.buildLobby()

for _, entry in START_ORDER do
	local ok, err = pcall(entry.Start)
	if not ok then
		warn(`[DollysHome] {entry.Name} failed to start: {err}`)
	end
end

GameStateManager.start()

print(
	`[DollysHome] server ready -- {Config.Round.RoundSeconds // 60} minute rounds, `
		.. `{Config.Round.IntermissionSeconds}s intermission, `
		.. `{#Config.getEnabledMaps()} map(s) enabled.`
)
]]></ProtectedString>
		</Properties>
		<Item class="Folder" referent="RBX12">
			<Properties>
				<string name="Name">AI</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX11">
				<Properties>
					<string name="Name">KillerAgent</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	KillerAgent.luau
	--------------------------------------------------------------------------
	One instance per active killer. Runs a four-state machine:

	  PATROL       walk a route through the killer's favoured rooms
	  INVESTIGATE  something was heard; go there and search around it
	  CHASE        a loud noise or a direct sighting; run the target down
	  STUNNED      staked; frozen in place

	The family is blind. Everything they know comes from NoiseService, which
	means a player's noise meter is the whole conversation between them and the
	AI. Vision exists only as a short-range backstop so standing directly in
	front of a killer isn't free (and can be switched off in Config).

	Two coroutines per agent: a think loop that decides *where*, and a
	navigation loop that handles *how*. They communicate through
	`self.destination` plus a version counter, so a new decision cancels an
	in-flight path immediately rather than waiting for the old walk to finish.
	--------------------------------------------------------------------------
]]

local CollectionService = game:GetService("CollectionService")
local PathfindingService = game:GetService("PathfindingService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local KillerData = require(Shared.KillerData)
local Net = require(Shared.Net)
local StateKeys = require(Shared.StateKeys)
local Tags = require(Shared.Tags)
local Util = require(Shared.Util)

local HidingService = require(script.Parent.Parent.Services.HidingService)
local MapService = require(script.Parent.Parent.Services.MapService)
local NoiseService = require(script.Parent.Parent.Services.NoiseService)
local RevivalService = require(script.Parent.Parent.Services.RevivalService)
local TeamService = require(script.Parent.Parent.Services.TeamService)

local STATE = {
	Patrol = "Patrol",
	Investigate = "Investigate",
	Chase = "Chase",
	Stunned = "Stunned",
}

local THINK_INTERVAL = 0.15

local KillerAgent = {}
KillerAgent.__index = KillerAgent

export type Agent = typeof(setmetatable({} :: any, KillerAgent))

--==========================================================================
-- Safe zones
--==========================================================================

--- Returns (centre, radius) of the active safe zone containing `position`.
local function safeZoneContaining(position: Vector3): (Vector3?, number?)
	for _, tag in { Tags.SafeZone, Tags.TempSafeZone } do
		for _, zone in CollectionService:GetTagged(tag) do
			if not zone:IsA("BasePart") or not zone.Parent then
				continue
			end
			-- Only zones in the live map; CollectionService also returns the
			-- ones sitting in ServerStorage map templates.
			if not zone:IsDescendantOf(Workspace) then
				continue
			end
			if zone:GetAttribute("Active") == false then
				continue
			end
			local radius = (zone:GetAttribute("Radius") :: number?)
				or math.max(zone.Size.X, zone.Size.Z) / 2
			if (zone.Position - position).Magnitude <= radius then
				return zone.Position, radius
			end
		end
	end
	return nil, nil
end

--==========================================================================
-- Construction
--==========================================================================

function KillerAgent.new(killerId: string, model: Model): Agent?
	local profile = KillerData.get(killerId)
	if not profile then
		Util.warn("KillerAgent", 'unknown killer id "%s"', killerId)
		return nil
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root then
		Util.warn("KillerAgent", "%s has no Humanoid or HumanoidRootPart", model.Name)
		return nil
	end

	local self = setmetatable({}, KillerAgent)

	self.killerId = killerId
	self.profile = profile
	self.model = model
	self.humanoid = humanoid
	self.root = root

	self.state = STATE.Patrol
	self.active = false

	self.destination = nil :: Vector3?
	self.destVersion = 0
	self.navComplete = -1

	self.target = nil :: Player?
	self.lastHeardPosition = nil :: Vector3?
	self.lastHeardAt = 0
	self.silenceSince = 0
	self.investigateUntil = 0

	self.stunnedUntil = 0
	self.health = profile.MaxHealth
	self.lastHitAt = 0
	self.lastAttackAt = 0
	self.lastLineAt = 0

	-- Passing the id gets this killer their hand-authored route from the map
	-- data, in order, rather than a guess from room names.
	self.patrolNodes = MapService.getPatrolNodes(killerId, profile.PatrolZones, profile.CanUseCrawlspaces)
	self.patrolIndex = 1
	self.rng = Random.new()

	self.path = PathfindingService:CreatePath({
		AgentRadius = Config.Killer.AgentRadius,
		AgentHeight = Config.Killer.AgentHeight,
		AgentCanJump = Config.Killer.AgentCanJump,
		WaypointSpacing = 6,
	})

	self.stuckPosition = root.Position
	self.stuckSince = os.clock()

	model:SetAttribute(StateKeys.Killer.KillerId, killerId)
	model:SetAttribute(StateKeys.Killer.AIState, STATE.Patrol)
	model:SetAttribute(StateKeys.Killer.Health, self.health)
	model:SetAttribute(StateKeys.Killer.MaxHealth, profile.MaxHealth)
	model:SetAttribute(StateKeys.Killer.StunnedUntil, 0)
	CollectionService:AddTag(model, Tags.ActiveKiller)

	if Config.Debug.ShowKillerState then
		self:_buildDebugLabel()
	end

	return self
end

function KillerAgent:_buildDebugLabel()
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "DebugState"
	billboard.Size = UDim2.fromScale(10, 2)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 5, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = self.model

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Code
	label.TextColor3 = Color3.fromRGB(255, 220, 120)
	label.TextStrokeTransparency = 0
	label.TextScaled = true
	label.Parent = billboard

	task.spawn(function()
		while self.active or self.model.Parent do
			label.Text = `{self.profile.Name}: {self.state} ({math.floor(self.health)})`
			task.wait(0.2)
		end
	end)
end

--==========================================================================
-- State
--==========================================================================

function KillerAgent:_setState(newState: string)
	if self.state == newState then
		return
	end
	self.state = newState
	self.model:SetAttribute(StateKeys.Killer.AIState, newState)

	if newState == STATE.Chase then
		self.humanoid.WalkSpeed = self.profile.ChaseSpeed
	elseif newState == STATE.Investigate then
		-- A shade quicker than a patrol, but not a sprint.
		self.humanoid.WalkSpeed = self.profile.PatrolSpeed + 2
	elseif newState == STATE.Patrol then
		self.humanoid.WalkSpeed = self.profile.PatrolSpeed
		self.target = nil
		self.model:SetAttribute(StateKeys.Killer.TargetName, "")
	elseif newState == STATE.Stunned then
		self.humanoid.WalkSpeed = 0
		self:_setDestination(nil)
	end

	Util.log("KillerAgent", "%s -> %s", self.profile.Name, newState)
end

function KillerAgent:_setDestination(position: Vector3?)
	self.destination = position
	self.destVersion += 1
end

--==========================================================================
-- Senses
--==========================================================================

function KillerAgent:_hasLineOfSight(position: Vector3): boolean
	local origin = self.root.Position + Vector3.new(0, 2, 0)
	local direction = position - origin
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { self.model }
	params.IgnoreWater = true

	local result = Workspace:Raycast(origin, direction, params)
	if not result then
		return true
	end
	-- Anything within a couple of studs of the target counts as reaching it.
	return (result.Position - position).Magnitude < 3
end

--- Short-range sight, used only as a backstop to the hearing system.
function KillerAgent:_findVisibleTarget(): (Player?, Vector3?)
	if not Config.Killer.Vision.Enabled then
		return nil, nil
	end

	for _, player in TeamService.getAlive() do
		if player:GetAttribute(StateKeys.Player.Hidden) == true then
			continue
		end
		if player:GetAttribute(StateKeys.Player.InSafeZone) == true then
			continue
		end

		local position = Util.getPosition(player)
		if not position then
			continue
		end
		if (position - self.root.Position).Magnitude > Config.Killer.Vision.Range then
			continue
		end
		if Util.angleTo(self.root.CFrame, position) > Config.Killer.Vision.FieldOfViewDegrees / 2 then
			continue
		end
		if self:_hasLineOfSight(position) then
			return player, position
		end
	end
	return nil, nil
end

--==========================================================================
-- Actions
--==========================================================================

function KillerAgent:_speak()
	local now = Util.now()
	if now - self.lastLineAt < 12 then
		return
	end
	self.lastLineAt = now

	local line = Util.pick(self.profile.Lines, self.rng)
	if not line then
		return
	end

	-- Only players close enough to hear it get the line.
	for _, player in TeamService.getParticipants() do
		local position = Util.getPosition(player)
		if position and (position - self.root.Position).Magnitude < 55 then
			Net.fire(player, "Announce", {
				Kind = "KillerLine",
				Text = line,
				Speaker = self.profile.Name,
			})
		end
	end
end

function KillerAgent:_tryAttack(player: Player): boolean
	local now = Util.now()
	if now - self.lastAttackAt < Config.Killer.AttackCooldown then
		return false
	end

	local position = Util.getPosition(player)
	if not position then
		return false
	end
	if (position - self.root.Position).Magnitude > Config.Killer.AttackRange then
		return false
	end
	if player:GetAttribute(StateKeys.Player.InSafeZone) == true then
		return false
	end

	self.lastAttackAt = now

	-- Brief windup so a hit is dodgeable rather than instantaneous.
	task.delay(Config.Killer.AttackWindup, function()
		if not self.active or self.state == STATE.Stunned then
			return
		end
		local currentPosition = Util.getPosition(player)
		if not currentPosition then
			return
		end
		if (currentPosition - self.root.Position).Magnitude > Config.Killer.AttackRange + 3 then
			return -- they got out of reach
		end
		RevivalService.applyDamage(player, Config.Killer.AttackDamage, self.profile.Name)
	end)

	return true
end

--- Rolls to tear open hiding spots near an investigation point.
function KillerAgent:_searchHidingSpots(around: Vector3)
	local spots = HidingService.getSpotsNear(around, Config.Killer.HidingSpotCheckRange)
	for _, spot in spots do
		local distance = (spot.Position - self.root.Position).Magnitude
		local chance = distance < 8 and Config.Killer.HidingSpotCheckChanceClose
			or Config.Killer.HidingSpotCheckChance
		chance *= self.profile.SearchAggression

		-- Someone camping a spot for a long time has all but told the family
		-- where they are.
		if HidingService.isSpotSuspicious(spot) then
			chance = math.min(1, chance * 2)
		end

		if self.rng:NextNumber() <= chance then
			local found = HidingService.searchSpot(spot)
			if found then
				self.target = found
				self:_setState(STATE.Chase)
				local position = Util.getPosition(found)
				if position then
					self:_setDestination(position)
				end
				return
			end
		end
	end
end

--==========================================================================
-- Think loop
--==========================================================================

function KillerAgent:_pickPatrolDestination()
	if #self.patrolNodes == 0 then
		self.patrolNodes =
			MapService.getPatrolNodes(self.killerId, self.profile.PatrolZones, self.profile.CanUseCrawlspaces)
		if #self.patrolNodes == 0 then
			return
		end
	end

	-- Mostly walk the route in order (so patrols read as routes, not as random
	-- teleporting), but jump elsewhere occasionally so players can't set a watch
	-- by it.
	if self.rng:NextNumber() < 0.25 then
		self.patrolIndex = self.rng:NextInteger(1, #self.patrolNodes)
	else
		self.patrolIndex = (self.patrolIndex % #self.patrolNodes) + 1
	end

	local node = self.patrolNodes[self.patrolIndex]
	if node and node.Parent then
		self:_setDestination(node.Position)
	end
end

function KillerAgent:_think()
	local now = Util.now()

	-- Stun ----------------------------------------------------------------
	if now < self.stunnedUntil then
		if self.state ~= STATE.Stunned then
			self:_setState(STATE.Stunned)
		end
		return
	elseif self.state == STATE.Stunned then
		-- Coming out of a stun, they resume hunting whoever staked them.
		self:_setState(self.target and STATE.Chase or STATE.Investigate)
		self.investigateUntil = now + Config.Killer.InvestigateMemory
	end

	-- Health regeneration --------------------------------------------------
	if now - self.lastHitAt > Config.Killer.RegenDelayAfterHit and self.health < self.profile.MaxHealth then
		self.health = math.min(
			self.profile.MaxHealth,
			self.health + self.profile.MaxHealth * Config.Killer.RegenPerSecond * THINK_INTERVAL
		)
		self.model:SetAttribute(StateKeys.Killer.Health, math.floor(self.health))
	end

	-- Safe zones repel ------------------------------------------------------
	local zoneCentre, zoneRadius = safeZoneContaining(self.root.Position)
	if zoneCentre and zoneRadius then
		local away = self.root.Position - zoneCentre
		if away.Magnitude < 0.1 then
			away = self.root.CFrame.LookVector
		end
		self:_setDestination(zoneCentre + away.Unit * (zoneRadius + 12))
		self:_setState(STATE.Patrol)
		return
	end

	-- Hearing ----------------------------------------------------------------
	local heardPlayer, heardPosition, tier =
		NoiseService.findAudibleTarget(self.root.Position, self.profile.HearingMultiplier)

	local seenPlayer, seenPosition = self:_findVisibleTarget()
	if seenPlayer and seenPosition then
		heardPlayer, heardPosition = seenPlayer, seenPosition
		tier = Config.Noise.Tiers[#Config.Noise.Tiers]
	end

	if heardPlayer and heardPosition and tier then
		self.lastHeardPosition = heardPosition
		self.lastHeardAt = now
		self.silenceSince = 0

		if tier.Response == "Rush" or tier.Response == "Investigate" or seenPlayer then
			self.target = heardPlayer
			self.model:SetAttribute(StateKeys.Killer.TargetName, heardPlayer.DisplayName)
			self:_setState(STATE.Chase)
			self:_setDestination(heardPosition)
			self:_speak()
		elseif tier.Response == "Turn" then
			if self.state ~= STATE.Chase then
				self:_setState(STATE.Investigate)
				self.investigateUntil = now + Config.Killer.InvestigateMemory * self.profile.Persistence
				self:_setDestination(heardPosition)
			end
		end
	elseif self.silenceSince == 0 then
		self.silenceSince = now
	end

	-- Per-state behaviour -----------------------------------------------------
	if self.state == STATE.Chase then
		local target = self.target
		if not target or not TeamService.isAlive(target) then
			self.target = nil
			self:_setState(STATE.Investigate)
			self.investigateUntil = now + Config.Killer.InvestigateMemory
			return
		end

		if target:GetAttribute(StateKeys.Player.InSafeZone) == true then
			-- Can't follow them in. Prowl the perimeter instead.
			self:_setState(STATE.Investigate)
			self.investigateUntil = now + Config.Killer.InvestigateMemory
			return
		end

		local targetPosition = Util.getPosition(target)
		if targetPosition then
			local visible = self:_hasLineOfSight(targetPosition)
			local audible = heardPlayer == target

			if visible or audible then
				self.lastHeardPosition = targetPosition
				self.lastHeardAt = now
				self:_setDestination(targetPosition)
				self:_tryAttack(target)
			else
				-- Lost them. Persistence decides how long they keep coming.
				local silence = now - self.lastHeardAt
				if silence > Config.Killer.ChaseGiveUpSilence * self.profile.Persistence then
					self.target = nil
					self:_setState(STATE.Investigate)
					self.investigateUntil = now + Config.Killer.InvestigateMemory
					self:_searchHidingSpots(self.lastHeardPosition or self.root.Position)
				else
					self:_setDestination(self.lastHeardPosition or targetPosition)
				end
			end
		end
		return
	end

	if self.state == STATE.Investigate then
		if now > self.investigateUntil then
			self:_setState(STATE.Patrol)
			self:_pickPatrolDestination()
			return
		end

		local arrived = self.navComplete == self.destVersion
		if arrived or not self.destination then
			-- Poke around the area: check hiding spots, then wander a little.
			self:_searchHidingSpots(self.root.Position)
			if self.state ~= STATE.Investigate then
				return -- the search turned up someone
			end

			local anchor = self.lastHeardPosition or self.root.Position
			local angle = self.rng:NextNumber(0, math.pi * 2)
			local radius = self.rng:NextNumber(4, Config.Killer.SearchRadius)
			self:_setDestination(anchor + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius))
		end
		return
	end

	-- Patrol
	if self.navComplete == self.destVersion or not self.destination then
		self:_pickPatrolDestination()
	end
end

--==========================================================================
-- Navigation loop
--==========================================================================

function KillerAgent:_onStuck()
	-- Jump and pick somewhere else. Better than standing in a doorway forever.
	self.humanoid.Jump = true
	if self.state == STATE.Patrol then
		self:_pickPatrolDestination()
	else
		local angle = self.rng:NextNumber(0, math.pi * 2)
		self:_setDestination(self.root.Position + Vector3.new(math.cos(angle) * 12, 0, math.sin(angle) * 12))
	end
end

function KillerAgent:_walkWaypoints(waypoints: { PathWaypoint }, version: number): boolean
	for index = 2, #waypoints do
		if not self.active or self.destVersion ~= version then
			return false
		end

		local waypoint = waypoints[index]
		if waypoint.Action == Enum.PathWaypointAction.Jump then
			self.humanoid.Jump = true
		end
		self.humanoid:MoveTo(waypoint.Position)

		local deadline = os.clock() + 4
		while self.active and self.destVersion == version do
			local delta = self.root.Position - waypoint.Position
			if Vector3.new(delta.X, 0, delta.Z).Magnitude <= Config.Killer.WaypointReachedDistance then
				break
			end
			if os.clock() > deadline then
				self:_onStuck()
				return false
			end
			task.wait(0.05)
		end
	end
	return true
end

function KillerAgent:_navigate()
	while self.active do
		local version = self.destVersion
		local destination = self.destination

		if destination and self.state ~= STATE.Stunned then
			local ok = pcall(function()
				self.path:ComputeAsync(self.root.Position, destination)
			end)

			if ok and self.path.Status == Enum.PathStatus.Success then
				self:_walkWaypoints(self.path:GetWaypoints(), version)
			else
				-- No path (a target on the far side of a wall, or a destination
				-- inside geometry). Head that way directly and let the think loop
				-- pick something better next tick.
				self.humanoid:MoveTo(destination)
				task.wait(0.4)
			end

			if self.destVersion == version then
				self.navComplete = version
			end
		end

		task.wait(0.1)
	end
end

--==========================================================================
-- Public
--==========================================================================

--- Applies stake damage. Returns the killer's remaining HP.
--- Killers are immortal; emptying the bar just buys a longer stun.
function KillerAgent:damage(amount: number, stunSeconds: number): number
	self.lastHitAt = Util.now()
	self.health = math.max(0, self.health - amount)
	self.model:SetAttribute(StateKeys.Killer.Health, math.floor(self.health))

	local stun = stunSeconds
	if self.health <= 0 then
		stun += Config.Stakes.StunOnDepleted
		self.health = 0
	end
	self:stun(stun)
	return self.health
end

function KillerAgent:stun(seconds: number)
	self.stunnedUntil = math.max(self.stunnedUntil, Util.now() + seconds)
	self.model:SetAttribute(StateKeys.Killer.StunnedUntil, self.stunnedUntil)
	self:_setState(STATE.Stunned)
	self.humanoid.WalkSpeed = 0
	self.humanoid:MoveTo(self.root.Position)
end

function KillerAgent:getHealth(): number
	return self.health
end

function KillerAgent:isStunned(): boolean
	return Util.now() < self.stunnedUntil
end

function KillerAgent:getPosition(): Vector3
	return self.root.Position
end

function KillerAgent:start()
	if self.active then
		return
	end
	self.active = true

	self.humanoid.WalkSpeed = self.profile.PatrolSpeed
	self:_pickPatrolDestination()

	task.spawn(function()
		while self.active do
			local ok, err = pcall(function()
				self:_think()
			end)
			if not ok then
				Util.warn("KillerAgent", "%s think failed: %s", self.profile.Name, tostring(err))
			end
			task.wait(THINK_INTERVAL)
		end
	end)

	task.spawn(function()
		local ok, err = pcall(function()
			self:_navigate()
		end)
		if not ok then
			Util.warn("KillerAgent", "%s navigation failed: %s", self.profile.Name, tostring(err))
		end
	end)
end

function KillerAgent:stop()
	self.active = false
	self.target = nil
	self:_setDestination(nil)
	if self.model.Parent then
		CollectionService:RemoveTag(self.model, Tags.ActiveKiller)
		self.model:Destroy()
	end
end

KillerAgent.STATE = STATE

return KillerAgent
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX17">
			<Properties>
				<string name="Name">Build</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX13">
				<Properties>
					<string name="Name">HouseData</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	HouseData.luau
	--------------------------------------------------------------------------
	MAP 1 -- THE HOUSE. Transcribed from the house.js mockup.

	Decaying Louisiana plantation manor: basement, ground, second floor and
	attic. Footprint 116 x 88 studs. Everything is in ROBLOX STUDS already, so
	the numbers below are the mockup's numbers unchanged -- which means when you
	move a hiding spot in the mockup, you change one line here and nothing else.

	This file is DATA ONLY. MapBuilder turns it into parts and tags.

	Positions are {x, z}; the Y comes from the floor the entry belongs to.
	--------------------------------------------------------------------------
]]

local HouseData = {}

--==========================================================================
-- Vertical layout
--==========================================================================
HouseData.FloorY = {
	basement = -11,
	ground = 0,
	second = 11,
	attic = 22,
}

HouseData.WallHeight = {
	basement = 9,
	ground = 10,
	second = 9,
	attic = 7,
}

--- Bottom to top, which is the order they get built in.
HouseData.FloorOrder = { "basement", "ground", "second", "attic" }

local W_EXT = 1.2
local W_INT = 0.8

--==========================================================================
-- Rooms
--==========================================================================
export type Room = {
	f: string,
	id: string,
	name: string,
	x0: number,
	x1: number,
	z0: number,
	z1: number,
	mat: string,
	note: string,
	zone: string, -- maps onto KillerData.PatrolZones
}

HouseData.Rooms = {
	-- GROUND ---------------------------------------------------------------
	{ f = "ground", id = "foyer", name = "Foyer", x0 = -16, x1 = 16, z0 = 8, z1 = 44, mat = "woodFloor", note = "Central hub, grand stair", zone = "Foyer" },
	{ f = "ground", id = "living", name = "Living Room", x0 = -58, x1 = -18, z0 = 14, z1 = 44, mat = "carpet", note = "Sofas, curtains", zone = "LivingRoom" },
	{ f = "ground", id = "library", name = "Library", x0 = -58, x1 = -18, z0 = -44, z1 = 12, mat = "woodFloor", note = "Safe zone behind shelf", zone = "Library" },
	{ f = "ground", id = "dining", name = "Dining Room", x0 = 18, x1 = 58, z0 = 14, z1 = 44, mat = "woodFloor", note = "Long table, chairs", zone = "DiningRoom" },
	{ f = "ground", id = "kitchen", name = "Kitchen", x0 = 18, x1 = 58, z0 = -14, z1 = 12, mat = "tile", note = "Garlic, noisy tiles", zone = "Kitchen" },
	{ f = "ground", id = "pantry", name = "Pantry", x0 = 18, x1 = 36, z0 = -44, z1 = -16, mat = "tile", note = "Closet hide", zone = "Pantry" },
	{ f = "ground", id = "cstair", name = "Cellar Stair", x0 = 38, x1 = 58, z0 = -44, z1 = -16, mat = "stone", note = "Down to basement", zone = "Cellar" },
	{ f = "ground", id = "ritual", name = "Ritual Room", x0 = -16, x1 = 16, z0 = -44, z1 = 6, mat = "stone", note = "Blood sample, altar", zone = "RitualRoom" },

	-- SECOND ---------------------------------------------------------------
	{ f = "second", id = "landing", name = "Landing", x0 = -16, x1 = 16, z0 = -44, z1 = 44, mat = "woodFloor", note = "Stair well, attic ladder", zone = "Hallway" },
	{ f = "second", id = "master", name = "Master Bedroom", x0 = -58, x1 = -18, z0 = 10, z1 = 44, mat = "carpet", note = "Bob & Barbara, bed hide", zone = "MasterBedroom" },
	{ f = "second", id = "child1", name = "Child's Room I", x0 = -58, x1 = -18, z0 = -18, z1 = 8, mat = "woodFloor", note = "Closet, under-bed", zone = "ChildrensRoom" },
	{ f = "second", id = "child2", name = "Child's Room II", x0 = -58, x1 = -18, z0 = -44, z1 = -20, mat = "woodFloor", note = "Closet, under-bed", zone = "ChildrensRoom" },
	{ f = "second", id = "bath", name = "Bathroom", x0 = 18, x1 = 58, z0 = 22, z1 = 44, mat = "tile", note = "Bathtub hide", zone = "Bathroom" },
	{ f = "second", id = "child3", name = "Child's Room III", x0 = 18, x1 = 58, z0 = -6, z1 = 20, mat = "woodFloor", note = "Duct entry, closet", zone = "ChildrensRoom" },
	{ f = "second", id = "study", name = "Study", x0 = 18, x1 = 58, z0 = -44, z1 = -8, mat = "woodFloor", note = "Magic dust, desk", zone = "Study" },

	-- BASEMENT -------------------------------------------------------------
	{ f = "basement", id = "cellar", name = "Wine Cellar", x0 = -40, x1 = -4, z0 = -36, z1 = 30, mat = "stone", note = "Holy water, barrels", zone = "Cellar" },
	{ f = "basement", id = "storage", name = "Storage Room", x0 = 4, x1 = 50, z0 = 2, z1 = 30, mat = "stone", note = "Lockers, shelves", zone = "Storage" },
	{ f = "basement", id = "boilerR", name = "Boiler Room", x0 = 4, x1 = 50, z0 = -36, z1 = 0, mat = "stone", note = "Steam vents, loud", zone = "BoilerRoom" },

	-- ATTIC ----------------------------------------------------------------
	{ f = "attic", id = "attic", name = "Attic", x0 = -26, x1 = 26, z0 = -22, z1 = 22, mat = "woodPale", note = "Cramped, safe zone", zone = "Attic" },
} :: { Room }

--==========================================================================
-- Walls
--==========================================================================
-- A door is either a bare number (plain 5-wide doorway at that centre) or a
-- table {c, w, h, sill}. `sill > 0` makes it a window.
local function win(c: number, w: number?)
	return { c = c, w = w or 6, h = 7, sill = 3 }
end

HouseData.Walls = {
	ground = {
		{ a = { -58, 44 }, b = { 58, 44 }, t = W_EXT, ext = true, doors = { { c = 0, w = 8, h = 9 }, win(-34), win(-24), win(30), win(42) } },
		{ a = { -58, -44 }, b = { 58, -44 }, t = W_EXT, ext = true, doors = { { c = 27, w = 5, h = 7.5 }, win(-40), win(-8), win(8), win(48) } },
		{ a = { -58, -44 }, b = { -58, 44 }, t = W_EXT, ext = true, doors = { win(-30), win(0), win(24), win(38) } },
		{ a = { 58, -44 }, b = { 58, 44 }, t = W_EXT, ext = true, doors = { win(-30), win(0), win(24), win(38) } },
		{ a = { -17, -44 }, b = { -17, 44 }, t = W_INT, doors = { 30, -10 } },
		{ a = { 17, -44 }, b = { 17, 44 }, t = W_INT, doors = { 30, -6 } },
		{ a = { -58, 13 }, b = { -17, 13 }, t = W_INT, doors = { -38 } },
		{ a = { 17, 13 }, b = { 58, 13 }, t = W_INT, doors = { 44 } },
		{ a = { 17, -15 }, b = { 58, -15 }, t = W_INT, doors = { 27, 50 } },
		{ a = { 37, -44 }, b = { 37, -15 }, t = W_INT, doors = {} },
		{ a = { -17, 7 }, b = { 17, 7 }, t = W_INT, doors = { { c = 0, w = 7 } } },
	},
	second = {
		{ a = { -58, 44 }, b = { 58, 44 }, t = W_EXT, ext = true, doors = { win(-34), win(0), win(34) } },
		{ a = { -58, -44 }, b = { 58, -44 }, t = W_EXT, ext = true, doors = { win(-34), win(0), win(34) } },
		{ a = { -58, -44 }, b = { -58, 44 }, t = W_EXT, ext = true, doors = { win(-28), win(0), win(28) } },
		{ a = { 58, -44 }, b = { 58, 44 }, t = W_EXT, ext = true, doors = { win(-28), win(0), win(28) } },
		{ a = { -17, -44 }, b = { -17, 44 }, t = W_INT, doors = { 28, -4, -30 } },
		{ a = { 17, -44 }, b = { 17, 44 }, t = W_INT, doors = { 32, 6, -24 } },
		{ a = { -58, 9 }, b = { -17, 9 }, t = W_INT, doors = {} },
		{ a = { -58, -19 }, b = { -17, -19 }, t = W_INT, doors = {} },
		{ a = { 17, 21 }, b = { 58, 21 }, t = W_INT, doors = {} },
		{ a = { 17, -7 }, b = { 58, -7 }, t = W_INT, doors = {} },
	},
	basement = {
		{ a = { -40, 30 }, b = { 50, 30 }, t = W_EXT, ext = true, doors = {} },
		{ a = { -40, -36 }, b = { 50, -36 }, t = W_EXT, ext = true, doors = {} },
		{ a = { -40, -36 }, b = { -40, 30 }, t = W_EXT, ext = true, doors = {} },
		{ a = { 50, -36 }, b = { 50, 30 }, t = W_EXT, ext = true, doors = {} },
		{ a = { 0, -36 }, b = { 0, 30 }, t = W_INT, doors = { 16, -20 } },
		{ a = { 0, 1 }, b = { 50, 1 }, t = W_INT, doors = { 22 } },
	},
	attic = {
		{ a = { -26, 22 }, b = { 26, 22 }, t = W_INT, doors = { win(0, 6) } },
		{ a = { -26, -22 }, b = { 26, -22 }, t = W_INT, doors = { win(0, 6) } },
		{ a = { -26, -22 }, b = { -26, 22 }, t = W_INT, doors = {} },
		{ a = { 26, -22 }, b = { 26, 22 }, t = W_INT, doors = {} },
	},
}

--==========================================================================
-- Vertical connections
--==========================================================================
-- Explicit from/to rather than the mockup's (width, rise, run, dir) form, so
-- the two floors they join is unambiguous and pathfinding always works.
HouseData.Stairs = {
	{ name = "GrandStair", from = Vector3.new(-8, 0, 40), to = Vector3.new(-8, 11, 18), width = 10, mat = "woodDark" },
	-- The cellar stair descends within the Cellar Stair room (z -44..-16) and
	-- arrives in the Boiler Room. The mockup's run would have surfaced in the
	-- kitchen, so it is turned to head -Z instead.
	{ name = "CellarStair", from = Vector3.new(48, 0, -20), to = Vector3.new(48, -11, -34), width = 7, mat = "stone" },
}

HouseData.Ladders = {
	{ name = "AtticLadder", bottom = Vector3.new(0, 11, -13.7), height = 11 },
}

--[[
	Openings cut through floor slabs, so the stairs and the ladder actually
	arrive somewhere instead of into the underside of the storey above.

	Each is a rectangle on the named floor; MapBuilder subtracts them from that
	floor's room slabs.
]]
HouseData.FloorHoles = {
	-- Grand stairwell, up through the second-floor landing.
	{ f = "second", x0 = -14, x1 = -2, z0 = 16, z1 = 42 },
	-- Cellar stair, down through the ground floor.
	{ f = "ground", x0 = 44, x1 = 52, z0 = -36, z1 = -17 },
	-- Attic hatch.
	{ f = "attic", x0 = -3, x1 = 3, z0 = -17, z1 = -10 },
}

--==========================================================================
-- Hiding spots
--==========================================================================
-- `t` is the mockup's type; Kind is what HidingService puts on the prompt.
export type Hide = { f: string, t: string, p: { number }, r: number, n: string }

HouseData.Hides = {
	{ f = "ground", t = "table", p = { 38, 30 }, r = 0, n = "Dining table" },
	{ f = "ground", t = "closet", p = { 24, -38 }, r = 0, n = "Pantry closet" },
	{ f = "ground", t = "table", p = { -44, -30 }, r = math.pi / 2, n = "Library desk" },
	{ f = "ground", t = "locker", p = { -52, 34 }, r = math.pi / 2, n = "Hall press" },
	{ f = "ground", t = "duct", p = { 46, -6 }, r = 0, n = "Kitchen shaft" },
	{ f = "second", t = "bed", p = { -40, 30 }, r = 0, n = "Master bed" },
	{ f = "second", t = "bed", p = { -42, -4 }, r = 0, n = "Child I bed" },
	{ f = "second", t = "closet", p = { -24, -30 }, r = -math.pi / 2, n = "Child II closet" },
	{ f = "second", t = "bathtub", p = { 46, 34 }, r = 0, n = "Bathtub" },
	{ f = "second", t = "duct", p = { 22, 8 }, r = math.pi / 2, n = "Child III duct" },
	{ f = "second", t = "table", p = { 44, -30 }, r = 0, n = "Study desk" },
	{ f = "basement", t = "barrel", p = { -30, 16 }, r = 0, n = "Cellar barrel" },
	{ f = "basement", t = "barrel", p = { -22, -18 }, r = 0, n = "Cellar barrel" },
	{ f = "basement", t = "locker", p = { 40, 22 }, r = -math.pi / 2, n = "Storage lockers" },
	{ f = "attic", t = "closet", p = { -18, 12 }, r = 0, n = "Attic trunk press" },
} :: { Hide }

--- Mockup type -> the Kind attribute HidingService reads, plus the prop shape.
HouseData.HideShape = {
	locker = { Kind = "Locker", size = Vector3.new(4, 9, 3), solid = true, mat = "metal" },
	closet = { Kind = "Closet", size = Vector3.new(6, 10, 4), solid = true, mat = "woodDark" },
	bed = { Kind = "Bed", size = Vector3.new(8, 3, 12), solid = false, mat = "cloth" },
	table = { Kind = "Table", size = Vector3.new(11, 4, 6), solid = false, mat = "woodDark" },
	duct = { Kind = "Duct", size = Vector3.new(5, 4, 5), solid = true, mat = "metal" },
	bathtub = { Kind = "Bathtub", size = Vector3.new(6, 3.5, 11), solid = false, mat = "tile" },
	barrel = { Kind = "Barrel", size = Vector3.new(4.5, 6, 4.5), solid = true, mat = "woodDark" },
}

--==========================================================================
-- Noisy floor patches
--==========================================================================
HouseData.Noisy = {
	{ f = "ground", p = { 0, 26 }, s = { 22, 12 }, n = "Foyer glass" },
	{ f = "ground", p = { 0, 0 }, s = { 16, 10 }, n = "Hall boards" },
	{ f = "ground", p = { 36, 0 }, s = { 24, 12 }, n = "Kitchen tiles" },
	{ f = "ground", p = { -38, 12 }, s = { 14, 8 }, n = "Library door" },
	{ f = "second", p = { 0, 20 }, s = { 20, 12 }, n = "Landing boards" },
	{ f = "second", p = { 0, -24 }, s = { 20, 12 }, n = "Back hall" },
	{ f = "second", p = { 30, 6 }, s = { 12, 12 }, n = "Child III floor" },
	{ f = "basement", p = { 24, -18 }, s = { 26, 16 }, n = "Boiler grating" },
	{ f = "basement", p = { -20, 4 }, s = { 16, 12 }, n = "Cellar shards" },
}

--==========================================================================
-- Safe zones
--==========================================================================
-- Each has three entrances, as the design document asks for.
HouseData.SafeZones = {
	{ f = "ground", p = { -46, -22 }, r = 13, n = "Library safe zone", ent = { { -46, -8 }, { -32, -22 }, { -46, -36 } } },
	{ f = "attic", p = { 4, 0 }, r = 12, n = "Attic safe zone", ent = { { 4, 14 }, { 16, 0 }, { -8, 0 } } },
	{ f = "basement", p = { -20, 20 }, r = 12, n = "Cellar safe zone", ent = { { -6, 20 }, { -20, 6 }, { -34, 20 } } },
}

--==========================================================================
-- Objectives
--==========================================================================
-- The four sealing ingredients and the grandfather clock.
HouseData.TaskPins = {
	{ f = "ground", p = { -6, -34 }, k = "blood", n = "Blood Sample" },
	{ f = "ground", p = { 44, -6 }, k = "garlic", n = "Garlic" },
	{ f = "basement", p = { -34, -26 }, k = "holy", n = "Holy Water" },
	{ f = "second", p = { 30, -34 }, k = "dust", n = "Magic Dust" },
	{ f = "ground", p = { -13, 12 }, k = "clock", n = "Grandfather Clock" },
}

HouseData.RitualTable = { f = "ground", p = { 0, -30 } }

-- Exactly 5 / 14 / 15, matching the objective goals in Config.
HouseData.Mirrors = {
	{ f = "ground", p = { -50, 4 } },
	{ f = "ground", p = { 50, 26 } },
	{ f = "second", p = { -30, 38 } },
	{ f = "second", p = { 50, 32 } },
	{ f = "basement", p = { 30, 26 } },
}

HouseData.Crosses = {
	{ f = "ground", p = { -12, 40 } },
	{ f = "ground", p = { 12, 40 } },
	{ f = "ground", p = { -30, 40 } },
	{ f = "ground", p = { 30, 40 } },
	{ f = "ground", p = { -54, -20 } },
	{ f = "ground", p = { 8, -20 } },
	{ f = "ground", p = { 54, 6 } },
	{ f = "second", p = { -54, 40 } },
	{ f = "second", p = { -54, -40 } },
	{ f = "second", p = { 54, 40 } },
	{ f = "second", p = { 54, -40 } },
	{ f = "second", p = { 0, 0 } },
	{ f = "basement", p = { -36, 26 } },
	{ f = "basement", p = { 46, -32 } },
}

HouseData.Bottles = {
	{ f = "ground", p = { -6, 20 } },
	{ f = "ground", p = { -40, 24 } },
	{ f = "ground", p = { -24, -6 } },
	{ f = "ground", p = { 26, 22 } },
	{ f = "ground", p = { 52, -10 } },
	{ f = "ground", p = { 10, -12 } },
	{ f = "ground", p = { 22, -40 } },
	{ f = "second", p = { -24, 20 } },
	{ f = "second", p = { -48, -14 } },
	{ f = "second", p = { -30, -36 } },
	{ f = "second", p = { 40, 36 } },
	{ f = "second", p = { 24, -20 } },
	{ f = "basement", p = { -12, -30 } },
	{ f = "basement", p = { 12, 24 } },
	{ f = "basement", p = { 44, 8 } },
}

--- Fuse boxes for the safe-zone objective, one beside each safe zone.
HouseData.FuseBoxes = {
	{ f = "ground", p = { -56, -22 } },
	{ f = "attic", p = { 24, 0 } },
	{ f = "basement", p = { -38, 20 } },
}

--==========================================================================
-- Spawns
--==========================================================================
HouseData.PlayerSpawns = {
	f = "ground",
	pts = { { -8, 40 }, { 0, 40 }, { 8, 40 }, { -8, 32 }, { 0, 32 }, { 8, 32 } },
}

HouseData.KillerSpawns = {
	{ f = "ground", p = { 46, 36 }, who = "Bob / Barbara" },
	{ f = "second", p = { 0, -38 }, who = "Robert / Baby" },
	{ f = "basement", p = { 26, -30 }, who = "Billy" },
}

--- Where Robby and Benny can appear.
HouseData.HelperSpawns = {
	{ f = "ground", p = { -30, 28 } },
	{ f = "ground", p = { 30, -30 } },
	{ f = "ground", p = { 0, -10 } },
	{ f = "second", p = { -36, 20 } },
	{ f = "second", p = { 36, -20 } },
	{ f = "basement", p = { -16, 10 } },
	{ f = "attic", p = { 12, 8 } },
}

--==========================================================================
-- Patrol routes
--==========================================================================
--[[
	Designed routes, one per killer -- these replace the zone-guessing the
	greybox used. Each is a closed loop walked in order.

	The mockup's fifth route is labelled "bobby"; per docs/DESIGN_DECISIONS.md
	that character is merged into Baby, so the route is assigned to her.
]]
HouseData.Routes = {
	{
		killer = "Bob",
		f = "ground",
		pts = { { 0, 40 }, { 0, 20 }, { -13, 14 }, { -40, 26 }, { -40, 40 }, { 0, 40 }, { 30, 30 }, { 46, 20 }, { 40, 0 }, { 10, -12 }, { 0, -30 }, { 0, 20 } },
	},
	{
		killer = "Barbara",
		f = "ground",
		pts = { { 44, 0 }, { 30, -8 }, { 46, -20 }, { 26, -38 }, { 22, -20 }, { 44, 24 }, { 30, 40 }, { 0, 34 }, { -30, 38 }, { -40, 20 }, { -20, 10 }, { 44, 0 } },
	},
	{
		killer = "Billy",
		f = "basement",
		pts = { { 26, -30 }, { 10, -20 }, { 10, 20 }, { 40, 24 }, { 46, 8 }, { 26, -6 }, { -10, -10 }, { -30, -26 }, { -34, 20 }, { -8, 24 }, { 10, 10 } },
	},
	{
		killer = "Robert",
		f = "second",
		pts = { { 30, -34 }, { 44, -20 }, { 24, -12 }, { 0, -20 }, { 0, 20 }, { -30, 30 }, { -50, 20 }, { -44, -10 }, { -24, -30 }, { 0, -38 }, { 30, -34 } },
	},
	{
		killer = "Baby",
		f = "second",
		pts = { { 0, 30 }, { 22, 8 }, { 46, -6 }, { 24, -30 }, { 0, -38 }, { -24, -30 }, { -44, -4 }, { -40, 30 }, { -20, 38 }, { 0, 30 } },
	},
}

--==========================================================================
-- Lookups
--==========================================================================

--- World position for a {x, z} pair on a named floor.
function HouseData.toWorld(floor: string, p: { number }, yOffset: number?): Vector3
	local y = HouseData.FloorY[floor] or 0
	return Vector3.new(p[1], y + (yOffset or 0), p[2])
end

--- The room containing a point on a floor, or nil.
function HouseData.roomAt(floor: string, x: number, z: number): Room?
	for _, room in HouseData.Rooms do
		if room.f == floor and x >= room.x0 and x <= room.x1 and z >= room.z0 and z <= room.z1 then
			return room
		end
	end
	return nil
end

--- Zone name for a point, used to tag patrol nodes and props.
function HouseData.zoneAt(floor: string, x: number, z: number): string
	local room = HouseData.roomAt(floor, x, z)
	return room and room.zone or "Hallway"
end

function HouseData.roomsOn(floor: string): { Room }
	local out = {}
	for _, room in HouseData.Rooms do
		if room.f == floor then
			table.insert(out, room)
		end
	end
	return out
end

return HouseData
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX14">
				<Properties>
					<string name="Name">MapBuilder</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	MapBuilder.luau
	--------------------------------------------------------------------------
	Builds The House from HouseData and tags everything the gameplay code needs.

	This is no longer a placeholder greybox -- it is the mockup's actual level
	design: four floors, the real room bounds, the fifteen hiding spots where
	they were placed, the designed patrol routes, and the exact 5 mirrors /
	14 crosses / 15 bottles the objectives ask for.

	What is still approximate is the DRESSING -- furniture is boxes at the right
	size rather than modelled sofas and bookshelves. The mockups are still being
	tweaked, so this stays cheap to change. When you want the real furniture,
	the props.js builders port into Primitives the same way the walls did.

	If a Model exists at ServerStorage/Maps/TheHouse, MapService loads that
	instead and none of this runs.
	--------------------------------------------------------------------------
]]

local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Palette = require(Shared.Palette)
local Tags = require(Shared.Tags)
local Util = require(Shared.Util)

local HouseData = require(script.Parent.HouseData)
local Primitives = require(script.Parent.Primitives)

local MapBuilder = {}

local SLAB_THICKNESS = 1

--==========================================================================
-- Helpers
--==========================================================================

local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function marker(name: string, position: Vector3, parent: Instance, style: string?): BasePart
	local part = Primitives.part(name, style, position, Vector3.new(2, 1, 2), 0, parent)
	part.Transparency = style and part.Transparency or 1
	part.CanCollide = false
	part.CanQuery = false
	return part
end

--==========================================================================
-- Shell
--==========================================================================

--[[
	Subtracts a rectangular hole from a rectangle, returning the pieces left
	over -- up to four, cut left / right / near / far around the hole.

	This is what turns a solid floor slab into one with a stairwell in it.
	Rectangles are {x0, x1, z0, z1}.
]]
local function subtractHole(rect, hole)
	-- No overlap: the rectangle survives whole.
	if hole.x1 <= rect.x0 or hole.x0 >= rect.x1 or hole.z1 <= rect.z0 or hole.z0 >= rect.z1 then
		return { rect }
	end

	local cutX0 = math.max(rect.x0, hole.x0)
	local cutX1 = math.min(rect.x1, hole.x1)
	local cutZ0 = math.max(rect.z0, hole.z0)
	local cutZ1 = math.min(rect.z1, hole.z1)

	local pieces = {}
	local function add(x0, x1, z0, z1)
		if x1 - x0 > 0.05 and z1 - z0 > 0.05 then
			table.insert(pieces, { x0 = x0, x1 = x1, z0 = z0, z1 = z1 })
		end
	end

	add(rect.x0, cutX0, rect.z0, rect.z1) -- left of the hole
	add(cutX1, rect.x1, rect.z0, rect.z1) -- right of the hole
	add(cutX0, cutX1, rect.z0, cutZ0) -- near side
	add(cutX0, cutX1, cutZ1, rect.z1) -- far side
	return pieces
end

local function slabPieces(room, floorName: string)
	local pieces = { { x0 = room.x0, x1 = room.x1, z0 = room.z0, z1 = room.z1 } }

	for _, hole in HouseData.FloorHoles do
		if hole.f ~= floorName then
			continue
		end
		local next_ = {}
		for _, piece in pieces do
			for _, remainder in subtractHole(piece, hole) do
				table.insert(next_, remainder)
			end
		end
		pieces = next_
	end

	return pieces
end

local function buildFloorShell(floorName: string, parent: Instance)
	local y = HouseData.FloorY[floorName]
	local height = HouseData.WallHeight[floorName]

	local structure = folder(`Structure_{floorName}`, parent)

	-- One slab per room, so the floor finish reads per space -- minus any
	-- stairwell openings cut through it.
	for _, room in HouseData.roomsOn(floorName) do
		for index, piece in slabPieces(room, floorName) do
			Primitives.box(
				`slab_{room.id}_{index}`,
				room.mat,
				piece.x0,
				piece.x1,
				y - SLAB_THICKNESS,
				y,
				piece.z0,
				piece.z1,
				structure
			)
		end
	end

	-- Walls.
	for index, wall in HouseData.Walls[floorName] or {} do
		local style = wall.ext and "plaster" or (floorName == "basement" and "stone" or "paperGrn")
		Primitives.wall(
			structure,
			`{wall.ext and "ext_wall" or "wall"}_{floorName}_{index}`,
			style,
			wall.a,
			wall.b,
			y,
			height,
			wall.t,
			wall.doors
		)
	end

	-- Ceiling over the top storey only; the floors below get one from the slab
	-- of the storey above them.
	if floorName == "attic" then
		for _, room in HouseData.roomsOn(floorName) do
			Primitives.box(
				`roof_{room.id}`,
				"shingle",
				room.x0,
				room.x1,
				y + height,
				y + height + SLAB_THICKNESS,
				room.z0,
				room.z1,
				structure
			)
		end
	end
end

local function buildVerticalLinks(parent: Instance)
	local structure = folder("VerticalLinks", parent)

	for _, stair in HouseData.Stairs do
		Primitives.stairs(stair.name, stair.mat, stair.from, stair.to, stair.width, structure)
	end

	for _, ladder in HouseData.Ladders do
		Primitives.ladder(ladder.name, ladder.bottom, ladder.height, structure)
	end
end

--==========================================================================
-- Gameplay markers
--==========================================================================

local function buildHides(parent: Instance)
	local hides = folder("HidingSpots", parent)

	for index, hide in HouseData.Hides do
		local shape = HouseData.HideShape[hide.t]
		if not shape then
			Util.warn("MapBuilder", 'unknown hiding spot type "%s"', hide.t)
			continue
		end

		local position = HouseData.toWorld(hide.f, hide.p, shape.size.Y / 2)
		local part = Primitives.part(`Hide_{shape.Kind}_{index}`, shape.mat, position, shape.size, hide.r, hides)

		-- Beds, tables and bathtubs are hidden *under* or *in*, so players have
		-- to be able to walk into them. Lockers and closets are solid.
		part.CanCollide = shape.solid

		part:SetAttribute("Kind", shape.Kind)
		part:SetAttribute("Zone", HouseData.zoneAt(hide.f, hide.p[1], hide.p[2]))
		part:SetAttribute("Label", hide.n)
		CollectionService:AddTag(part, Tags.HidingSpot)
	end
end

local function buildNoisyTiles(parent: Instance)
	local tiles = folder("NoisyTiles", parent)

	for index, noisy in HouseData.Noisy do
		local y = HouseData.FloorY[noisy.f]
		local tile = Primitives.box(
			`NoisyTile_{index}`,
			"noisy",
			noisy.p[1] - noisy.s[1] / 2,
			noisy.p[1] + noisy.s[1] / 2,
			y + 0.05,
			y + 0.3,
			noisy.p[2] - noisy.s[2] / 2,
			noisy.p[2] + noisy.s[2] / 2,
			tiles
		)
		tile.CanCollide = false
		tile:SetAttribute("Noise", Config.Noise.Actions.CreakyFloor)
		tile:SetAttribute("Label", noisy.n)
		CollectionService:AddTag(tile, Tags.NoisyTile)
	end
end

local function buildSafeZones(parent: Instance)
	local zones = folder("SafeZones", parent)

	for index, zone in HouseData.SafeZones do
		local centre = HouseData.toWorld(zone.f, zone.p, 6)

		-- A box volume rather than a disc: SafeZoneService tests points in the
		-- part's own space, so a box gives predictable edges.
		local volume = Primitives.part(
			`SafeZone_{index}`,
			"safe",
			centre,
			Vector3.new(zone.r * 2, 12, zone.r * 2),
			0,
			zones
		)
		volume.CanCollide = false
		volume.CanQuery = false
		volume:SetAttribute("Radius", zone.r)
		volume:SetAttribute("Active", true)
		volume:SetAttribute("Label", zone.n)
		CollectionService:AddTag(volume, Tags.SafeZone)

		-- The three entrances the design document calls for.
		for entranceIndex, entrance in zone.ent do
			local post = Primitives.cyl(
				`SafeZoneEntrance_{index}_{entranceIndex}`,
				"safe",
				HouseData.toWorld(zone.f, entrance, 2),
				1.4,
				4,
				0,
				zones
			)
			post.CanCollide = false
		end
	end
end

--- One tagged spawn point per fixed item position from the mockup.
local function buildTaskSpawns(parent: Instance)
	local spawns = folder("TaskSpawns", parent)

	local function place(list, taskType: string, prefix: string)
		for index, entry in list do
			local point = marker(
				`{prefix}Spawn_{index}`,
				HouseData.toWorld(entry.f, entry.p, 3),
				spawns
			)
			point:SetAttribute("TaskType", taskType)
			point:SetAttribute("Zone", HouseData.zoneAt(entry.f, entry.p[1], entry.p[2]))
			CollectionService:AddTag(point, Tags.TaskSpawn)
		end
	end

	-- Counts here are exactly the objective goals: 15 / 14 / 5.
	place(HouseData.Bottles, "Potion", "Bottle")
	place(HouseData.Crosses, "Cross", "Cross")
	place(HouseData.Mirrors, "Mirror", "Mirror")
end

local function buildObjectiveProps(parent: Instance)
	local props = folder("Objectives", parent)

	for _, pin in HouseData.TaskPins do
		local position = HouseData.toWorld(pin.f, pin.p, 2)

		if pin.k == "clock" then
			local clock = Primitives.part(
				"GrandfatherClock",
				"woodDark",
				position + Vector3.new(0, 5, 0),
				Vector3.new(4, 14, 3),
				0,
				props
			)
			clock:SetAttribute("Zone", HouseData.zoneAt(pin.f, pin.p[1], pin.p[2]))
			CollectionService:AddTag(clock, Tags.Clock)
		else
			local ingredientId = Palette.IngredientId[pin.k]
			local pedestal = Primitives.part(
				`Ingredient_{ingredientId}`,
				"stone",
				position,
				Vector3.new(3, 4, 3),
				0,
				props
			)
			pedestal:SetAttribute("Ingredient", ingredientId)
			pedestal:SetAttribute("Zone", HouseData.zoneAt(pin.f, pin.p[1], pin.p[2]))
			CollectionService:AddTag(pedestal, Tags.IngredientSpawn)

			-- A glowing sample sitting on it, in the ingredient's own colour.
			local sample = Primitives.sph(
				`IngredientGlow_{ingredientId}`,
				Palette.Ingredient[pin.k],
				position + Vector3.new(0, 3, 0),
				1.1,
				nil,
				props
			)
			sample.CanCollide = false
		end
	end

	-- Ritual table.
	local ritual = Primitives.part(
		"RitualTable",
		"blood",
		HouseData.toWorld(HouseData.RitualTable.f, HouseData.RitualTable.p, 2),
		Vector3.new(10, 4, 6),
		0,
		props
	)
	ritual:SetAttribute("Zone", "RitualRoom")
	CollectionService:AddTag(ritual, Tags.RitualTable)

	-- Fuse boxes.
	for index, fuse in HouseData.FuseBoxes do
		local box = Primitives.part(
			`FuseBox_{index}`,
			"metal",
			HouseData.toWorld(fuse.f, fuse.p, 6),
			Vector3.new(3, 4, 1.5),
			0,
			props
		)
		box:SetAttribute("Zone", HouseData.zoneAt(fuse.f, fuse.p[1], fuse.p[2]))
		CollectionService:AddTag(box, Tags.FuseBox)
	end
end

local function buildSpawns(parent: Instance)
	local spawns = folder("Spawns", parent)

	for index, point in HouseData.PlayerSpawns.pts do
		local part = marker(
			`PlayerSpawn_{index}`,
			HouseData.toWorld(HouseData.PlayerSpawns.f, point, 3),
			spawns,
			"spawnP"
		)
		part.Transparency = 0.7
		CollectionService:AddTag(part, Tags.PlayerSpawn)
	end

	for index, spawn in HouseData.KillerSpawns do
		local part = marker(`KillerSpawn_{index}`, HouseData.toWorld(spawn.f, spawn.p, 4), spawns)
		part:SetAttribute("Who", spawn.who)
		part:SetAttribute("Zone", HouseData.zoneAt(spawn.f, spawn.p[1], spawn.p[2]))
		CollectionService:AddTag(part, Tags.KillerSpawn)
	end

	for index, spawn in HouseData.HelperSpawns do
		local part = marker(`HelperSpawn_{index}`, HouseData.toWorld(spawn.f, spawn.p, 3), spawns)
		part:SetAttribute("Zone", HouseData.zoneAt(spawn.f, spawn.p[1], spawn.p[2]))
		CollectionService:AddTag(part, Tags.HelperSpawn)
	end
end

--[[
	Patrol routes.

	Each waypoint carries the killer it belongs to and its position in the loop,
	so MapService can hand a killer its own designed route in order instead of
	guessing from room names.
]]
local function buildPatrolRoutes(parent: Instance)
	local routes = folder("PatrolRoutes", parent)

	for _, route in HouseData.Routes do
		local routeFolder = folder(route.killer, routes)

		for order, point in route.pts do
			local node = marker(`{route.killer}_{order}`, HouseData.toWorld(route.f, point, 2), routeFolder)
			node:SetAttribute("Killer", route.killer)
			node:SetAttribute("Order", order)
			node:SetAttribute("Zone", HouseData.zoneAt(route.f, point[1], point[2]))
			CollectionService:AddTag(node, Tags.PatrolNode)
		end
	end

	-- Baby can also use the ducts nobody else fits through.
	for _, hide in HouseData.Hides do
		if hide.t == "duct" then
			local node = marker(
				"Crawlspace",
				HouseData.toWorld(hide.f, hide.p, 2),
				routes
			)
			node:SetAttribute("Killer", "Baby")
			node:SetAttribute("Zone", "Crawlspace")
			CollectionService:AddTag(node, Tags.PatrolNode)
			CollectionService:AddTag(node, Tags.Crawlspace)
		end
	end
end

local function buildLoreNotes(parent: Instance)
	local notes = folder("LoreNotes", parent)

	-- One note per room that the design document gives a document to.
	local placements = {
		{ f = "ground", p = { 40, 24 }, id = "BobLedger" },
		{ f = "ground", p = { 44, 4 }, id = "BarbaraBills" },
		{ f = "second", p = { -46, 24 }, id = "BillyLetter" },
		{ f = "second", p = { 40, -36 }, id = "RobertJournal" },
		{ f = "second", p = { -46, -32 }, id = "AvaDiary1" },
		{ f = "attic", p = { -18, -14 }, id = "AvaDiary2" },
		{ f = "basement", p = { 20, -30 }, id = "PreviousVictim" },
	}

	for _, placement in placements do
		local note = Primitives.part(
			"LoreNote",
			"cloth",
			HouseData.toWorld(placement.f, placement.p, 0.3),
			Vector3.new(2, 0.2, 2.6),
			math.random() * math.pi,
			notes
		)
		note.CanCollide = false
		note:SetAttribute("NoteId", placement.id)
		CollectionService:AddTag(note, Tags.LoreNote)
	end
end

--==========================================================================
-- Dressing and atmosphere
--==========================================================================

--- Simple furniture blocks at the right size and colour. Deliberately cheap --
--- swap these for the props.js builders when the designs settle.
local function buildDressing(parent: Instance)
	local dressing = folder("Dressing", parent)

	local FURNITURE = {
		{ f = "ground", id = "living", items = { { "sofa", "clothRed", Vector3.new(12, 4, 5), { -40, 38 } }, { "rug", "carpet", Vector3.new(20, 0.2, 14), { -38, 28 } } } },
		{ f = "ground", id = "library", items = { { "bookshelf", "woodDark", Vector3.new(3, 12, 16), { -56, -10 } }, { "bookshelf", "woodDark", Vector3.new(3, 12, 16), { -20, -26 } } } },
		{ f = "ground", id = "dining", items = { { "longtable", "woodDark", Vector3.new(8, 4, 20), { 38, 30 } } } },
		{ f = "ground", id = "kitchen", items = { { "counter", "tile", Vector3.new(20, 5, 4), { 38, 10 } }, { "stove", "metal", Vector3.new(6, 6, 5), { 54, 8 } } } },
		{ f = "ground", id = "ritual", items = { { "altarstep", "stone", Vector3.new(14, 1, 10), { 0, -30 } } } },
		{ f = "second", id = "study", items = { { "desk", "woodDark", Vector3.new(10, 4, 5), { 44, -30 } } } },
		{ f = "basement", id = "cellar", items = { { "barrelstack", "woodDark", Vector3.new(10, 8, 6), { -34, -8 } } } },
		{ f = "basement", id = "boilerR", items = { { "boiler", "metal", Vector3.new(8, 10, 8), { 40, -30 } } } },
		{ f = "basement", id = "storage", items = { { "shelfrack", "metal", Vector3.new(4, 10, 16), { 8, 16 } } } },
	}

	for _, group in FURNITURE do
		for _, item in group.items do
			local name, style, size, position = item[1], item[2], item[3], item[4]
			Primitives.part(
				name,
				style,
				HouseData.toWorld(group.f, position, size.Y / 2),
				size,
				0,
				dressing
			)
		end
	end
end

local function buildAtmosphere(parent: Instance)
	local lights = folder("Lighting", parent)
	local rng = Random.new(20250728)

	for _, room in HouseData.Rooms do
		local centre = Vector3.new(
			(room.x0 + room.x1) / 2,
			HouseData.FloorY[room.f] + HouseData.WallHeight[room.f] - 2.5,
			(room.z0 + room.z1) / 2
		)

		local candle = Primitives.sph(`Candle_{room.id}`, "flame", centre, 0.5, nil, lights)
		candle.CanCollide = false

		local light = candle:FindFirstChildOfClass("PointLight")
		if light then
			light.Range = math.max(room.x1 - room.x0, room.z1 - room.z0) * 0.75
			light.Shadows = true

			-- Flicker. Cheap, and it sells the whole thing.
			task.spawn(function()
				while candle.Parent do
					light.Brightness = rng:NextNumber(1.4, 2.6)
					task.wait(rng:NextNumber(0.08, 0.4))
				end
			end)
		end
	end
end

--==========================================================================
-- The House
--==========================================================================

function MapBuilder.buildHouse(): Model
	local model = Instance.new("Model")
	model.Name = "TheHouse"

	for _, floorName in HouseData.FloorOrder do
		buildFloorShell(floorName, model)
	end
	buildVerticalLinks(model)

	buildHides(model)
	buildNoisyTiles(model)
	buildSafeZones(model)
	buildTaskSpawns(model)
	buildObjectiveProps(model)
	buildSpawns(model)
	buildPatrolRoutes(model)
	buildLoreNotes(model)
	buildDressing(model)
	buildAtmosphere(model)

	-- Ground beneath the basement, so falling out of the map isn't fatal and
	-- pathfinding always has something to project onto.
	local ground = Primitives.box(
		"Ground",
		"moss",
		-130,
		130,
		HouseData.FloorY.basement - SLAB_THICKNESS - 4,
		HouseData.FloorY.basement - SLAB_THICKNESS,
		-110,
		110,
		model
	)
	model.PrimaryPart = ground

	return model
end

--==========================================================================
-- The lobby
--==========================================================================

--- Lives well above the maps so nothing can ever overlap it.
function MapBuilder.buildLobby(): Model
	local ORIGIN = Vector3.new(0, 500, 0)
	local SIZE = 120

	local model = Instance.new("Model")
	model.Name = "Lobby"

	local floor = Primitives.part("LobbyFloor", "stone", ORIGIN, Vector3.new(SIZE, 4, SIZE), 0, model)

	for _, spec in
		{
			{ Vector3.new(SIZE, 24, 2), Vector3.new(0, 14, -SIZE / 2) },
			{ Vector3.new(SIZE, 24, 2), Vector3.new(0, 14, SIZE / 2) },
			{ Vector3.new(2, 24, SIZE), Vector3.new(-SIZE / 2, 14, 0) },
			{ Vector3.new(2, 24, SIZE), Vector3.new(SIZE / 2, 14, 0) },
		}
	do
		local wall = Primitives.part("LobbyWall", "plaster", ORIGIN + spec[2], spec[1], 0, model)
		wall.Transparency = 0.25
	end

	--[[
		Roblox's own respawn point, and the default for everyone.

		Deliberately Neutral rather than team-locked: if it were locked to the
		Lost team and a mid-round player somehow respawned while still on
		Survivors, Roblox would find no matching spawn and drop them at the
		world origin. GameStateManager teleports players onto the map explicitly
		at round start, so "everyone respawns in the lobby" is exactly what we
		want from the engine.
	]]
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Size = Vector3.new(20, 1, 20)
	spawn.CFrame = CFrame.new(ORIGIN + Vector3.new(0, 2.5, 0))
	spawn.Anchored = true
	spawn.Color = Color3.fromRGB(181, 154, 88)
	spawn.Material = Enum.Material.Marble
	spawn.Neutral = true
	spawn.Duration = 0 -- no forcefield; it would look wrong on a horror map
	spawn.Parent = model
	CollectionService:AddTag(spawn, Tags.LobbySpawn)

	for index = 1, 12 do
		local angle = (index / 12) * math.pi * 2
		local point = marker(
			`LobbySpawnPoint_{index}`,
			ORIGIN + Vector3.new(math.cos(angle) * 22, 4, math.sin(angle) * 22),
			model
		)
		CollectionService:AddTag(point, Tags.LobbySpawn)
	end

	-- Shop plinth. ShopService attaches the ProximityPrompt.
	local shop = Primitives.part("ShopStand", "woodDark", ORIGIN + Vector3.new(-34, 5, 0), Vector3.new(8, 6, 4), 0, model)
	shop:SetAttribute("DollysHomeShop", true)

	local sign = Instance.new("BillboardGui")
	sign.Name = "Sign"
	sign.Size = UDim2.fromScale(8, 2)
	sign.StudsOffsetWorldSpace = Vector3.new(0, 5, 0)
	sign.MaxDistance = 90
	sign.Parent = shop

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.Text = "PEDDLER'S CART"
	label.TextColor3 = Color3.fromRGB(240, 220, 180)
	label.TextScaled = true
	label.Parent = sign

	-- Ambient light, so the lobby isn't pitch black under the horror lighting.
	local lamp = Primitives.sph("LobbyLamp", "flame", ORIGIN + Vector3.new(0, 22, 0), 1, nil, model)
	lamp.CanCollide = false
	local lampLight = lamp:FindFirstChildOfClass("PointLight")
	if lampLight then
		lampLight.Brightness = 3
		lampLight.Range = 100
	end

	model.PrimaryPart = floor
	return model
end

--==========================================================================
-- Dispatch
--==========================================================================

function MapBuilder.build(mapId: string): Model?
	if mapId == "TheHouse" then
		return MapBuilder.buildHouse()
	end
	Util.warn(
		"MapBuilder",
		'no generator for map "%s" -- build it in Studio and save it to ServerStorage/Maps/%s',
		mapId,
		mapId
	)
	return nil
end

return MapBuilder
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX15">
				<Properties>
					<string name="Name">Primitives</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	Primitives.luau
	--------------------------------------------------------------------------
	The Luau equivalent of the primitive helpers in props.js, so the map data
	can be transcribed almost line for line.

	Three.js -> Roblox translation notes:

	  BoxGeometry      -> Part, Shape = Block                      (exact)
	  CylinderGeometry -> Part, Shape = Cylinder                   (see below)
	  SphereGeometry   -> Part, Shape = Ball, scaled               (exact enough)
	  RingGeometry     -> a thin Cylinder part                     (solid, not a ring)
	  CapsuleGeometry  -> Cylinder + two Balls                     (3 parts)
	  ConeGeometry     -> a short stack of shrinking cylinders     (approximation)
	  LatheGeometry    -> a stack of cylinders following the profile

	The one that trips people up: a Roblox Cylinder part's circular axis is X,
	not Y. A "standing" cylinder therefore needs a 90-degree roll. `cyl` below
	handles that, so callers can think in Three.js terms (height along Y).

	Cones and lathes are approximations by design -- the mockups are still being
	tweaked, so segment counts are kept low and readable rather than smooth.
	--------------------------------------------------------------------------
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Palette = require(Shared.Palette)

local Primitives = {}

-- Roblox Cylinder parts are circular around X; Three.js cylinders are around Y.
local STAND_UP = CFrame.Angles(0, 0, math.pi / 2)

--==========================================================================
-- Core
--==========================================================================

local function finish(part: BasePart, name: string, style: any, parent: Instance?): BasePart
	part.Name = name
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if style then
		Palette.apply(part, style)
	end
	part.Parent = parent
	return part
end

--- Box from world-space bounds. Mirrors props.js `box(name, mat, x0,x1, y0,y1, z0,z1)`.
function Primitives.box(name, style, x0, x1, y0, y1, z0, z1, parent): BasePart
	local part = Instance.new("Part")
	part.Size = Vector3.new(math.abs(x1 - x0), math.abs(y1 - y0), math.abs(z1 - z0))
	part.CFrame = CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2)
	return finish(part, name, style, parent)
end

--- Box by centre + size, optional Y rotation. Mirrors props.js `part()`.
function Primitives.part(name, style, position: Vector3, size: Vector3, rotY: number?, parent): BasePart
	local part = Instance.new("Part")
	part.Size = size
	part.CFrame = CFrame.new(position) * CFrame.Angles(0, rotY or 0, 0)
	return finish(part, name, style, parent)
end

--- Cylinder standing on its end (height along Y), like Three.js.
function Primitives.cyl(name, style, position: Vector3, radius: number, height: number, rotY: number?, parent): BasePart
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Cylinder
	-- X is the circular axis, so X is the height and Y/Z are the diameter.
	part.Size = Vector3.new(height, radius * 2, radius * 2)
	part.CFrame = CFrame.new(position) * CFrame.Angles(0, rotY or 0, 0) * STAND_UP
	return finish(part, name, style, parent)
end

--- Sphere, optionally scaled per axis. Mirrors props.js `sph()`.
function Primitives.sph(name, style, position: Vector3, radius: number, scale: Vector3?, parent): BasePart
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Ball
	local s = scale or Vector3.one
	part.Size = Vector3.new(radius * 2 * s.X, radius * 2 * s.Y, radius * 2 * s.Z)
	part.CFrame = CFrame.new(position)
	return finish(part, name, style, parent)
end

--- Flat disc lying in the XZ plane. props.js uses a ring; a solid disc reads
--- the same from above and costs one part instead of a mesh.
function Primitives.disc(name, style, position: Vector3, radius: number, thickness: number?, parent): BasePart
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(thickness or 0.2, radius * 2, radius * 2)
	part.CFrame = CFrame.new(position) * STAND_UP
	part.CanCollide = false
	return finish(part, name, style, parent)
end

--==========================================================================
-- Composites
--==========================================================================

--- A capsule between two points: a cylinder with a ball on each end.
function Primitives.capsule(name, style, a: Vector3, b: Vector3, radius: number, parent): { BasePart }
	local delta = b - a
	local length = delta.Magnitude
	local out = {}

	if length > 0.02 then
		local shaft = Instance.new("Part")
		shaft.Shape = Enum.PartType.Cylinder
		shaft.Size = Vector3.new(length, radius * 2, radius * 2)
		-- lookAt points +Z down the axis; roll it so the cylinder's X aligns.
		shaft.CFrame = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.pi / 2, 0)
		table.insert(out, finish(shaft, name .. "_shaft", style, parent))
	end

	for index, point in { a, b } do
		local cap = Instance.new("Part")
		cap.Shape = Enum.PartType.Ball
		cap.Size = Vector3.new(radius * 2, radius * 2, radius * 2)
		cap.CFrame = CFrame.new(point)
		table.insert(out, finish(cap, `{name}_cap{index}`, style, parent))
	end

	return out
end

--- A cone / spike from `a` to `b`, approximated as a stack of shrinking discs.
function Primitives.cone(name, style, a: Vector3, b: Vector3, radius: number, segments: number?, parent): { BasePart }
	local steps = segments or 4
	local out = {}
	for index = 0, steps - 1 do
		local t0, t1 = index / steps, (index + 1) / steps
		local p0, p1 = a:Lerp(b, t0), a:Lerp(b, t1)
		local r = radius * (1 - (t0 + t1) / 2)
		if r > 0.01 then
			local segment = Instance.new("Part")
			segment.Shape = Enum.PartType.Cylinder
			segment.Size = Vector3.new((p1 - p0).Magnitude, r * 2, r * 2)
			segment.CFrame = CFrame.lookAt((p0 + p1) / 2, p1) * CFrame.Angles(0, math.pi / 2, 0)
			table.insert(out, finish(segment, `{name}_{index}`, style, parent))
		end
	end
	return out
end

--[[
	A lathe: a profile of {radius, y} pairs revolved around the Y axis,
	built as a stack of cylinders. Used for skirts, robes and bottles.
]]
function Primitives.lathe(name, style, profile: { { number } }, origin: Vector3, parent): { BasePart }
	local out = {}
	for index = 1, #profile - 1 do
		local r0, y0 = profile[index][1], profile[index][2]
		local r1, y1 = profile[index + 1][1], profile[index + 1][2]
		local height = math.abs(y1 - y0)
		local radius = math.max((r0 + r1) / 2, 0.02)
		if height > 0.02 and radius > 0.02 then
			table.insert(
				out,
				Primitives.cyl(
					`{name}_{index}`,
					style,
					origin + Vector3.new(0, (y0 + y1) / 2, 0),
					radius,
					height,
					nil,
					parent
				)
			)
		end
	end
	return out
end

--==========================================================================
-- Walls
--==========================================================================

export type Door = {
	c: number, -- centre along the wall run
	w: number?, -- width (default 5)
	h: number?, -- height (default 7.5)
	sill: number?, -- >0 makes it a window: wall is kept below this height
}

--[[
	A wall run between two [x, z] points with doorway and window gaps.
	Faithful port of props.js `wall()`.

	`a` and `b` are {x, z}. The run is treated as horizontal (along X) when the
	X span is the larger of the two, otherwise it runs along Z.
]]
function Primitives.wall(
	parent: Instance,
	name: string,
	style: any,
	a: { number },
	b: { number },
	y0: number,
	height: number,
	thickness: number?,
	doors: { any }?
): { BasePart }
	local t = thickness or 1
	local horizontal = math.abs(b[1] - a[1]) >= math.abs(b[2] - a[2])

	local lo = math.min(horizontal and a[1] or a[2], horizontal and b[1] or b[2])
	local hi = math.max(horizontal and a[1] or a[2], horizontal and b[1] or b[2])
	local fixed = horizontal and a[2] or a[1]

	-- Normalise: a bare number means a plain doorway at that centre.
	local openings = {}
	for _, entry in doors or {} do
		local door
		if type(entry) == "number" then
			door = { c = entry, w = 5, h = 7.5, sill = 0 }
		else
			door = {
				c = entry.c,
				w = entry.w or 5,
				h = entry.h or 7.5,
				sill = entry.sill or 0,
			}
		end
		table.insert(openings, door)
	end
	table.sort(openings, function(p, q)
		return p.c < q.c
	end)

	-- Build the list of solid segments as {start, finish, bottomY, topY}.
	local segments = {}
	local cursor = lo
	for _, door in openings do
		local s = math.max(lo, door.c - door.w / 2)
		local e = math.min(hi, door.c + door.w / 2)
		if s > cursor then
			table.insert(segments, { cursor, s, 0, height })
		end
		if door.sill > 0 then
			table.insert(segments, { s, e, 0, door.sill }) -- wall beneath a window
		end
		if door.h < height then
			table.insert(segments, { s, e, door.h, height }) -- lintel above
		end
		cursor = math.max(cursor, e)
	end
	if cursor < hi then
		table.insert(segments, { cursor, hi, 0, height })
	end

	local built = {}
	for index, segment in segments do
		local s, e, by, ty = segment[1], segment[2], segment[3], segment[4]
		local length, segHeight = e - s, ty - by
		if length > 0.02 and segHeight > 0.02 then
			local part = Instance.new("Part")
			part.Size = if horizontal
				then Vector3.new(length, segHeight, t)
				else Vector3.new(t, segHeight, length)
			part.CFrame = CFrame.new(
				horizontal and (s + e) / 2 or fixed,
				y0 + by + segHeight / 2,
				horizontal and fixed or (s + e) / 2
			)
			table.insert(built, finish(part, `{name}_{index}`, style, parent))
		end
	end

	-- Glass in the window openings.
	for _, door in openings do
		if door.sill > 0 then
			local pane = Instance.new("Part")
			local paneHeight = door.h - door.sill - 0.4
			if paneHeight > 0.1 then
				pane.Size = if horizontal
					then Vector3.new(door.w - 0.5, paneHeight, 0.2)
					else Vector3.new(0.2, paneHeight, door.w - 0.5)
				pane.CFrame = CFrame.new(
					horizontal and door.c or fixed,
					y0 + door.sill + paneHeight / 2,
					horizontal and fixed or door.c
				)
				pane.CanCollide = false
				table.insert(built, finish(pane, "window_glass", "glass", parent))
			end
		end
	end

	return built
end

--==========================================================================
-- Stairs
--==========================================================================

--[[
	Steps from `from` to `to`. Built as real steps rather than a ramp because
	PathfindingService handles both, but steps read as architecture.

	Rise per step is kept under 2 studs so humanoids climb without jumping.
]]
function Primitives.stairs(name: string, style: any, from: Vector3, to: Vector3, width: number, parent: Instance): { BasePart }
	local delta = to - from
	local rise = math.abs(delta.Y)
	local stepCount = math.max(2, math.ceil(rise / 1.2))
	local horizontal = Vector3.new(delta.X, 0, delta.Z)
	local direction = horizontal.Magnitude > 0.01 and horizontal.Unit or Vector3.new(0, 0, 1)
	local run = horizontal.Magnitude
	local tread = run / stepCount
	local riser = delta.Y / stepCount

	local out = {}
	for index = 1, stepCount do
		local centre = from
			+ direction * (tread * (index - 0.5))
			+ Vector3.new(0, riser * index - math.abs(riser) / 2, 0)

		local step = Instance.new("Part")
		step.Size = Vector3.new(width, math.max(math.abs(riser), 0.6), tread)
		step.CFrame = CFrame.lookAt(centre, centre + direction)
		table.insert(out, finish(step, `{name}_step{index}`, style, parent))
	end
	return out
end

--- A climbable truss, for the attic ladder. Humanoids and pathfinding both
--- understand TrussParts, which a decorative ladder of welded rungs would not.
function Primitives.ladder(name: string, bottom: Vector3, height: number, parent: Instance): BasePart
	local truss = Instance.new("TrussPart")
	truss.Name = name
	truss.Anchored = true
	truss.Size = Vector3.new(2, height, 2)
	truss.CFrame = CFrame.new(bottom + Vector3.new(0, height / 2, 0))
	truss.Color = Color3.fromRGB(138, 116, 88)
	truss.Material = Enum.Material.Wood
	truss.Parent = parent
	return truss
end

return Primitives
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX16">
				<Properties>
					<string name="Name">RigBuilder</string>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	RigBuilder.luau
	--------------------------------------------------------------------------
	Placeholder character rigs for the killers, the helper ghosts, and Ava.

	Same deal as MapBuilder: this exists so the AI, chases and stuns are all
	testable before anyone models a Victorian vampire. Drop a proper rig into
	ServerStorage/Killers/<Name> and KillerService uses that instead.

	A custom rig only needs three things for Humanoid:MoveTo and
	PathfindingService to work: a Humanoid, a part named HumanoidRootPart set as
	the model's PrimaryPart, and a sensible HipHeight. Everything else here is
	decoration welded on top.
	--------------------------------------------------------------------------
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local KillerData = require(Shared.KillerData)

local RigBuilder = {}

local ROOT_SIZE = Vector3.new(3, 3.2, 1.8)
local HIP_HEIGHT = 2.2

local function limb(name: string, size: Vector3, color: Color3, parent: Model, root: BasePart, offset: CFrame): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = root.CFrame * offset
	p.Parent = parent

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = p
	weld.Parent = p
	return p
end

--[[
	Builds a rig for a family member.

	`ghostly` renders the rig translucent and non-colliding -- used for Robby,
	Benny and Ava, who are present but not physical.
]]
function RigBuilder.build(killerId: string, ghostly: boolean?): Model?
	local profile = KillerData.get(killerId)
	if not profile then
		return nil
	end

	local scale = profile.Scale
	local isGhost = ghostly == true

	local model = Instance.new("Model")
	model.Name = profile.Name

	-- Body / root ---------------------------------------------------------
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = ROOT_SIZE * scale
	root.Color = profile.BodyColor
	root.Material = isGhost and Enum.Material.ForceField or Enum.Material.SmoothPlastic
	root.Transparency = isGhost and 0.45 or 0
	root.CanCollide = not isGhost
	root.TopSurface = Enum.SurfaceType.Smooth
	root.BottomSurface = Enum.SurfaceType.Smooth
	root.Parent = model
	model.PrimaryPart = root

	local torsoTop = (ROOT_SIZE.Y / 2) * scale

	-- Head ----------------------------------------------------------------
	local head = limb(
		"Head",
		Vector3.new(1.9, 1.9, 1.9) * scale,
		profile.BodyColor:Lerp(Color3.new(1, 1, 1), 0.15),
		model,
		root,
		CFrame.new(0, torsoTop + 0.95 * scale, 0)
	)
	head.Shape = Enum.PartType.Block
	head.Transparency = root.Transparency
	head.Material = root.Material

	-- Eyes: the only bright thing on the model, so you register a killer in a
	-- dark room the instant it turns toward you.
	for _, side in { -1, 1 } do
		local eye = limb(
			"Eye",
			Vector3.new(0.34, 0.22, 0.2) * scale,
			profile.EyeColor,
			model,
			root,
			CFrame.new(side * 0.42 * scale, torsoTop + 1.05 * scale, -0.95 * scale)
		)
		eye.Material = Enum.Material.Neon
		eye.Transparency = 0

		local glow = Instance.new("PointLight")
		glow.Color = profile.EyeColor
		glow.Brightness = 0.7
		glow.Range = 9
		glow.Parent = eye
	end

	-- Arms ----------------------------------------------------------------
	local armSize = Vector3.new(1, 2.9, 1) * scale
	limb("RightArm", armSize, profile.AccentColor, model, root, CFrame.new(2 * scale, -0.1 * scale, 0))
	-- Bob lost his right hand to Barbara. His arm ends early.
	local leftLength = (killerId == "Bob") and 1.8 or 2.9
	limb(
		"LeftArm",
		Vector3.new(1, leftLength, 1) * scale,
		profile.AccentColor,
		model,
		root,
		CFrame.new(-2 * scale, (-0.1 + (2.9 - leftLength) / 2) * scale, 0)
	)

	-- Legs ----------------------------------------------------------------
	local legSize = Vector3.new(1.15, HIP_HEIGHT, 1.15) * scale
	for _, side in { -1, 1 } do
		limb(
			"Leg",
			legSize,
			profile.AccentColor:Lerp(Color3.new(0, 0, 0), 0.3),
			model,
			root,
			CFrame.new(side * 0.75 * scale, -(torsoTop + (HIP_HEIGHT / 2) * scale), 0)
		)
	end

	-- Humanoid ------------------------------------------------------------
	local humanoid = Instance.new("Humanoid")
	humanoid.Name = "Humanoid"
	humanoid.HipHeight = HIP_HEIGHT * scale
	humanoid.RequiresNeck = false -- there is no Motor6D neck on this rig
	humanoid.BreakJointsOnDeath = false
	humanoid.AutoRotate = true
	humanoid.MaxSlopeAngle = 65
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.NameDisplayDistance = 0
	humanoid.HealthDisplayDistance = 0
	-- Killers are immortal. Their "health" is tracked as an attribute by
	-- CombatService; this Humanoid must never actually die.
	humanoid.MaxHealth = math.huge
	humanoid.Health = math.huge
	humanoid.WalkSpeed = profile.PatrolSpeed
	humanoid.Parent = model

	if isGhost then
		-- Ghosts drift; they don't need to path around furniture.
		humanoid.WalkSpeed = 8
	end

	return model
end

--[[
	Ava's grave ghost. She isn't in KillerData (she isn't family any more), so
	she gets her own small builder.
]]
function RigBuilder.buildAva(): Model
	local model = Instance.new("Model")
	model.Name = "Ava"

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2.6, 3, 1.6)
	root.Color = Color3.fromRGB(180, 190, 215)
	root.Material = Enum.Material.ForceField
	root.Transparency = 0.5
	root.Anchored = true
	root.CanCollide = false
	root.Parent = model
	model.PrimaryPart = root

	local head = limb("Head", Vector3.new(1.7, 1.7, 1.7), Color3.fromRGB(205, 212, 230), model, root, CFrame.new(0, 2.3, 0))
	head.Anchored = true
	head.Material = Enum.Material.ForceField
	head.Transparency = 0.4

	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(160, 190, 255)
	glow.Brightness = 1.6
	glow.Range = 22
	glow.Parent = root

	local humanoid = Instance.new("Humanoid")
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.MaxHealth = math.huge
	humanoid.Health = math.huge
	humanoid.WalkSpeed = 0
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.Parent = model

	return model
end

return RigBuilder
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX35">
			<Properties>
				<string name="Name">Services</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX18">
				<Properties>
					<string name="Name">AvaService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	AvaService.luau
	--------------------------------------------------------------------------
	Ava, standing over her own grave on the Graveyard map, asking players
	whether what she did was right.

	She has no gameplay effect. That is deliberate: the question is the point,
	and answering it should not make the round easier. Responses are tallied so
	a future build can do something with the verdict.

	The Graveyard map isn't enabled yet (Config.Maps), so this service simply
	does nothing until a map tags a part DH_AvaGrave.
	--------------------------------------------------------------------------
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Tags = require(Shared.Tags)
local Util = require(Shared.Util)

local MapService = require(script.Parent.MapService)
local RigBuilder = require(script.Parent.Parent.Build.RigBuilder)

local AvaService = {}

export type Prompt = {
	Id: string,
	Text: string,
	Options: { { Id: string, Text: string } },
}

--[[
	Her questions. She asks one at random; there is no "correct" answer and she
	does not argue with the one she's given.
]]
AvaService.Questions = {
	{
		Id = "WasItJust",
		Text = "They sold me for a promise. I gave them exactly what they asked for. Was that justice, or was it only spite wearing its coat?",
		Options = {
			{ Id = "Just", Text = "They chose it. You only let them have it." },
			{ Id = "Spite", Text = "You wanted them to suffer. Say so." },
			{ Id = "Unsure", Text = "I don't think anyone can answer that." },
		},
	},
	{
		Id = "ThirtyDays",
		Text = "Thirty days without harming a soul, and they would have walked out of here as people. Two of them managed it. Should the other five be given a thirty-first?",
		Options = {
			{ Id = "Mercy", Text = "Give them another. Robby and Benny did it." },
			{ Id = "Enough", Text = "They have had a hundred chances already." },
			{ Id = "Ask", Text = "Ask the people they've eaten." },
		},
	},
	{
		Id = "TheLoop",
		Text = "I reset the days when they fail. I have done it more times than I have counted. Am I giving them a chance, or am I refusing to let them end?",
		Options = {
			{ Id = "Chance", Text = "A chance. You still hope." },
			{ Id = "Refusing", Text = "You can't let go. That's not for them." },
			{ Id = "Both", Text = "Both. That's usually how it works." },
		},
	},
}

local responses: { [string]: number } = {}
local model: Model? = nil
local rng = Random.new()

--==========================================================================
-- Spawning
--==========================================================================

function AvaService.spawn()
	AvaService.despawn()

	local graves = MapService.getTaggedParts(Tags.AvaGrave)
	local grave = graves[1]
	if not grave then
		return -- not the Graveyard map
	end

	local built = RigBuilder.buildAva()
	built:PivotTo(CFrame.new(grave.Position + Vector3.new(0, 4, 2)) * CFrame.Angles(0, math.pi, 0))
	built.Parent = workspace
	model = built

	local root = built.PrimaryPart
	if not root then
		return
	end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "AvaPrompt"
	prompt.ActionText = "Speak"
	prompt.ObjectText = "Ava"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = root

	prompt.Triggered:Connect(function(player)
		local question = Util.pick(AvaService.Questions, rng)
		if question then
			Net.fire(player, "AvaDialogue", question)
		end
	end)

	Util.log("AvaService", "Ava is at her grave")
end

function AvaService.despawn()
	if model and model.Parent then
		model:Destroy()
	end
	model = nil
end

--==========================================================================
-- Responses
--==========================================================================

function AvaService.getTally(): { [string]: number }
	return table.clone(responses)
end

function AvaService.start()
	Net.Events.AvaRespond.OnServerEvent:Connect(function(_player, questionId, optionId)
		if type(questionId) ~= "string" or type(optionId) ~= "string" then
			return
		end
		local key = `{questionId}:{optionId}`
		responses[key] = (responses[key] or 0) + 1
	end)
end

return AvaService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX19">
				<Properties>
					<string name="Name">CombatService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	CombatService.luau
	--------------------------------------------------------------------------
	Stakes.

	Killers are immortal, and that is the point: draining a killer's bar buys
	you a stun, not a kill. Combat here is an escape tool -- something you spend
	to pull a killer off a downed teammate -- rather than a win condition. The
	stronger stakes buy longer stuns, not lethality.

	The swing is validated entirely on the server: cooldown, range and facing
	are all rechecked here, so a client firing the Attack remote in a loop gets
	nothing.
	--------------------------------------------------------------------------
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local StateKeys = require(Shared.StateKeys)
local Util = require(Shared.Util)

local DataService = require(script.Parent.DataService)
local KillerService = require(script.Parent.KillerService)
local NoiseService = require(script.Parent.NoiseService)
local TeamService = require(script.Parent.TeamService)

local CombatService = {}

--==========================================================================
-- Helpers
--==========================================================================

local function getEquippedTier(player: Player)
	local equipped = player:GetAttribute(StateKeys.Player.EquippedStake) :: string?
	if not equipped then
		local profile = DataService.peek(player)
		equipped = profile and profile.EquippedStake or Config.Economy.StartingStake
		player:SetAttribute(StateKeys.Player.EquippedStake, equipped)
	end
	return Config.getStakeTier(equipped)
end

--- The killer in front of the player, within range, if any.
local function findTarget(player: Player)
	local _, _, root = Util.getCharacterParts(player)
	if not root then
		return nil
	end

	local best = nil
	local bestDistance = math.huge

	for _, agent in KillerService.getAgents() do
		local distance = (agent:getPosition() - root.Position).Magnitude
		if distance > Config.Stakes.AttackRange then
			continue
		end
		-- Has to be roughly in front of you, not behind your back.
		if Util.angleTo(root.CFrame, agent:getPosition()) > 80 then
			continue
		end
		if distance < bestDistance then
			best = agent
			bestDistance = distance
		end
	end

	return best
end

local function playHitEffect(position: Vector3, color: Color3)
	local spark = Instance.new("Part")
	spark.Name = "StakeHit"
	spark.Anchored = true
	spark.CanCollide = false
	spark.CanQuery = false
	spark.Size = Vector3.new(1, 1, 1)
	spark.Transparency = 1
	spark.CFrame = CFrame.new(position)
	spark.Parent = workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.Lifetime = NumberRange.new(0.25, 0.5)
	emitter.Speed = NumberRange.new(8, 16)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rate = 0
	emitter.Size = NumberSequence.new(0.5)
	emitter.Parent = spark
	emitter:Emit(24)

	game:GetService("Debris"):AddItem(spark, 1.5)
end

--==========================================================================
-- Attacks
--==========================================================================

function CombatService.attack(player: Player)
	if not TeamService.isAlive(player) then
		return
	end
	if player:GetAttribute(StateKeys.Player.Hidden) == true then
		return
	end

	local now = Util.now()
	local readyAt = (player:GetAttribute(StateKeys.Player.StakeReadyAt) or 0) :: number
	if now < readyAt then
		return
	end

	local tier = getEquippedTier(player)
	if not tier then
		return
	end

	player:SetAttribute(StateKeys.Player.StakeReadyAt, now + Config.Stakes.Cooldown)

	-- Swinging is loud whether or not you connect.
	NoiseService.add(player, Config.Noise.Actions.Attack, "stake swing")

	local agent = findTarget(player)
	if not agent then
		Net.fire(player, "Announce", { Kind = "Combat", Text = "You swing at nothing." })
		return
	end

	local remaining = agent:damage(tier.Damage, tier.StunSeconds)
	playHitEffect(agent:getPosition() + Vector3.new(0, 2, 0), Color3.fromRGB(220, 60, 60))

	Net.fireAll("Announce", {
		Kind = "Stake",
		Text = `{player.DisplayName} staked {agent.profile.Name}!`,
		KillerId = agent.killerId,
		KillerName = agent.profile.Name,
		Health = remaining,
		MaxHealth = agent.profile.MaxHealth,
		StunSeconds = tier.StunSeconds,
	})

	Util.log("CombatService", "%s hit %s for %d (%d left)", player.Name, agent.profile.Name, tier.Damage, remaining)
end

--==========================================================================
-- Equipping
--==========================================================================

function CombatService.equip(player: Player, stakeId: string)
	if not DataService.ownsStake(player, stakeId) then
		return
	end
	if DataService.setEquippedStake(player, stakeId) then
		player:SetAttribute(StateKeys.Player.EquippedStake, stakeId)
	end
end

--- Puts a player's saved stake onto their attribute at round start.
function CombatService.syncEquipped(player: Player)
	local profile = DataService.peek(player)
	local equipped = profile and profile.EquippedStake or Config.Economy.StartingStake
	player:SetAttribute(StateKeys.Player.EquippedStake, equipped)
	player:SetAttribute(StateKeys.Player.StakeReadyAt, 0)
end

--==========================================================================
-- Lifecycle
--==========================================================================

function CombatService.start()
	Net.Events.Attack.OnServerEvent:Connect(function(player)
		local ok, err = pcall(CombatService.attack, player)
		if not ok then
			Util.warn("CombatService", "attack failed: %s", tostring(err))
		end
	end)

	Net.Events.EquipStake.OnServerEvent:Connect(function(player, stakeId)
		if type(stakeId) == "string" then
			CombatService.equip(player, stakeId)
		end
	end)
end

return CombatService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX20">
				<Properties>
					<string name="Name">DataService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	DataService.luau
	--------------------------------------------------------------------------
	Coins, Wins, owned stakes and inventory -- loaded on join, saved on leave.

	Degrades gracefully: if DataStores are unavailable (Studio without API
	access, or a DataStore outage) the service keeps everything in memory for
	the session and warns once. The game stays playable; progress just doesn't
	persist. That matters because you'll do most of your testing in Studio.
	--------------------------------------------------------------------------
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

export type Profile = {
	Coins: number,
	Wins: number,
	RoundsPlayed: number,
	OwnedStakes: { [string]: boolean },
	EquippedStake: string,
	Inventory: { [string]: number },
	LoreFound: { [string]: boolean },
	TotalTasks: number,
	TotalRevives: number,
}

local DataService = {}

local store: DataStore? = nil
local storeAvailable = true
local warnedUnavailable = false

local profiles: { [Player]: Profile } = {}
local loading: { [Player]: boolean } = {}

--==========================================================================
-- Defaults
--==========================================================================

local function defaultProfile(): Profile
	local owned = {}
	if Config.Economy.StartingStake then
		owned[Config.Economy.StartingStake] = true
	end
	return {
		Coins = Config.Economy.StartingCoins,
		Wins = 0,
		RoundsPlayed = 0,
		OwnedStakes = owned,
		EquippedStake = Config.Economy.StartingStake,
		Inventory = {},
		LoreFound = {},
		TotalTasks = 0,
		TotalRevives = 0,
	}
end

--- Fills in anything a saved profile is missing, so adding a field later
--- doesn't break existing players.
local function reconcile(saved: any): Profile
	local profile = defaultProfile()
	if type(saved) ~= "table" then
		return profile
	end

	profile.Coins = tonumber(saved.Coins) or profile.Coins
	profile.Wins = tonumber(saved.Wins) or profile.Wins
	profile.RoundsPlayed = tonumber(saved.RoundsPlayed) or profile.RoundsPlayed
	profile.TotalTasks = tonumber(saved.TotalTasks) or profile.TotalTasks
	profile.TotalRevives = tonumber(saved.TotalRevives) or profile.TotalRevives

	if type(saved.OwnedStakes) == "table" then
		for id, value in saved.OwnedStakes do
			if value and Config.getStakeTier(id) then
				profile.OwnedStakes[id] = true
			end
		end
	end
	if type(saved.Inventory) == "table" then
		for id, count in saved.Inventory do
			if type(count) == "number" and count > 0 then
				profile.Inventory[id] = math.floor(count)
			end
		end
	end
	if type(saved.LoreFound) == "table" then
		for id, value in saved.LoreFound do
			if value then
				profile.LoreFound[id] = true
			end
		end
	end

	-- Never leave a player holding a stake they don't own.
	if not profile.OwnedStakes[saved.EquippedStake] then
		profile.EquippedStake = Config.Economy.StartingStake
	else
		profile.EquippedStake = saved.EquippedStake
	end

	return profile
end

--==========================================================================
-- Store access
--==========================================================================

local function key(player: Player): string
	return `player_{player.UserId}`
end

local function markUnavailable(err: any)
	storeAvailable = false
	if not warnedUnavailable then
		warnedUnavailable = true
		Util.warn(
			"DataService",
			"DataStores unavailable (%s). Progress will not persist this session. "
				.. "In Studio: Game Settings -> Security -> Enable Studio Access to API Services.",
			tostring(err)
		)
	end
end

--- Runs a DataStore call with retries and exponential backoff.
local function withRetry<T>(fn: () -> T): (boolean, T?)
	local delaySeconds = Config.Data.RetryBackoff
	for attempt = 1, Config.Data.MaxRetries do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		if attempt == Config.Data.MaxRetries then
			return false, result :: any
		end
		task.wait(delaySeconds)
		delaySeconds *= 2
	end
	return false, nil
end

--==========================================================================
-- Leaderstats
--==========================================================================

local function buildLeaderstats(player: Player, profile: Profile)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		leaderstats.Parent = player
	end

	local coins = leaderstats:FindFirstChild("Coins") :: IntValue?
	if not coins then
		coins = Instance.new("IntValue")
		coins.Name = "Coins"
		coins.Parent = leaderstats
	end
	coins.Value = profile.Coins

	local wins = leaderstats:FindFirstChild("Wins") :: IntValue?
	if not wins then
		wins = Instance.new("IntValue")
		wins.Name = "Wins"
		wins.Parent = leaderstats
	end
	wins.Value = profile.Wins
end

local function syncLeaderstats(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end
	local coins = leaderstats:FindFirstChild("Coins") :: IntValue?
	local wins = leaderstats:FindFirstChild("Wins") :: IntValue?
	if coins then
		coins.Value = profile.Coins
	end
	if wins then
		wins.Value = profile.Wins
	end
end

--==========================================================================
-- Load / save
--==========================================================================

local function load(player: Player)
	loading[player] = true

	local profile = defaultProfile()

	if store and storeAvailable then
		local ok, saved = withRetry(function()
			return (store :: DataStore):GetAsync(key(player))
		end)
		if ok then
			profile = reconcile(saved)
		else
			markUnavailable(saved)
			-- Don't hand a fresh profile to someone whose data merely failed to
			-- load -- they'd overwrite real progress on save. Flag them.
			profile = defaultProfile()
			player:SetAttribute("DataLoadFailed", true)
		end
	end

	if not player.Parent then
		loading[player] = nil
		return
	end

	profiles[player] = profile
	loading[player] = nil
	buildLeaderstats(player, profile)
	Util.log("DataService", "loaded %s (%d coins, %d wins)", player.Name, profile.Coins, profile.Wins)
end

local function save(player: Player)
	local profile = profiles[player]
	if not profile or not store or not storeAvailable then
		return
	end
	if player:GetAttribute("DataLoadFailed") then
		-- Their real data is still out there; writing would clobber it.
		return
	end

	local snapshot = {
		Coins = profile.Coins,
		Wins = profile.Wins,
		RoundsPlayed = profile.RoundsPlayed,
		OwnedStakes = profile.OwnedStakes,
		EquippedStake = profile.EquippedStake,
		Inventory = profile.Inventory,
		LoreFound = profile.LoreFound,
		TotalTasks = profile.TotalTasks,
		TotalRevives = profile.TotalRevives,
	}

	local ok, err = withRetry(function()
		return (store :: DataStore):UpdateAsync(key(player), function()
			return snapshot
		end)
	end)

	if not ok then
		markUnavailable(err)
	else
		Util.log("DataService", "saved %s", player.Name)
	end
end

--==========================================================================
-- Public API
--==========================================================================

--- Waits (up to `timeout`) for a player's profile to finish loading.
function DataService.getProfile(player: Player, timeout: number?): Profile?
	local deadline = os.clock() + (timeout or 10)
	while loading[player] and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

--- Non-yielding read. Returns nil if the profile isn't ready yet.
function DataService.peek(player: Player): Profile?
	return profiles[player]
end

function DataService.addCoins(player: Player, amount: number): number
	local profile = profiles[player]
	if not profile then
		return 0
	end
	profile.Coins = math.max(0, profile.Coins + amount)
	syncLeaderstats(player)
	return profile.Coins
end

--- Returns true if the player could afford it (and the coins were taken).
function DataService.trySpend(player: Player, amount: number): boolean
	local profile = profiles[player]
	if not profile or profile.Coins < amount then
		return false
	end
	profile.Coins -= amount
	syncLeaderstats(player)
	return true
end

function DataService.addWin(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.Wins += 1
	syncLeaderstats(player)
end

function DataService.recordRound(player: Player, tasks: number, revives: number)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.RoundsPlayed += 1
	profile.TotalTasks += tasks
	profile.TotalRevives += revives
end

function DataService.grantStake(player: Player, stakeId: string): boolean
	local profile = profiles[player]
	if not profile or not Config.getStakeTier(stakeId) then
		return false
	end
	profile.OwnedStakes[stakeId] = true
	return true
end

function DataService.ownsStake(player: Player, stakeId: string): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.OwnedStakes[stakeId] == true
end

function DataService.setEquippedStake(player: Player, stakeId: string): boolean
	local profile = profiles[player]
	if not profile or not profile.OwnedStakes[stakeId] then
		return false
	end
	profile.EquippedStake = stakeId
	return true
end

function DataService.addItem(player: Player, itemId: string, count: number)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.Inventory[itemId] = (profile.Inventory[itemId] or 0) + count
	if profile.Inventory[itemId] <= 0 then
		profile.Inventory[itemId] = nil
	end
end

function DataService.consumeItem(player: Player, itemId: string): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	local have = profile.Inventory[itemId] or 0
	if have <= 0 then
		return false
	end
	profile.Inventory[itemId] = have - 1
	if profile.Inventory[itemId] <= 0 then
		profile.Inventory[itemId] = nil
	end
	return true
end

function DataService.markLoreFound(player: Player, noteId: string): boolean
	local profile = profiles[player]
	if not profile or profile.LoreFound[noteId] then
		return false
	end
	profile.LoreFound[noteId] = true
	return true
end

--- Serialisable snapshot for sending to the client.
function DataService.toClientPayload(player: Player)
	local profile = profiles[player]
	if not profile then
		return nil
	end
	return {
		Coins = profile.Coins,
		Wins = profile.Wins,
		RoundsPlayed = profile.RoundsPlayed,
		OwnedStakes = profile.OwnedStakes,
		EquippedStake = profile.EquippedStake,
		Inventory = profile.Inventory,
		TotalTasks = profile.TotalTasks,
		TotalRevives = profile.TotalRevives,
	}
end

--==========================================================================
-- Lifecycle
--==========================================================================

function DataService.start()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.Data.StoreName)
	end)
	if ok then
		store = result
	else
		markUnavailable(result)
	end

	Players.PlayerAdded:Connect(function(player)
		task.spawn(load, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		save(player)
		profiles[player] = nil
		loading[player] = nil
	end)

	-- Periodic autosave, staggered so we don't burst the request budget.
	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveInterval)
			for _, player in Players:GetPlayers() do
				if profiles[player] then
					task.spawn(save, player)
					task.wait(0.5)
				end
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() then
			return
		end
		local pending = 0
		for _, player in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				save(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 20
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX21">
				<Properties>
					<string name="Name">GameStateManager</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	GameStateManager.luau
	--------------------------------------------------------------------------
	The round loop.

	  INTERMISSION (50s)  lobby, map voting for the first 30
	  STARTING     (6s)   map loads, killers spawn, players are placed
	  ACTIVE       (600s) the round
	  RESULTS      (15s)  scoreboard, payouts
	  -> back to INTERMISSION

	Phase and deadline replicate as attributes rather than a ticking counter:
	the server writes PhaseEndsAt once, and every client renders its own smooth
	countdown against the synced clock. One write per phase instead of one per
	second, and no drift.
	--------------------------------------------------------------------------
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local StateKeys = require(Shared.StateKeys)
local Util = require(Shared.Util)

local AvaService = require(script.Parent.AvaService)
local CombatService = require(script.Parent.CombatService)
local HelperService = require(script.Parent.HelperService)
local HidingService = require(script.Parent.HidingService)
local KillerService = require(script.Parent.KillerService)
local MapService = require(script.Parent.MapService)
local NoiseService = require(script.Parent.NoiseService)
local ObjectiveService = require(script.Parent.ObjectiveService)
local PlayerService = require(script.Parent.PlayerService)
local RevivalService = require(script.Parent.RevivalService)
local SafeZoneService = require(script.Parent.SafeZoneService)
local StatsService = require(script.Parent.StatsService)
local TeamService = require(script.Parent.TeamService)
local VoteService = require(script.Parent.VoteService)

local GameStateManager = {}

local PHASE = StateKeys.Phase

local roundNumber = 0
local objectivesComplete = false
local roundDecided = false
local rng = Random.new()

--==========================================================================
-- Phase helpers
--==========================================================================

local function setPhase(phase: string, duration: number)
	Net.setStateValue(StateKeys.Game.Phase, phase)
	Net.setStateValue(StateKeys.Game.PhaseStartedAt, Util.now())
	Net.setStateValue(StateKeys.Game.PhaseEndsAt, Util.now() + duration)
	Util.log("GameState", "phase -> %s (%ds)", phase, duration)
end

local function refreshCounts()
	Net.setStateValue(StateKeys.Game.AlivePlayers, #TeamService.getAlive())
	Net.setStateValue(StateKeys.Game.TotalPlayers, #Players:GetPlayers())
end

local function teleportToLobby(player: Player)
	local spawns = MapService.getLobbySpawns()
	if #spawns == 0 then
		return
	end
	local destination = spawns[rng:NextInteger(1, #spawns)]
	local character = player.Character
	if character and character.PrimaryPart then
		character:PivotTo(destination)
	end
end

local function teleportAllToLobby()
	for _, player in Players:GetPlayers() do
		teleportToLobby(player)
	end
end

--==========================================================================
-- Win / loss
--==========================================================================

--[[
	Called whenever the roster or objective progress changes. Deliberately
	idempotent and guarded by `roundDecided`, because a wipe and the last
	objective completing can land in the same frame.
]]
local function evaluateRound()
	if Net.getStateValue(StateKeys.Game.Phase, "") ~= PHASE.Active or roundDecided then
		return
	end

	refreshCounts()

	if objectivesComplete then
		-- Someone has to be left standing to have actually escaped.
		if #TeamService.getAlive() > 0 then
			roundDecided = true
			GameStateManager.finishRound(true)
		else
			roundDecided = true
			GameStateManager.finishRound(false)
		end
		return
	end

	if TeamService.isWipe() then
		roundDecided = true
		GameStateManager.finishRound(false)
	end
end

--==========================================================================
-- Phases
--==========================================================================

local function runIntermission()
	setPhase(PHASE.Intermission, Config.Round.IntermissionSeconds)
	Net.setStateValue(StateKeys.Game.Result, "")
	Net.setStateValue(StateKeys.Game.MapId, "")
	Net.setStateValue(StateKeys.Game.MapName, "")
	Net.setStateValue(StateKeys.Game.KillerNames, "")
	Net.setStateValue(StateKeys.Game.ComboId, "")

	TeamService.resetAll()
	NoiseService.resetAll()
	StatsService.clear()
	for _, player in Players:GetPlayers() do
		PlayerService.resetRoundModifiers(player)
	end

	teleportAllToLobby()
	refreshCounts()

	Net.fireAll("RoundStatus", {
		Phase = PHASE.Intermission,
		EndsAt = Net.getStateValue(StateKeys.Game.PhaseEndsAt, 0),
	})

	VoteService.openVoting()
	task.wait(Config.Round.VotingSeconds)
	local mapId = VoteService.closeVoting()

	local info = MapService.getMapInfo(mapId)
	Net.fireAll("Announce", {
		Kind = "MapChosen",
		Text = `Next map: {info and info.Name or mapId}`,
	})

	-- The rest of the intermission is just the countdown.
	local remaining = Net.getStateValue(StateKeys.Game.PhaseEndsAt, Util.now()) - Util.now()
	if remaining > 0 then
		task.wait(remaining)
	end

	return mapId
end

--- True if there are enough people to bother starting.
local function hasEnoughPlayers(): boolean
	return #Players:GetPlayers() >= Config.Round.MinPlayersToStart
end

local function runStarting(mapId: string): boolean
	setPhase(PHASE.Starting, Config.Round.StartupSeconds)
	roundNumber += 1
	objectivesComplete = false
	roundDecided = false

	Net.setStateValue(StateKeys.Game.RoundNumber, roundNumber)

	local map = MapService.load(mapId)
	if not map then
		Net.fireAll("Announce", { Kind = "Error", Text = "That map failed to load. Falling back to The House." })
		map = MapService.load("TheHouse")
		if not map then
			Util.warn("GameState", "no map could be loaded; aborting round")
			return false
		end
		mapId = "TheHouse"
	end

	local info = MapService.getMapInfo(mapId)
	Net.setStateValue(StateKeys.Game.MapId, mapId)
	Net.setStateValue(StateKeys.Game.MapName, info and info.Name or mapId)

	-- Objectives first: setupFuses needs to darken the safe zones before
	-- anybody is standing in one.
	local comboId = ObjectiveService.beginRound()
	Net.setStateValue(StateKeys.Game.ComboId, comboId)

	-- No-op on any map without a DH_AvaGrave part.
	AvaService.spawn()

	-- Everyone currently in the server joins the round.
	local participants = Players:GetPlayers()
	for _, player in participants do
		TeamService.enterRound(player)
		CombatService.syncEquipped(player)
		PlayerService.resetRoundModifiers(player)
		NoiseService.reset(player)
	end
	StatsService.beginRound(participants)

	local spawns = MapService.getPlayerSpawns()
	local placements = MapService.allocateSpawns(spawns, #participants, rng)
	for index, player in participants do
		local character = player.Character
		local placement = placements[index]
		if character and character.PrimaryPart and placement then
			character:PivotTo(placement)
			local _, humanoid = Util.getCharacterParts(player)
			if humanoid then
				humanoid.Health = humanoid.MaxHealth
			end
		end
	end

	local killerIds = KillerService.selectKillers()
	local spawned = KillerService.spawnKillers(killerIds)
	Net.setStateValue(StateKeys.Game.KillerNames, table.concat(KillerService.getActiveNames(), ", "))

	if #spawned == 0 then
		Util.warn("GameState", "no killers spawned -- the round will be trivially winnable")
	end

	refreshCounts()

	Net.fireAll("RoundStatus", {
		Phase = PHASE.Starting,
		EndsAt = Net.getStateValue(StateKeys.Game.PhaseEndsAt, 0),
		MapId = mapId,
		MapName = info and info.Name or mapId,
		Killers = KillerService.getActiveNames(),
		Objective = ObjectiveService.describe(),
		Objectives = ObjectiveService.getSnapshot(),
	})

	task.wait(Config.Round.StartupSeconds)
	return true
end

local function runActive()
	setPhase(PHASE.Active, Config.Round.RoundSeconds)

	Net.fireAll("RoundStatus", {
		Phase = PHASE.Active,
		EndsAt = Net.getStateValue(StateKeys.Game.PhaseEndsAt, 0),
		MapName = Net.getStateValue(StateKeys.Game.MapName, ""),
		Killers = KillerService.getActiveNames(),
		Objective = ObjectiveService.describe(),
		Objectives = ObjectiveService.getSnapshot(),
	})

	HelperService.beginRound()

	local deadline = Net.getStateValue(StateKeys.Game.PhaseEndsAt, Util.now())
	while Util.now() < deadline and not roundDecided do
		evaluateRound()
		task.wait(0.5)
	end

	if not roundDecided then
		-- The clock ran out.
		roundDecided = true
		GameStateManager.finishRound(false)
	end
end

--==========================================================================
-- Round end
--==========================================================================

function GameStateManager.finishRound(victory: boolean)
	if Net.getStateValue(StateKeys.Game.Phase, "") == PHASE.Results then
		return
	end

	setPhase(PHASE.Results, Config.Round.ResultsSeconds)
	Net.setStateValue(StateKeys.Game.Result, victory and "Victory" or "Defeat")

	KillerService.freezeAll()
	HelperService.endRound()
	HidingService.releaseAll()
	RevivalService.clearAll()

	local results = StatsService.endRound(victory)

	Net.fireAll("RoundResults", {
		Victory = victory,
		MapName = Net.getStateValue(StateKeys.Game.MapName, ""),
		Killers = KillerService.getActiveNames(),
		Objectives = ObjectiveService.getSnapshot(),
		Results = results,
		EndsAt = Net.getStateValue(StateKeys.Game.PhaseEndsAt, 0),
	})

	Util.log("GameState", "round %d ended: %s", roundNumber, victory and "VICTORY" or "DEFEAT")
end

local function runResults()
	-- The results screen shows over the frozen map for a beat before everyone
	-- is pulled back to the lobby, so players can see where it went wrong.
	task.wait(Config.Round.ResultsSeconds)

	KillerService.despawnAll()
	ObjectiveService.endRound()
	SafeZoneService.clearTemporary()
	AvaService.despawn()
	TeamService.resetAll()

	teleportAllToLobby()
	MapService.unload()

	task.wait(Config.Round.PostResultsSeconds)
end

--==========================================================================
-- Main loop
--==========================================================================

local function waitForPlayers()
	while not hasEnoughPlayers() do
		Net.setStateValue(StateKeys.Game.Phase, PHASE.Intermission)
		Net.setStateValue(StateKeys.Game.PhaseEndsAt, Util.now() + 5)
		Net.fireAll("Announce", {
			Kind = "Waiting",
			Text = `Waiting for players ({#Players:GetPlayers()}/{Config.Round.MinPlayersToStart})`,
		})
		task.wait(3)
	end
end

function GameStateManager.start()
	Net.setStateValue(StateKeys.Game.Phase, PHASE.Booting)
	Net.setStateValue(StateKeys.Game.Result, "")
	Net.setStateValue(StateKeys.Game.RoundNumber, 0)

	-- Objective completion and roster changes both feed the same evaluation.
	ObjectiveService.setCompletionCallback(function()
		objectivesComplete = true
		evaluateRound()
	end)
	RevivalService.setRosterChangedCallback(function()
		evaluateRound()
	end)

	-- A player joining mid-round watches from the lobby; one leaving might have
	-- been the last one standing.
	Players.PlayerAdded:Connect(function(player)
		task.wait(1)
		if Net.getStateValue(StateKeys.Game.Phase, "") == PHASE.Active then
			TeamService.exitRound(player, false)
			player:SetAttribute(StateKeys.Player.Spectating, true)
			teleportToLobby(player)
			Net.fire(player, "Announce", {
				Kind = "Spectating",
				Text = "A round is already under way. You'll join the next one.",
			})
		end
		refreshCounts()
	end)

	Players.PlayerRemoving:Connect(function()
		task.defer(evaluateRound)
	end)

	-- Answering the RemoteFunction lets a client that joined late rebuild its
	-- HUD without waiting for the next phase change.
	Net.Functions.GetRoundSnapshot.OnServerInvoke = function()
		return {
			Phase = Net.getStateValue(StateKeys.Game.Phase, PHASE.Booting),
			EndsAt = Net.getStateValue(StateKeys.Game.PhaseEndsAt, 0),
			MapId = Net.getStateValue(StateKeys.Game.MapId, ""),
			MapName = Net.getStateValue(StateKeys.Game.MapName, ""),
			Killers = KillerService.getActiveNames(),
			Objective = ObjectiveService.describe(),
			Objectives = ObjectiveService.getSnapshot(),
			RoundNumber = roundNumber,
		}
	end

	task.spawn(function()
		while true do
			local ok, err = pcall(function()
				waitForPlayers()

				local mapId = runIntermission()

				if not hasEnoughPlayers() then
					return
				end

				if runStarting(mapId) then
					runActive()
					runResults()
				end
			end)

			if not ok then
				Util.warn("GameState", "round loop error: %s", tostring(err))
				-- Reset to something sane rather than wedging the server.
				pcall(function()
					KillerService.despawnAll()
					ObjectiveService.endRound()
					HelperService.endRound()
					RevivalService.clearAll()
					HidingService.releaseAll()
					TeamService.resetAll()
					MapService.unload()
					teleportAllToLobby()
				end)
				task.wait(5)
			end

			task.wait(0.5)
		end
	end)
end

return GameStateManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX22">
				<Properties>
					<string name="Name">HelperService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	HelperService.luau
	--------------------------------------------------------------------------
	Robby and Benny -- the two who chose not to hunt.

	Robby appears and drops a safe zone that killers cannot enter.
	Benny appears near a task and warns about whoever is closest.

	And roughly one time in twenty, the helper you just ran toward is Robert
	wearing his brother's face. His eyes are red instead of blue. That's the only
	tell, and it exists so that the sight of a friendly ghost never becomes
	completely relaxing.
	--------------------------------------------------------------------------
]]

local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local KillerData = require(Shared.KillerData)
local Net = require(Shared.Net)
local Tags = require(Shared.Tags)
local Util = require(Shared.Util)

local KillerService = require(script.Parent.KillerService)
local MapService = require(script.Parent.MapService)
local RigBuilder = require(script.Parent.Parent.Build.RigBuilder)
local SafeZoneService = require(script.Parent.SafeZoneService)
local TeamService = require(script.Parent.TeamService)

local HelperService = {}

local scheduler: thread? = nil
local activeModels: { Model } = {}
local rng = Random.new()

--==========================================================================
-- Appearance
--==========================================================================

local function speak(model: Model, text: string, colour: Color3)
	local root = model.PrimaryPart
	if not root then
		return
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Dialogue"
	billboard.Size = UDim2.fromScale(14, 3)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 5, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 120
	billboard.Parent = root

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Merriweather
	label.TextColor3 = colour
	label.TextStrokeTransparency = 0.3
	label.TextScaled = true
	label.Text = text
	label.Parent = billboard

	task.delay(6, function()
		if billboard.Parent then
			billboard:Destroy()
		end
	end)
end

local function despawn(model: Model)
	local index = table.find(activeModels, model)
	if index then
		table.remove(activeModels, index)
	end
	if model.Parent then
		model:Destroy()
	end
end

--==========================================================================
-- Robby: safe zones
--==========================================================================

local function appearAsRobby(position: Vector3, isImposter: boolean)
	local helperId = isImposter and "Robert" or "Robby"
	local model = RigBuilder.build(helperId, true)
	if not model then
		return
	end

	model.Name = "Robby"
	model:PivotTo(CFrame.new(position + Vector3.new(0, 3, 0)))
	model.Parent = workspace
	CollectionService:AddTag(model, Tags.ActiveHelper)
	table.insert(activeModels, model)

	local profile = KillerData.get("Robby")
	local line = (profile and Util.pick(profile.Lines, rng)) or "Hide here, quickly!"
	speak(model, line, isImposter and Color3.fromRGB(255, 150, 150) or Color3.fromRGB(180, 220, 255))

	if isImposter then
		-- No safe zone. The lie is the whole mechanic; the red eyes from the
		-- Robert rig are the only warning anyone gets.
		task.delay(Config.Helpers.VisibleSeconds * 0.5, function()
			despawn(model)
		end)
		return
	end

	SafeZoneService.createTemporary(position, Config.Helpers.SafeZoneRadius, Config.Helpers.SafeZoneDuration)

	Net.fireAll("HelperMessage", {
		Helper = "Robby",
		Text = line,
		Position = position,
		SafeZone = true,
		Duration = Config.Helpers.SafeZoneDuration,
	})

	task.delay(Config.Helpers.SafeZoneDuration, function()
		despawn(model)
	end)
end

--==========================================================================
-- Benny: warnings and hints
--==========================================================================

local function appearAsBenny(position: Vector3)
	local model = RigBuilder.build("Benny", true)
	if not model then
		return
	end

	model:PivotTo(CFrame.new(position + Vector3.new(0, 3, 0)))
	model.Parent = workspace
	CollectionService:AddTag(model, Tags.ActiveHelper)
	table.insert(activeModels, model)

	-- Warn about whichever killer is nearest to him.
	local nearest, distance = KillerService.getNearest(position)
	local text: string
	if nearest and distance < 90 then
		text = `Shh! {nearest.profile.Name}'s coming this way!`
	else
		local profile = KillerData.get("Benny")
		text = (profile and Util.pick(profile.Lines, rng)) or "I didn't want this... none of us did."
	end

	speak(model, text, Color3.fromRGB(190, 255, 220))

	-- Only tell players close enough to have heard him whisper.
	for _, player in TeamService.getParticipants() do
		local playerPosition = Util.getPosition(player)
		if playerPosition and (playerPosition - position).Magnitude <= Config.Helpers.WarnRange * 2 then
			Net.fire(player, "HelperMessage", {
				Helper = "Benny",
				Text = text,
				Position = position,
				KillerName = nearest and nearest.profile.Name or nil,
				KillerPosition = nearest and nearest:getPosition() or nil,
			})
		end
	end

	task.delay(Config.Helpers.VisibleSeconds, function()
		despawn(model)
	end)
end

--==========================================================================
-- Placement
--==========================================================================

--[[
	Helpers should turn up somewhere useful: near a player who is in trouble
	rather than in an empty room on the far side of the map. Preference order is
	a tagged helper spawn near a living player, then any living player's
	surroundings, then any helper spawn at all.
]]
local function choosePosition(): Vector3?
	local alive = TeamService.getAlive()
	local spawns = MapService.getHelperSpawns()

	if #alive > 0 and #spawns > 0 then
		local anchor = Util.pick(alive, rng)
		local anchorPosition = anchor and Util.getPosition(anchor)
		if anchorPosition then
			local best: BasePart? = nil
			local bestDistance = math.huge
			for _, spawnPoint in spawns do
				local distance = (spawnPoint.Position - anchorPosition).Magnitude
				-- Close enough to reach, far enough to not appear on top of them.
				if distance > 20 and distance < bestDistance then
					best = spawnPoint
					bestDistance = distance
				end
			end
			if best then
				return best.Position
			end
		end
	end

	local fallback = Util.pick(spawns, rng)
	if fallback then
		return fallback.Position
	end

	local anyone = Util.pick(alive, rng)
	if anyone then
		local position = Util.getPosition(anyone)
		if position then
			return position + Vector3.new(rng:NextNumber(-25, 25), 0, rng:NextNumber(-25, 25))
		end
	end

	return nil
end

--==========================================================================
-- Lifecycle
--==========================================================================

function HelperService.beginRound()
	HelperService.endRound()

	local appearances = rng:NextInteger(Config.Helpers.AppearancesPerRound.Min, Config.Helpers.AppearancesPerRound.Max)

	scheduler = task.spawn(function()
		task.wait(Config.Helpers.FirstAppearanceDelay)

		for index = 1, appearances do
			if #TeamService.getAlive() == 0 then
				return
			end

			local position = choosePosition()
			if position then
				-- Alternate so a round doesn't hand out four safe zones and no
				-- warnings, or the other way round.
				if index % 2 == 1 then
					local isImposter = rng:NextNumber() < Config.Helpers.ImposterChance
					appearAsRobby(position, isImposter)
				else
					appearAsBenny(position)
				end
			end

			task.wait(rng:NextInteger(Config.Helpers.AppearanceGap.Min, Config.Helpers.AppearanceGap.Max))
		end
	end)
end

function HelperService.endRound()
	if scheduler then
		task.cancel(scheduler)
		scheduler = nil
	end
	for index = #activeModels, 1, -1 do
		despawn(activeModels[index])
	end
	SafeZoneService.clearTemporary()
end

return HelperService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX23">
				<Properties>
					<string name="Name">HidingService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	HidingService.luau
	--------------------------------------------------------------------------
	Lockers, beds, tables, closets and ducts.

	Hiding is a genuine trade-off rather than a safe button: you stop making
	noise and killers can't target you, but you can't do tasks, you can't see
	much, and sitting in one spot too long makes the family suspicious of it --
	which raises the odds a passing killer tears the door open.
	--------------------------------------------------------------------------
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local StateKeys = require(Shared.StateKeys)
local Tags = require(Shared.Tags)
local Util = require(Shared.Util)

local NoiseService = require(script.Parent.NoiseService)
local TeamService = require(script.Parent.TeamService)

local HidingService = {}

type HideRecord = {
	Spot: BasePart,
	EnteredAt: number,
	RestoreTransparency: { [BasePart]: number },
	RestoreCollide: { [BasePart]: boolean },
	RestoreCFrame: CFrame,
}

local hidden: { [Player]: HideRecord } = {}
local occupants: { [BasePart]: { Player } } = {}
local lastExit: { [Player]: number } = {}
local prompts: { [BasePart]: ProximityPrompt } = {}

--==========================================================================
-- Queries
--==========================================================================

function HidingService.isHidden(player: Player): boolean
	return hidden[player] ~= nil
end

function HidingService.getSpot(player: Player): BasePart?
	local record = hidden[player]
	return record and record.Spot or nil
end

function HidingService.getOccupants(spot: BasePart): { Player }
	return occupants[spot] or {}
end

--- Seconds the player has been in their current spot, or 0.
function HidingService.getHideDuration(player: Player): number
	local record = hidden[player]
	if not record then
		return 0
	end
	return Util.now() - record.EnteredAt
end

--- A spot is "suspicious" once someone has camped it past the threshold.
--- KillerAgent weights its searches toward these.
function HidingService.isSpotSuspicious(spot: BasePart): boolean
	for _, player in occupants[spot] or {} do
		if HidingService.getHideDuration(player) >= Config.Killer.LongHideSuspicionSeconds then
			return true
		end
	end
	return false
end

--- Hiding spots within `radius` of a position, suspicious ones first.
function HidingService.getSpotsNear(position: Vector3, radius: number): { BasePart }
	local found = {}
	for spot in occupants do
		if spot.Parent and (spot.Position - position).Magnitude <= radius then
			table.insert(found, spot)
		end
	end
	table.sort(found, function(a, b)
		local aSus = HidingService.isSpotSuspicious(a) and 1 or 0
		local bSus = HidingService.isSpotSuspicious(b) and 1 or 0
		if aSus ~= bSus then
			return aSus > bSus
		end
		return (a.Position - position).Magnitude < (b.Position - position).Magnitude
	end)
	return found
end

--==========================================================================
-- Enter / exit
--==========================================================================

local function characterParts(character: Model): { BasePart }
	local parts = {}
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
		end
	end
	return parts
end

local function enter(player: Player, spot: BasePart): boolean
	if hidden[player] then
		return false
	end
	if not TeamService.isAlive(player) then
		return false
	end

	local exitedAt = lastExit[player]
	if exitedAt and Util.now() - exitedAt < Config.Hiding.ExitDelay then
		return false
	end

	local character, humanoid, root = Util.getCharacterParts(player)
	if not character or not humanoid or not root then
		return false
	end

	-- Don't let a player hide across the map from the prompt.
	if (root.Position - spot.Position).Magnitude > 16 then
		return false
	end

	local record: HideRecord = {
		Spot = spot,
		EnteredAt = Util.now(),
		RestoreTransparency = {},
		RestoreCollide = {},
		RestoreCFrame = root.CFrame,
	}

	for _, bodyPart in characterParts(character) do
		record.RestoreTransparency[bodyPart] = bodyPart.Transparency
		record.RestoreCollide[bodyPart] = bodyPart.CanCollide
		bodyPart.Transparency = 1
		bodyPart.CanCollide = false
	end

	-- Tuck them inside the prop and pin them there.
	root.CFrame = CFrame.new(spot.Position)
	root.Anchored = true
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)

	hidden[player] = record
	occupants[spot] = occupants[spot] or {}
	table.insert(occupants[spot], player)

	player:SetAttribute(StateKeys.Player.Hidden, true)
	player:SetAttribute(StateKeys.Player.HidingKind, spot:GetAttribute("Kind") or "Spot")

	NoiseService.add(player, Config.Noise.Actions.EnterHidingSpot, "hide")
	Util.log("HidingService", "%s hid in %s", player.Name, spot.Name)
	return true
end

local function exit(player: Player, discovered: boolean?): boolean
	local record = hidden[player]
	if not record then
		return false
	end

	hidden[player] = nil
	lastExit[player] = Util.now()

	local list = occupants[record.Spot]
	if list then
		local index = table.find(list, player)
		if index then
			table.remove(list, index)
		end
	end

	local character, humanoid, root = Util.getCharacterParts(player)
	if character then
		for bodyPart, transparency in record.RestoreTransparency do
			if bodyPart.Parent then
				bodyPart.Transparency = transparency
			end
		end
		for bodyPart, canCollide in record.RestoreCollide do
			if bodyPart.Parent then
				bodyPart.CanCollide = canCollide
			end
		end
	end

	if root then
		root.Anchored = false
		-- Step out of the prop rather than out into a wall.
		local offset = record.Spot.CFrame.LookVector * 4
		root.CFrame = CFrame.new(record.Spot.Position + offset + Vector3.new(0, 1, 0))
	end

	if humanoid then
		humanoid.WalkSpeed = Config.Player.WalkSpeed
		humanoid.JumpPower = Config.Player.JumpPower
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
	end

	player:SetAttribute(StateKeys.Player.Hidden, false)
	player:SetAttribute(StateKeys.Player.HidingKind, "")

	if discovered then
		-- Being found is loud: you scramble out, and everything hears it.
		NoiseService.add(player, Config.Noise.Actions.OpenDoor * 2, "discovered")
		Net.fire(player, "Announce", {
			Kind = "Danger",
			Text = "You've been found!",
		})
	end

	return true
end

--- Public: yank a player out of hiding (a killer tore the door open).
function HidingService.forceOut(player: Player)
	exit(player, true)
end

--- Public: is anyone hiding in this spot right now?
function HidingService.searchSpot(spot: BasePart): Player?
	local list = occupants[spot]
	if not list or #list == 0 then
		return nil
	end
	local found = list[1]
	HidingService.forceOut(found)
	return found
end

--- Public: everyone out (round end, or a wipe).
function HidingService.releaseAll()
	for player in hidden do
		exit(player, false)
	end
end

--==========================================================================
-- Prompt wiring
--==========================================================================

local function attachPrompt(spot: Instance)
	if not spot:IsA("BasePart") or prompts[spot] then
		return
	end

	-- CollectionService returns tagged instances anywhere under `game`, which
	-- includes the map templates sitting in ServerStorage. Those must be left
	-- alone: prompting a template would do nothing useful, and the prompt would
	-- then be cloned into the live map alongside the one we add here.
	if not spot:IsDescendantOf(workspace) then
		return
	end

	-- A hand-built map may already carry a prompt from a previous session's
	-- template edit. Clear it so we never end up with two.
	local stale = spot:FindFirstChild("HidePrompt")
	if stale then
		stale:Destroy()
	end

	local kind = spot:GetAttribute("Kind") or "Spot"
	local verb = ({
		Locker = "Hide in Locker",
		Closet = "Hide in Closet",
		Bed = "Hide Under Bed",
		Table = "Hide Under Table",
		Duct = "Crawl into Duct",
		Bathtub = "Hide in Bathtub",
		Barrel = "Hide in Barrel",
	})[kind] or "Hide"

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "HidePrompt"
	prompt.ActionText = verb
	prompt.ObjectText = "Hiding Spot"
	prompt.HoldDuration = Config.Hiding.EnterDuration
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = spot

	prompt.Triggered:Connect(function(player)
		if hidden[player] then
			exit(player, false)
		else
			enter(player, spot)
		end
	end)

	occupants[spot] = occupants[spot] or {}
	prompts[spot] = prompt
end

local function detachPrompt(spot: Instance)
	if not spot:IsA("BasePart") then
		return
	end
	local prompt = prompts[spot]
	if prompt then
		prompt:Destroy()
		prompts[spot] = nil
	end
	for _, player in occupants[spot] or {} do
		exit(player, false)
	end
	occupants[spot] = nil
end

--==========================================================================
-- Lifecycle
--==========================================================================

function HidingService.start()
	for _, spot in CollectionService:GetTagged(Tags.HidingSpot) do
		attachPrompt(spot)
	end
	CollectionService:GetInstanceAddedSignal(Tags.HidingSpot):Connect(attachPrompt)
	CollectionService:GetInstanceRemovedSignal(Tags.HidingSpot):Connect(detachPrompt)

	-- Exiting via keypress, for players who'd rather not hunt for the prompt.
	Net.Events.RequestHide.OnServerEvent:Connect(function(player)
		if hidden[player] then
			exit(player, false)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local record = hidden[player]
		if record then
			local list = occupants[record.Spot]
			if list then
				local index = table.find(list, player)
				if index then
					table.remove(list, index)
				end
			end
		end
		hidden[player] = nil
		lastExit[player] = nil
	end)

	-- If a character is removed while hidden (respawn, elimination) the record
	-- would leak and the spot would look permanently occupied.
	Players.PlayerAdded:Connect(function(player)
		player.CharacterRemoving:Connect(function()
			if hidden[player] then
				exit(player, false)
			end
		end)
	end)
	for _, player in Players:GetPlayers() do
		player.CharacterRemoving:Connect(function()
			if hidden[player] then
				exit(player, false)
			end
		end)
	end
end

return HidingService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX24">
				<Properties>
					<string name="Name">KillerService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	KillerService.luau
	--------------------------------------------------------------------------
	Chooses which family members hunt this round, spawns them, and owns their
	agents for the round's lifetime.

	Rig source, same pattern as maps:
	  1. ServerStorage/Killers/<Name>  -- your real rig
	  2. RigBuilder placeholder
	--------------------------------------------------------------------------
]]

local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local KillerData = require(Shared.KillerData)
local StateKeys = require(Shared.StateKeys)
local Util = require(Shared.Util)

local KillerAgent = require(script.Parent.Parent.AI.KillerAgent)
local MapService = require(script.Parent.MapService)
local RigBuilder = require(script.Parent.Parent.Build.RigBuilder)

local KillerService = {}

local KILLERS_FOLDER_NAME = "ActiveKillers"

local agents: { [string]: KillerAgent.Agent } = {}
local rng = Random.new()

--==========================================================================
-- Internal
--==========================================================================

local function killersFolder(): Folder
	local folder = Workspace:FindFirstChild(KILLERS_FOLDER_NAME) :: Folder?
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = KILLERS_FOLDER_NAME
		folder.Parent = Workspace
	end
	return folder
end

local function buildRig(killerId: string): Model?
	local stored = ServerStorage:FindFirstChild("Killers")
	if stored then
		local template = stored:FindFirstChild(killerId)
		if template and template:IsA("Model") then
			Util.log("KillerService", "using hand-built rig for %s", killerId)
			return template:Clone()
		end
	end
	return RigBuilder.build(killerId, false)
end

--==========================================================================
-- Selection
--==========================================================================

--[[
	Picks this round's hunters.

	  70%  one killer
	  30%  two killers

	When two are drawn there's a chance the pair is one of the lore pairings
	(Bob and Barbara), because two people who tore each other apart hunting the
	same house together is more interesting than two names out of a hat.
]]
function KillerService.selectKillers(): { string }
	local roster = KillerData.getKillerRoster()
	if #roster == 0 then
		return {}
	end

	local count = rng:NextNumber() < Config.Killer.SpawnChanceTwo and 2 or 1
	count = math.min(count, Config.Killer.MaxActive, #roster)

	if count >= 2 and rng:NextNumber() < Config.Killer.LorePairChance then
		local pair = Util.pick(Config.Killer.LorePairs, rng)
		if pair then
			local valid = true
			for _, id in pair do
				if not KillerData.get(id) then
					valid = false
				end
			end
			if valid then
				return table.clone(pair)
			end
		end
	end

	return Util.pickMany(roster, count, rng)
end

--==========================================================================
-- Spawning
--==========================================================================

function KillerService.spawnKillers(killerIds: { string }): { string }
	KillerService.despawnAll()

	local spawns = MapService.getKillerSpawns()
	if #spawns == 0 then
		Util.warn("KillerService", "map has no killer spawns; falling back to player spawns")
		spawns = MapService.getPlayerSpawns()
	end
	if #spawns == 0 then
		Util.warn("KillerService", "no spawn points at all -- killers cannot be placed")
		return {}
	end

	local placements = MapService.allocateSpawns(spawns, #killerIds, rng)
	local spawned = {}

	for index, killerId in killerIds do
		local model = buildRig(killerId)
		if not model then
			Util.warn("KillerService", 'could not build a rig for "%s"', killerId)
			continue
		end

		model.Name = killerId
		model.Parent = killersFolder()

		local placement = placements[index] or placements[1]
		if placement then
			model:PivotTo(placement)
		end

		local agent = KillerAgent.new(killerId, model)
		if not agent then
			model:Destroy()
			continue
		end

		agents[killerId] = agent
		agent:start()
		table.insert(spawned, killerId)

		Util.log("KillerService", "spawned %s", killerId)
	end

	return spawned
end

function KillerService.despawnAll()
	for id, agent in agents do
		agent:stop()
		agents[id] = nil
	end
	local folder = Workspace:FindFirstChild(KILLERS_FOLDER_NAME)
	if folder then
		folder:Destroy()
	end
end

--==========================================================================
-- Queries
--==========================================================================

function KillerService.getAgents(): { [string]: KillerAgent.Agent }
	return agents
end

function KillerService.getAgentForModel(model: Instance): KillerAgent.Agent?
	for _, agent in agents do
		if agent.model == model then
			return agent
		end
	end
	return nil
end

--- The nearest killer to a position, with the distance. Used by the client
--- heartbeat and by Benny's warnings.
function KillerService.getNearest(position: Vector3): (KillerAgent.Agent?, number)
	local best: KillerAgent.Agent? = nil
	local bestDistance = math.huge
	for _, agent in agents do
		local distance = (agent:getPosition() - position).Magnitude
		if distance < bestDistance then
			best = agent
			bestDistance = distance
		end
	end
	return best, bestDistance
end

--- Display names of the active killers, for the round banner.
function KillerService.getActiveNames(): { string }
	local names = {}
	for id in agents do
		local profile = KillerData.get(id)
		table.insert(names, profile and profile.Name or id)
	end
	table.sort(names)
	return names
end

--- Freezes every killer (used the moment a round is decided, so nobody gets
--- downed during the results screen).
function KillerService.freezeAll()
	for _, agent in agents do
		agent.active = false
		agent.humanoid.WalkSpeed = 0
		agent.model:SetAttribute(StateKeys.Killer.AIState, "Idle")
	end
end

return KillerService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX25">
				<Properties>
					<string name="Name">MapService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	MapService.luau
	--------------------------------------------------------------------------
	Loads a map for the round and answers "where are the X's on this map?"

	Map source, in priority order:
	  1. ServerStorage/Maps/<MapId>  -- your real, hand-built map
	  2. MapBuilder greybox          -- the generated placeholder

	Every other service asks MapService for tagged instances rather than
	touching Workspace directly, so swapping in a real map changes nothing
	anywhere else.
	--------------------------------------------------------------------------
]]

local CollectionService = game:GetService("CollectionService")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Tags = require(Shared.Tags)
local Util = require(Shared.Util)

local MapBuilder = require(script.Parent.Parent.Build.MapBuilder)

local MapService = {}

local ACTIVE_FOLDER_NAME = "ActiveMap"
local LOBBY_FOLDER_NAME = "Lobby"

local activeMap: Model? = nil
local activeMapId: string? = nil
local lobby: Model? = nil

-- Tag lookups are cached per load. Rebuilt on every map change.
local cache: { [string]: { Instance } } = {}

--==========================================================================
-- Internal
--==========================================================================

local function activeFolder(): Folder
	local folder = Workspace:FindFirstChild(ACTIVE_FOLDER_NAME) :: Folder?
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = ACTIVE_FOLDER_NAME
		folder.Parent = Workspace
	end
	return folder
end

local function clearCache()
	table.clear(cache)
end

--- All instances with `tag` that are descendants of the active map.
local function collect(tag: string): { Instance }
	if cache[tag] then
		return cache[tag]
	end

	local out = {}
	local map = activeMap
	for _, instance in CollectionService:GetTagged(tag) do
		if map and instance:IsDescendantOf(map) then
			table.insert(out, instance)
		end
	end
	cache[tag] = out
	return out
end

--==========================================================================
-- Lobby
--==========================================================================

function MapService.buildLobby()
	if lobby and lobby.Parent then
		return
	end

	local built: Model
	local existing = ServerStorage:FindFirstChild(LOBBY_FOLDER_NAME)
	if existing and existing:IsA("Model") then
		built = existing:Clone()
		Util.log("MapService", "using hand-built lobby from ServerStorage")
	else
		built = MapBuilder.buildLobby()
		Util.log("MapService", "generated placeholder lobby")
	end

	built.Name = LOBBY_FOLDER_NAME
	built.Parent = Workspace
	lobby = built
end

function MapService.getLobby(): Model?
	return lobby
end

--- Spawn CFrames in the lobby, cycled if there are more players than pads.
function MapService.getLobbySpawns(): { CFrame }
	local out = {}
	local root = lobby
	for _, instance in CollectionService:GetTagged(Tags.LobbySpawn) do
		if root and instance:IsDescendantOf(root) and instance:IsA("BasePart") then
			table.insert(out, instance.CFrame + Vector3.new(0, 4, 0))
		end
	end
	if #out == 0 and lobby and lobby.PrimaryPart then
		table.insert(out, lobby.PrimaryPart.CFrame + Vector3.new(0, 6, 0))
	end
	return out
end

--==========================================================================
-- Map loading
--==========================================================================

function MapService.unload()
	local folder = Workspace:FindFirstChild(ACTIVE_FOLDER_NAME)
	if folder then
		folder:Destroy()
	end
	activeMap = nil
	activeMapId = nil
	clearCache()
end

--- Loads `mapId` into Workspace.ActiveMap. Returns the model, or nil on failure.
function MapService.load(mapId: string): Model?
	MapService.unload()

	local source: Model? = nil
	local mapsFolder = ServerStorage:FindFirstChild("Maps")
	if mapsFolder then
		local stored = mapsFolder:FindFirstChild(mapId)
		if stored and stored:IsA("Model") then
			source = stored:Clone()
			Util.log("MapService", "loaded hand-built map %s", mapId)
		end
	end

	if not source then
		source = MapBuilder.build(mapId)
		if source then
			Util.log("MapService", "generated greybox for %s", mapId)
		end
	end

	if not source then
		Util.warn("MapService", 'could not load map "%s"', mapId)
		return nil
	end

	source.Parent = activeFolder()
	activeMap = source
	activeMapId = mapId
	clearCache()

	MapService.validate()
	return source
end

function MapService.getActiveMap(): Model?
	return activeMap
end

function MapService.getActiveMapId(): string?
	return activeMapId
end

function MapService.getMapInfo(mapId: string)
	for _, map in Config.Maps do
		if map.Id == mapId then
			return map
		end
	end
	return nil
end

--==========================================================================
-- Tagged lookups
--==========================================================================

local function partsOnly(instances: { Instance }): { BasePart }
	local out = {}
	for _, instance in instances do
		if instance:IsA("BasePart") then
			table.insert(out, instance)
		end
	end
	return out
end

function MapService.getTagged(tag: string): { Instance }
	return collect(tag)
end

function MapService.getTaggedParts(tag: string): { BasePart }
	return partsOnly(collect(tag))
end

function MapService.getPlayerSpawns(): { BasePart }
	return MapService.getTaggedParts(Tags.PlayerSpawn)
end

function MapService.getKillerSpawns(): { BasePart }
	return MapService.getTaggedParts(Tags.KillerSpawn)
end

function MapService.getHelperSpawns(): { BasePart }
	return MapService.getTaggedParts(Tags.HelperSpawn)
end

function MapService.getHidingSpots(): { BasePart }
	return MapService.getTaggedParts(Tags.HidingSpot)
end

function MapService.getNoisyTiles(): { BasePart }
	return MapService.getTaggedParts(Tags.NoisyTile)
end

function MapService.getSafeZones(): { BasePart }
	return MapService.getTaggedParts(Tags.SafeZone)
end

--- Task spawn points, optionally filtered to a TaskType. Points marked "Any"
--- always match, so a builder can tag a generic spot and forget about it.
function MapService.getTaskSpawns(taskType: string?): { BasePart }
	local all = MapService.getTaggedParts(Tags.TaskSpawn)
	if not taskType then
		return all
	end
	local out = {}
	for _, spawnPoint in all do
		local declared = spawnPoint:GetAttribute("TaskType")
		if declared == nil or declared == "Any" or declared == taskType then
			table.insert(out, spawnPoint)
		end
	end
	return out
end

function MapService.getIngredientSpawn(ingredient: string): BasePart?
	for _, spawnPoint in MapService.getTaggedParts(Tags.IngredientSpawn) do
		if spawnPoint:GetAttribute("Ingredient") == ingredient then
			return spawnPoint
		end
	end
	return nil
end

function MapService.getFuseBoxes(): { BasePart }
	return MapService.getTaggedParts(Tags.FuseBox)
end

function MapService.getClock(): BasePart?
	return MapService.getTaggedParts(Tags.Clock)[1]
end

function MapService.getRitualTable(): BasePart?
	return MapService.getTaggedParts(Tags.RitualTable)[1]
end

function MapService.getLoreNotes(): { BasePart }
	return MapService.getTaggedParts(Tags.LoreNote)
end

--[[
	Patrol nodes for a killer, in the order they should be walked.

	Three tiers, best first:

	  1. A DESIGNED ROUTE -- nodes carrying `Killer = <id>`, sorted by their
	     `Order` attribute. This is what the House ships with: a hand-authored
	     loop per killer, so Barbara really does prowl the kitchen and Robert
	     really does haunt the study.
	  2. ZONE MATCH -- nodes whose `Zone` is one of the killer's preferred rooms
	     from KillerData. This is the fallback for a hand-built map that tagged
	     zones but not routes.
	  3. EVERYTHING -- so a map with bare untagged nodes still produces patrols
	     rather than killers standing still.

	Crawlspace nodes are filtered out unless the killer can use them.
]]
function MapService.getPatrolNodes(killerId: string?, zones: { string }?, canUseCrawlspaces: boolean?): { BasePart }
	local usable = {}
	for _, node in MapService.getTaggedParts(Tags.PatrolNode) do
		if CollectionService:HasTag(node, Tags.Crawlspace) and not canUseCrawlspaces then
			continue
		end
		table.insert(usable, node)
	end

	-- 1. The killer's own designed route.
	if killerId then
		local route = {}
		for _, node in usable do
			if node:GetAttribute("Killer") == killerId then
				table.insert(route, node)
			end
		end
		if #route >= 3 then
			table.sort(route, function(a, b)
				return ((a:GetAttribute("Order") :: number?) or 0) < ((b:GetAttribute("Order") :: number?) or 0)
			end)
			return route
		end
	end

	-- 2. Rooms this killer favours.
	if zones and #zones > 0 then
		local wanted: { [string]: boolean } = {}
		for _, zone in zones do
			wanted[zone] = true
		end

		local preferred = {}
		for _, node in usable do
			local zone = node:GetAttribute("Zone")
			if type(zone) == "string" and wanted[zone] then
				table.insert(preferred, node)
			end
		end

		-- A killer with two nodes can't meaningfully patrol; widen the net.
		if #preferred >= 3 then
			return preferred
		end
	end

	-- 3. Anything at all.
	return usable
end

--==========================================================================
-- Spawn placement
--==========================================================================

--- `count` spawn CFrames drawn from `spawns`, shuffled, cycling if needed.
function MapService.allocateSpawns(spawns: { BasePart }, count: number, rng: Random?): { CFrame }
	local out = {}
	if #spawns == 0 then
		return out
	end

	local pool = Util.shuffle(table.clone(spawns), rng)
	for index = 1, count do
		local spawnPart = pool[((index - 1) % #pool) + 1]
		-- Nudge repeats sideways so players don't spawn inside each other.
		local ring = math.floor((index - 1) / #pool)
		local offset = Vector3.zero
		if ring > 0 then
			local angle = (index / count) * math.pi * 2
			offset = Vector3.new(math.cos(angle) * 3 * ring, 0, math.sin(angle) * 3 * ring)
		end
		table.insert(out, CFrame.new(spawnPart.Position + offset + Vector3.new(0, 3.5, 0)))
	end
	return out
end

--==========================================================================
-- Validation
--==========================================================================

--[[
	Warns about anything the round needs but the map doesn't have. This is the
	single most useful thing when you swap in a hand-built map and something
	silently doesn't work -- the output window tells you which tag you forgot.
]]
function MapService.validate(): boolean
	local problems = {}

	local function require_(tag: string, minimum: number, what: string)
		local found = #collect(tag)
		if found < minimum then
			table.insert(problems, `{what}: found {found}, need at least {minimum} (tag "{tag}")`)
		end
	end

	require_(Tags.PlayerSpawn, 1, "Player spawns")
	require_(Tags.KillerSpawn, 1, "Killer spawns")
	require_(Tags.PatrolNode, 4, "Patrol nodes")
	require_(Tags.TaskSpawn, Config.Objectives.Potions.ActiveAtOnce, "Task spawn points")
	require_(Tags.HidingSpot, 3, "Hiding spots")

	if #problems > 0 then
		Util.warn("MapService", 'map "%s" is missing things:', activeMapId or "?")
		for _, problem in problems do
			warn(`   - {problem}`)
		end
		warn("   See docs/MAP_BUILDING.md for the tag reference.")
		return false
	end

	return true
end

return MapService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX26">
				<Properties>
					<string name="Name">NoiseService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	NoiseService.luau
	--------------------------------------------------------------------------
	The stealth loop's core. Every player carries a noise value from 0 to 100.

	This is deliberately SERVER-AUTHORITATIVE. The server samples each
	character's velocity itself rather than trusting a client-reported number,
	so an exploiter can't simply report "I am silent" while sprinting. Sprinting
	is a server-applied WalkSpeed change requested over a remote, which means
	the server always knows the difference between a walk and a run.

	The value replicates to clients as a Player attribute -- Roblox handles the
	replication for us, so the noise meter costs zero RemoteEvent traffic.
	--------------------------------------------------------------------------
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local StateKeys = require(Shared.StateKeys)
local Util = require(Shared.Util)

local TeamService = require(script.Parent.TeamService)

local NoiseService = {}

-- Internal high-resolution noise values. The Player attribute is a rounded,
-- rate-limited mirror of these.
local levels: { [Player]: number } = {}
local lastReplicated: { [Player]: number } = {}
local crouching: { [Player]: boolean } = {}

-- Sustained noise sources with a duration, e.g. brewing a potion.
type Sustained = { player: Player, perSecond: number, remaining: number }
local sustained: { Sustained } = {}

-- The most recent significant noise each player made, for killer memory.
export type NoiseEvent = {
	Player: Player,
	Position: Vector3,
	Level: number,
	Priority: number,
	At: number,
}

local running = false

--==========================================================================
-- Reads
--==========================================================================

function NoiseService.getLevel(player: Player): number
	return levels[player] or 0
end

function NoiseService.getTier(player: Player)
	return Config.getNoiseTier(NoiseService.getLevel(player))
end

--==========================================================================
-- Writes
--==========================================================================

--- Adds an instant noise spike. `reason` is for debugging only.
function NoiseService.add(player: Player, amount: number, reason: string?)
	if amount <= 0 then
		return
	end
	if not TeamService.isInRound(player) then
		return
	end
	levels[player] = math.clamp((levels[player] or 0) + amount, 0, Config.Noise.Max)
	if Config.Debug.ShowNoiseInOutput then
		print(`[Noise] {player.Name} +{amount} ({reason or "?"}) -> {math.floor(levels[player])}`)
	end
end

--- Adds noise spread over a duration (potion brewing, cranking a valve).
function NoiseService.addOverTime(player: Player, total: number, seconds: number, reason: string?)
	if total <= 0 or seconds <= 0 then
		NoiseService.add(player, total, reason)
		return
	end
	table.insert(sustained, {
		player = player,
		perSecond = total / seconds,
		remaining = seconds,
	})
end

--- Spikes everyone within `radius` of a world position. Used for map-wide
--- events like the grandfather clock chiming, which is not any one player's
--- fault but wakes the whole house.
function NoiseService.addAtPosition(position: Vector3, amount: number, radius: number, reason: string?)
	for _, player in TeamService.getParticipants() do
		local playerPos = Util.getPosition(player)
		if playerPos and (playerPos - position).Magnitude <= radius then
			NoiseService.add(player, amount, reason)
		end
	end
end

function NoiseService.setCrouching(player: Player, isCrouching: boolean)
	crouching[player] = isCrouching
end

function NoiseService.reset(player: Player)
	levels[player] = 0
	lastReplicated[player] = -1
	crouching[player] = false
	player:SetAttribute(StateKeys.Player.Noise, 0)
	player:SetAttribute(StateKeys.Player.NoiseTier, Config.Noise.Tiers[1].Name)
end

function NoiseService.resetAll()
	for _, player in Players:GetPlayers() do
		NoiseService.reset(player)
	end
	table.clear(sustained)
end

--==========================================================================
-- Killer-facing queries
--==========================================================================

--[[
	Returns the player a killer at `origin` should react to, or nil.

	A player is audible when their noise tier's range (scaled by the killer's
	hearing multiplier) reaches the killer. Louder tiers win; among equal tiers,
	the closer player wins. Players who are hidden, injured, in a safe zone, or
	out of the round are skipped.

	Returns: player, position, tier
]]
function NoiseService.findAudibleTarget(origin: Vector3, hearingMultiplier: number)
	local bestPlayer: Player? = nil
	local bestPosition: Vector3? = nil
	local bestTier = nil
	local bestPriority = -1
	local bestDistance = math.huge

	for _, player in TeamService.getAlive() do
		if player:GetAttribute(StateKeys.Player.Hidden) == true then
			continue
		end
		if player:GetAttribute(StateKeys.Player.InSafeZone) == true then
			continue
		end

		local position = Util.getPosition(player)
		if not position then
			continue
		end

		local level = levels[player] or 0
		local tier = Config.getNoiseTier(level)
		if tier.Response == "Ignore" then
			-- Still audible if the killer is practically standing on them.
			if (position - origin).Magnitude > tier.Range * hearingMultiplier then
				continue
			end
		end

		local range = tier.Range == math.huge and math.huge or tier.Range * hearingMultiplier
		local distance = (position - origin).Magnitude
		if distance > range then
			continue
		end

		if tier.Priority > bestPriority or (tier.Priority == bestPriority and distance < bestDistance) then
			bestPlayer = player
			bestPosition = position
			bestTier = tier
			bestPriority = tier.Priority
			bestDistance = distance
		end
	end

	return bestPlayer, bestPosition, bestTier
end

--==========================================================================
-- Update loop
--==========================================================================

local function replicate(player: Player)
	local level = levels[player] or 0
	local previous = lastReplicated[player]
	if previous and math.abs(level - previous) < Config.Noise.ReplicateEpsilon then
		return
	end
	lastReplicated[player] = level

	local rounded = math.floor(level * 10 + 0.5) / 10
	player:SetAttribute(StateKeys.Player.Noise, rounded)

	local tier = Config.getNoiseTier(level)
	if player:GetAttribute(StateKeys.Player.NoiseTier) ~= tier.Name then
		player:SetAttribute(StateKeys.Player.NoiseTier, tier.Name)
	end
end

local function step(dt: number)
	-- Sustained sources first.
	for index = #sustained, 1, -1 do
		local entry = sustained[index]
		if not entry.player.Parent then
			table.remove(sustained, index)
			continue
		end
		local slice = math.min(dt, entry.remaining)
		NoiseService.add(entry.player, entry.perSecond * slice, "sustained")
		entry.remaining -= slice
		if entry.remaining <= 0 then
			table.remove(sustained, index)
		end
	end

	for _, player in Players:GetPlayers() do
		local level = levels[player]
		if level == nil then
			levels[player] = 0
			level = 0
		end

		if not TeamService.isAlive(player) then
			-- Out of the round, downed, or in the lobby: bleed noise off fast so
			-- a revived player doesn't come back loud.
			if level > 0 then
				levels[player] = math.max(0, level - Config.Noise.DecayIdle * 3 * dt)
			end
			replicate(player)
			continue
		end

		local _, humanoid, root = Util.getCharacterParts(player)
		if not humanoid or not root then
			replicate(player)
			continue
		end

		local hidden = player:GetAttribute(StateKeys.Player.Hidden) == true
		local isCrouching = crouching[player] == true

		-- Horizontal speed only -- falling shouldn't read as running.
		local velocity = root.AssemblyLinearVelocity
		local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude

		local generated = 0
		if not hidden and speed > 1 then
			-- Anything above the walk baseline counts as a run. Using measured
			-- speed rather than the sprint flag means speed potions, conveyors
			-- and exploited WalkSpeed all correctly read as loud.
			local walkThreshold = Config.Player.WalkSpeed + 1
			if isCrouching then
				generated = Config.Noise.CrouchRate
			elseif speed > walkThreshold then
				-- Scale between walk and sprint rates by how fast they're going.
				local over = math.clamp(
					(speed - walkThreshold) / math.max(1, Config.Player.SprintSpeed - walkThreshold),
					0,
					2
				)
				generated = Util.lerp(Config.Noise.WalkRate, Config.Noise.SprintRate, math.min(over, 1))
					+ math.max(0, over - 1) * Config.Noise.SprintRate * 0.5
			else
				generated = Config.Noise.WalkRate * (speed / Config.Player.WalkSpeed)
			end
		end

		if generated > 0 then
			levels[player] = math.clamp(level + generated * dt, 0, Config.Noise.Max)
		else
			local decay = isCrouching and Config.Noise.DecayCrouched or Config.Noise.DecayIdle
			levels[player] = math.max(0, level - decay * dt)
		end

		replicate(player)
	end
end

--==========================================================================
-- Lifecycle
--==========================================================================

function NoiseService.start()
	if running then
		return
	end
	running = true

	Players.PlayerAdded:Connect(function(player)
		NoiseService.reset(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		levels[player] = nil
		lastReplicated[player] = nil
		crouching[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		NoiseService.reset(player)
	end

	-- Fixed-rate loop rather than per-frame: noise doesn't need 60 Hz, and
	-- 10 Hz keeps attribute replication sane with a full server.
	task.spawn(function()
		local interval = 1 / Config.Noise.TickRate
		local last = os.clock()
		while true do
			task.wait(interval)
			local now = os.clock()
			local dt = now - last
			last = now
			local ok, err = pcall(step, dt)
			if not ok then
				Util.warn("NoiseService", "step failed: %s", tostring(err))
			end
		end
	end)
end

return NoiseService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX27">
				<Properties>
					<string name="Name">ObjectiveService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	ObjectiveService.luau
	--------------------------------------------------------------------------
	Spawns the round's tasks, tracks shared progress, and tells everyone when
	something lands.

	Every objective is TEAM-BASED: one player picking up a potion moves the
	whole team's counter. Individual contribution is still tracked per player
	(for the end-of-round ranking), but it never gates the win.

	Progress replicates through Configuration instances under
	ReplicatedStorage.DollysHome.State.Objectives -- one child per active
	objective, with Current/Goal/Complete attributes. The HUD just reads those.
	--------------------------------------------------------------------------
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local ObjectiveData = require(Shared.ObjectiveData)
local StateKeys = require(Shared.StateKeys)
local Tags = require(Shared.Tags)
local Util = require(Shared.Util)

local MapService = require(script.Parent.MapService)
local NoiseService = require(script.Parent.NoiseService)
local TeamService = require(script.Parent.TeamService)

local ObjectiveService = {}

local ITEMS_FOLDER_NAME = "TaskItems"

type ObjectiveState = {
	Def: ObjectiveData.ObjectiveDef,
	Current: number,
	Goal: number,
	Complete: boolean,
	Config: Configuration,
	Extra: { [string]: any },
}

local active: { [string]: ObjectiveState } = {}
local order: { string } = {}
local usedSpawns: { [BasePart]: boolean } = {}
local spinners: { BasePart } = {}
local spinConnection: RBXScriptConnection? = nil
local roundActive = false
local rng = Random.new()

local onAllComplete: (() -> ())? = nil

local ITEM_STYLE = {
	Potion = { Color = Color3.fromRGB(120, 220, 180), Size = Vector3.new(1.4, 2.2, 1.4), Label = "Potion" },
	Mirror = { Color = Color3.fromRGB(190, 220, 235), Size = Vector3.new(1.8, 2.2, 0.3), Label = "Mirror Fragment" },
	Cross = { Color = Color3.fromRGB(230, 210, 150), Size = Vector3.new(1.2, 2.4, 0.4), Label = "Blessed Cross" },
	Ingredient = { Color = Color3.fromRGB(220, 120, 120), Size = Vector3.new(1.6, 1.8, 1.6), Label = "Ingredient" },
}

--==========================================================================
-- Replication helpers
--==========================================================================

local function itemsFolder(): Folder
	local folder = Workspace:FindFirstChild(ITEMS_FOLDER_NAME) :: Folder?
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = ITEMS_FOLDER_NAME
		folder.Parent = Workspace
	end
	return folder
end

local function publish(state: ObjectiveState)
	state.Config:SetAttribute(StateKeys.Objective.Current, state.Current)
	state.Config:SetAttribute(StateKeys.Objective.Goal, state.Goal)
	state.Config:SetAttribute(StateKeys.Objective.Complete, state.Complete)
end

local function setDetail(state: ObjectiveState, detail: string)
	state.Config:SetAttribute(StateKeys.Objective.Detail, detail)
end

--==========================================================================
-- Progress
--==========================================================================

local function checkAllComplete()
	if not roundActive then
		return
	end
	for _, state in active do
		if not state.Complete then
			return
		end
	end
	roundActive = false
	if onAllComplete then
		task.spawn(onAllComplete)
	end
end

local function creditPlayer(player: Player?)
	if not player then
		return
	end
	local current = (player:GetAttribute(StateKeys.Player.RoundTasks) or 0) :: number
	player:SetAttribute(StateKeys.Player.RoundTasks, current + 1)
end

--- Advances an objective and tells everyone about it.
local function advance(objectiveId: string, amount: number, player: Player?)
	local state = active[objectiveId]
	if not state or state.Complete then
		return
	end

	state.Current = math.min(state.Goal, state.Current + amount)
	creditPlayer(player)

	local justCompleted = state.Current >= state.Goal
	if justCompleted then
		state.Complete = true
	end
	publish(state)

	Net.fireAll("TaskProgress", {
		Id = objectiveId,
		Label = state.Def.ShortLabel,
		Current = state.Current,
		Goal = state.Goal,
		Complete = state.Complete,
		By = player and player.DisplayName or nil,
	})

	if justCompleted then
		Net.fireAll("TaskCompleted", {
			Id = objectiveId,
			Label = state.Def.Label,
			ShortLabel = state.Def.ShortLabel,
		})
		Util.log("ObjectiveService", "%s complete", objectiveId)
		checkAllComplete()
	end
end

ObjectiveService.advance = advance

--==========================================================================
-- Spawn point allocation
--==========================================================================

--- A task spawn point that isn't already holding something, preferring points
--- far from `avoid` so items don't cluster.
local function claimSpawn(taskType: string, avoid: Vector3?): BasePart?
	local candidates = {}
	for _, spawnPoint in MapService.getTaskSpawns(taskType) do
		if not usedSpawns[spawnPoint] then
			table.insert(candidates, spawnPoint)
		end
	end
	if #candidates == 0 then
		return nil
	end

	Util.shuffle(candidates, rng)

	if avoid then
		table.sort(candidates, function(a, b)
			return (a.Position - avoid).Magnitude > (b.Position - avoid).Magnitude
		end)
		-- Take from the far half, at random, so it's spread but not predictable.
		local cut = math.max(1, math.floor(#candidates / 2))
		local chosen = candidates[rng:NextInteger(1, cut)]
		usedSpawns[chosen] = true
		return chosen
	end

	local chosen = candidates[1]
	usedSpawns[chosen] = true
	return chosen
end

local function releaseSpawn(spawnPoint: BasePart?)
	if spawnPoint then
		usedSpawns[spawnPoint] = nil
	end
end

--==========================================================================
-- Collectible items
--==========================================================================

local function makeItem(kind: string, position: Vector3, actionText: string): BasePart
	local style = ITEM_STYLE[kind] or ITEM_STYLE.Potion

	local item = Instance.new("Part")
	item.Name = `TaskItem_{kind}`
	item.Size = style.Size
	item.Color = style.Color
	item.Material = Enum.Material.Neon
	item.Anchored = true
	item.CanCollide = false
	item.CFrame = CFrame.new(position)
	item.Parent = itemsFolder()
	CollectionService:AddTag(item, Tags.TaskItem)

	local light = Instance.new("PointLight")
	light.Color = style.Color
	light.Brightness = 1.4
	light.Range = 14
	light.Parent = item

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "CollectPrompt"
	prompt.ActionText = actionText
	prompt.ObjectText = style.Label
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = item

	table.insert(spinners, item)
	return item
end

local function destroyItem(item: BasePart)
	local index = table.find(spinners, item)
	if index then
		table.remove(spinners, index)
	end
	item:Destroy()
end

--==========================================================================
-- Kind: collect
--==========================================================================

local function spawnCollectible(state: ObjectiveState, avoid: Vector3?)
	local def = state.Def
	local taskType = def.SpawnTaskType or "Any"

	local spawnPoint = claimSpawn(taskType, avoid)
	if not spawnPoint then
		Util.warn(
			"ObjectiveService",
			"ran out of free task spawn points for %s -- tag more parts with %s",
			def.Id,
			Tags.TaskSpawn
		)
		return
	end

	local item = makeItem(taskType, spawnPoint.Position, def.HoldSeconds > 0 and "Collect" or "Take")
	local prompt = item:FindFirstChildOfClass("ProximityPrompt") :: ProximityPrompt
	prompt.HoldDuration = def.HoldSeconds

	state.Extra.Live[item] = spawnPoint

	prompt.Triggered:Connect(function(player)
		if not state.Extra.Live[item] or state.Complete then
			return
		end
		if not TeamService.isAlive(player) then
			return
		end

		state.Extra.Live[item] = nil
		releaseSpawn(spawnPoint)
		destroyItem(item)

		NoiseService.add(player, def.CompletionNoise or Config.Noise.Actions.CollectItem, def.Id)

		-- Crosses are heavy. Carrying more of them slows you down, which turns
		-- "grab everything" into an actual decision. PlayerService turns this
		-- attribute into an actual WalkSpeed -- see the note at the top of it.
		if def.Id == "Crosses" then
			local carried = ((player:GetAttribute(StateKeys.Player.CarriedCrosses) or 0) :: number) + 1
			player:SetAttribute(StateKeys.Player.CarriedCrosses, carried)
		end

		advance(def.Id, 1, player)

		-- Keep the field topped up if this objective respawns.
		local remaining = state.Goal - state.Current
		local liveCount = Util.count(state.Extra.Live)
		local delay = state.Extra.RespawnDelay or 0
		if not state.Complete and liveCount < state.Extra.ActiveAtOnce and remaining > liveCount then
			task.delay(delay, function()
				if state.Complete or not roundActive then
					return
				end
				spawnCollectible(state, Util.getPosition(player))
			end)
		end
	end)
end

local function setupCollect(state: ObjectiveState)
	local def = state.Def
	state.Extra.Live = {}

	if def.Id == "Potions" then
		state.Extra.ActiveAtOnce = Config.Objectives.Potions.ActiveAtOnce
		state.Extra.RespawnDelay = Config.Objectives.Potions.RespawnDelay
	else
		-- Everything else is laid out all at once.
		state.Extra.ActiveAtOnce = def.Goal
		state.Extra.RespawnDelay = 0
	end

	for _ = 1, math.min(state.Extra.ActiveAtOnce, def.Goal) do
		spawnCollectible(state, nil)
	end
end

--==========================================================================
-- Kind: ingredients
--==========================================================================

local function setupIngredients(state: ObjectiveState)
	local collected: { [string]: boolean } = {}
	state.Extra.Collected = collected
	state.Extra.Live = {}

	local names = {
		BloodSample = "Blood Sample",
		HolyWater = "Holy Water",
		Garlic = "Garlic",
		MagicDust = "Magic Dust",
	}

	local function refreshDetail()
		local have = {}
		for _, ingredient in Config.Objectives.Ingredients.Items do
			if collected[ingredient] then
				table.insert(have, names[ingredient] or ingredient)
			end
		end
		setDetail(state, #have > 0 and table.concat(have, ", ") or "Nothing gathered yet")
	end
	refreshDetail()

	for _, ingredient in Config.Objectives.Ingredients.Items do
		local pedestal = MapService.getIngredientSpawn(ingredient)
		local position: Vector3

		if pedestal then
			position = pedestal.Position + Vector3.new(0, 3, 0)
		else
			-- The map didn't tag a pedestal for this one; fall back to a generic
			-- task spawn so the objective is still completable.
			local fallback = claimSpawn("Any", nil)
			if not fallback then
				Util.warn("ObjectiveService", "nowhere to put ingredient %s", ingredient)
				continue
			end
			position = fallback.Position
		end

		local item = makeItem("Ingredient", position, "Take")
		local prompt = item:FindFirstChildOfClass("ProximityPrompt") :: ProximityPrompt
		prompt.HoldDuration = Config.Objectives.Ingredients.HoldSeconds
		prompt.ObjectText = names[ingredient] or ingredient

		prompt.Triggered:Connect(function(player)
			if collected[ingredient] or not TeamService.isAlive(player) then
				return
			end
			collected[ingredient] = true
			destroyItem(item)
			NoiseService.add(player, Config.Noise.Actions.CollectItem, "ingredient")
			creditPlayer(player)
			refreshDetail()

			local have = 0
			for _, needed in Config.Objectives.Ingredients.Items do
				if collected[needed] then
					have += 1
				end
			end

			-- The counter shows gathering progress, but the objective only
			-- completes at the ritual table.
			state.Current = math.min(state.Goal - 1, have)
			publish(state)

			Net.fireAll("TaskProgress", {
				Id = state.Def.Id,
				Label = state.Def.ShortLabel,
				Current = have,
				Goal = state.Goal,
				Complete = false,
				By = player.DisplayName,
			})

			if have >= #Config.Objectives.Ingredients.Items then
				Net.fireAll("Announce", {
					Kind = "Objective",
					Text = "Every ingredient is gathered. Take them to the ritual table.",
				})
			end
		end)
	end

	-- The ritual table.
	local ritual = MapService.getRitualTable()
	if not ritual then
		Util.warn("ObjectiveService", "no ritual table on this map; the sealing potion cannot be finished")
		return
	end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RitualPrompt"
	prompt.ActionText = "Brew"
	prompt.ObjectText = "Ritual Table"
	prompt.HoldDuration = Config.Objectives.Ingredients.RitualHoldSeconds
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Enabled = true
	prompt.Parent = ritual
	state.Extra.Prompt = prompt

	prompt.Triggered:Connect(function(player)
		if state.Complete or not TeamService.isAlive(player) then
			return
		end
		for _, ingredient in Config.Objectives.Ingredients.Items do
			if not collected[ingredient] then
				Net.fire(player, "Announce", {
					Kind = "Objective",
					Text = "The mixture is incomplete. Find the rest.",
				})
				return
			end
		end

		-- Brewing is loud, and it takes ten seconds to stop being loud.
		NoiseService.addOverTime(
			player,
			Config.Noise.Actions.BrewPotion,
			Config.Noise.BrewPotionSeconds,
			"brew"
		)
		state.Current = state.Goal - 1
		advance(state.Def.Id, 1, player)
		setDetail(state, "Sealed")
	end)
end

--==========================================================================
-- Kind: clock
--==========================================================================

local function setupClock(state: ObjectiveState)
	local clock = MapService.getClock()
	if not clock then
		Util.warn("ObjectiveService", "no grandfather clock on this map; auto-completing the objective")
		advance(state.Def.Id, state.Goal, nil)
		return
	end

	-- Randomised each round so nobody memorises the answer.
	local targetHour = rng:NextInteger(1, 12)
	local targetMinute = rng:NextInteger(0, 11) * 5
	state.Extra.TargetHour = targetHour
	state.Extra.TargetMinute = targetMinute

	local pretty = string.format("%d:%02d", targetHour, targetMinute)
	setDetail(state, `Set the hands to {pretty}`)
	clock:SetAttribute("TargetHour", targetHour)
	clock:SetAttribute("TargetMinute", targetMinute)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ClockPrompt"
	prompt.ActionText = "Set the Hands"
	prompt.ObjectText = "Grandfather Clock"
	prompt.HoldDuration = Config.Objectives.Clock.HoldSeconds
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = clock
	state.Extra.Prompt = prompt

	prompt.Triggered:Connect(function(player)
		if state.Complete or not TeamService.isAlive(player) then
			return
		end
		-- Hand the minigame to the client; it answers over SubmitClock.
		Net.fire(player, "Announce", {
			Kind = "ClockMinigame",
			TargetHour = targetHour,
			TargetMinute = targetMinute,
		})
	end)

	state.Extra.ClockPart = clock
end

--- Handles the client's answer to the clock minigame.
function ObjectiveService.submitClock(player: Player, hour: number, minute: number)
	local state = active.Clock
	if not state or state.Complete or not TeamService.isAlive(player) then
		return
	end

	local clock = state.Extra.ClockPart :: BasePart?
	if clock then
		local position = Util.getPosition(player)
		if not position or (position - clock.Position).Magnitude > 14 then
			return -- not actually standing at the clock
		end
	end

	if type(hour) ~= "number" or type(minute) ~= "number" then
		return
	end

	-- Compare on the 12-hour dial, so 12:00 and 0:00 are the same answer.
	local function toMinutes(h: number, m: number): number
		return ((math.floor(h) % 12) * 60 + math.floor(m)) % 720
	end
	local difference = math.abs(toMinutes(hour, minute) - toMinutes(state.Extra.TargetHour, state.Extra.TargetMinute))
	difference = math.min(difference, 720 - difference)

	if difference > Config.Objectives.Clock.ToleranceMinutes then
		Net.fire(player, "Announce", { Kind = "Objective", Text = "The hands are wrong. Try again." })
		return
	end

	-- The chime is the point. Everyone nearby just told the house where they are.
	if clock then
		NoiseService.addAtPosition(clock.Position, Config.Noise.Actions.AdjustClock, 70, "clock chime")
	end
	advance(state.Def.Id, state.Goal, player)
	setDetail(state, "The clock is chiming.")
end

--==========================================================================
-- Kind: fuses
--==========================================================================

local function setupFuses(state: ObjectiveState)
	local boxes = MapService.getFuseBoxes()
	if #boxes == 0 then
		Util.warn("ObjectiveService", "no fuse boxes on this map; auto-completing the objective")
		advance(state.Def.Id, state.Goal, nil)
		return
	end

	-- While this objective is running the safe zones start dark and light up
	-- one at a time.
	for _, zone in MapService.getSafeZones() do
		zone:SetAttribute("Active", false)
		zone.Transparency = 0.97
	end
	setDetail(state, "The barriers are dark")

	local zones = MapService.getSafeZones()

	for index, box in boxes do
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "FusePrompt"
		prompt.ActionText = "Restore Power"
		prompt.ObjectText = "Fuse Box"
		prompt.HoldDuration = Config.Objectives.SafeZone.HoldSeconds
		prompt.MaxActivationDistance = 9
		prompt.RequiresLineOfSight = false
		prompt.Parent = box

		prompt.Triggered:Connect(function(player)
			if state.Complete or not prompt.Enabled or not TeamService.isAlive(player) then
				return
			end
			prompt.Enabled = false

			NoiseService.add(player, Config.Noise.Actions.CollectItem * 2, "fusebox")

			local zone = zones[index]
			if zone then
				zone:SetAttribute("Active", true)
				zone.Transparency = 0.85
			end

			advance(state.Def.Id, 1, player)
			setDetail(state, `{state.Current}/{state.Goal} barriers lit`)
		end)
	end
end

--==========================================================================
-- Lore notes
--==========================================================================

local function setupLoreNotes()
	for _, note in MapService.getLoreNotes() do
		local noteId = note:GetAttribute("NoteId")
		if type(noteId) ~= "string" then
			continue
		end
		local entry = ObjectiveData.LoreNotes[noteId]
		if not entry then
			continue
		end

		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "ReadPrompt"
		prompt.ActionText = "Read"
		prompt.ObjectText = "Scrap of Paper"
		prompt.HoldDuration = 0.4
		prompt.MaxActivationDistance = 8
		prompt.RequiresLineOfSight = false
		prompt.Parent = note

		prompt.Triggered:Connect(function(player)
			Net.fire(player, "LoreNoteRead", {
				NoteId = noteId,
				Title = entry.Title,
				Author = entry.Author,
				Body = entry.Body,
			})
			local DataService = require(script.Parent.DataService)
			DataService.markLoreFound(player, noteId)
		end)
	end
end

--==========================================================================
-- Noisy tiles
--==========================================================================

local function setupNoisyTiles()
	-- One Touched connection per tile, debounced per player, is much cheaper
	-- than polling every player against every tile.
	local lastStep: { [Player]: number } = {}

	for _, tile in MapService.getNoisyTiles() do
		tile.CanTouch = true
		tile.Touched:Connect(function(hit)
			local player = Util.getPlayerFromDescendant(hit)
			if not player or not TeamService.isAlive(player) then
				return
			end
			local now = os.clock()
			if (lastStep[player] or 0) + 0.6 > now then
				return
			end
			lastStep[player] = now
			local amount = (tile:GetAttribute("Noise") :: number?) or Config.Noise.Actions.CreakyFloor
			NoiseService.add(player, amount, "creaky floor")
		end)
	end
end

--==========================================================================
-- Lifecycle
--==========================================================================

function ObjectiveService.setCompletionCallback(callback: (() -> ())?)
	onAllComplete = callback
end

--- Starts a round's objectives. Returns the chosen combo id.
function ObjectiveService.beginRound(): string
	ObjectiveService.endRound()

	local combo = ObjectiveData.pickCombo(rng)
	roundActive = true

	local folder = Net.getObjectivesFolder()
	folder:ClearAllChildren()

	for index, objectiveId in combo.Objectives do
		local def = ObjectiveData.get(objectiveId)
		if not def then
			Util.warn("ObjectiveService", 'combo references unknown objective "%s"', objectiveId)
			continue
		end

		local configuration = Instance.new("Configuration")
		configuration.Name = def.Id
		configuration:SetAttribute(StateKeys.Objective.Label, def.Label)
		configuration:SetAttribute(StateKeys.Objective.ShortLabel, def.ShortLabel)
		configuration:SetAttribute(StateKeys.Objective.Order, index)
		configuration:SetAttribute(StateKeys.Objective.Detail, "")
		configuration.Parent = folder

		local state: ObjectiveState = {
			Def = def,
			Current = 0,
			Goal = def.Goal,
			Complete = false,
			Config = configuration,
			Extra = {},
		}
		active[def.Id] = state
		table.insert(order, def.Id)
		publish(state)

		if def.Kind == "collect" then
			setupCollect(state)
		elseif def.Kind == "ingredients" then
			setupIngredients(state)
		elseif def.Kind == "clock" then
			setupClock(state)
		elseif def.Kind == "fuses" then
			setupFuses(state)
		else
			Util.warn("ObjectiveService", 'no handler for objective kind "%s"', def.Kind)
		end
	end

	-- Safe zones default to lit unless the fuse objective turned them off.
	if not active.SafeZones then
		for _, zone in MapService.getSafeZones() do
			zone:SetAttribute("Active", true)
		end
	end

	setupNoisyTiles()
	setupLoreNotes()

	-- One shared spin loop for every floating pickup.
	if not spinConnection then
		spinConnection = RunService.Heartbeat:Connect(function(dt)
			for _, item in spinners do
				if item.Parent then
					item.CFrame = item.CFrame * CFrame.Angles(0, dt * 1.6, 0)
				end
			end
		end)
	end

	Util.log("ObjectiveService", "round objectives: %s", table.concat(combo.Objectives, ", "))
	return combo.Id
end

function ObjectiveService.endRound()
	roundActive = false

	for _, state in active do
		if state.Extra.Prompt then
			(state.Extra.Prompt :: ProximityPrompt):Destroy()
		end
	end
	table.clear(active)
	table.clear(order)
	table.clear(usedSpawns)
	table.clear(spinners)

	if spinConnection then
		spinConnection:Disconnect()
		spinConnection = nil
	end

	local folder = Workspace:FindFirstChild(ITEMS_FOLDER_NAME)
	if folder then
		folder:Destroy()
	end

	Net.getObjectivesFolder():ClearAllChildren()
end

--==========================================================================
-- Queries
--==========================================================================

function ObjectiveService.isComplete(): boolean
	if next(active) == nil then
		return false
	end
	for _, state in active do
		if not state.Complete then
			return false
		end
	end
	return true
end

--- A one-line summary for the round-start banner.
function ObjectiveService.describe(): string
	local parts = {}
	for _, objectiveId in order do
		local state = active[objectiveId]
		if state then
			table.insert(parts, `{state.Def.ShortLabel} ({state.Goal})`)
		end
	end
	return table.concat(parts, "  -  ")
end

function ObjectiveService.getSnapshot()
	local out = {}
	for _, objectiveId in order do
		local state = active[objectiveId]
		if state then
			table.insert(out, {
				Id = state.Def.Id,
				Label = state.Def.Label,
				ShortLabel = state.Def.ShortLabel,
				Current = state.Current,
				Goal = state.Goal,
				Complete = state.Complete,
			})
		end
	end
	return out
end

function ObjectiveService.start()
	Net.Events.SubmitClock.OnServerEvent:Connect(function(player, hour, minute)
		ObjectiveService.submitClock(player, hour, minute)
	end)
end

return ObjectiveService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX28">
				<Properties>
					<string name="Name">PlayerService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	PlayerService.luau
	--------------------------------------------------------------------------
	The single authority on how fast a player moves.

	Sprinting, hiding, being downed, carrying a pile of iron crosses and
	drinking a speed potion all want to set WalkSpeed, and if each of them wrote
	it directly the last one to fire would win -- which is how you end up frozen
	in place after climbing out of a locker.

	Instead every one of those is an attribute, and this service recomputes the
	final speed from all of them a few times a second. Attributes are the truth;
	WalkSpeed is derived.
	--------------------------------------------------------------------------
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local StateKeys = require(Shared.StateKeys)
local Util = require(Shared.Util)

local NoiseService = require(script.Parent.NoiseService)
local TeamService = require(script.Parent.TeamService)

local PlayerService = {}

local sprintRequested: { [Player]: boolean } = {}
local lastSprintAt: { [Player]: number } = {}

--==========================================================================
-- Speed
--==========================================================================

--- Computes what this player's WalkSpeed should be right now.
local function resolveSpeed(player: Player): number
	if player:GetAttribute(StateKeys.Player.Hidden) == true then
		return 0
	end
	if player:GetAttribute(StateKeys.Player.Injured) == true then
		return Config.Revival.CrawlSpeed
	end

	local speed = Config.Player.WalkSpeed

	local stamina = (player:GetAttribute(StateKeys.Player.Stamina) or Config.Player.MaxStamina) :: number
	local wantsSprint = sprintRequested[player] == true
	local canSprint = not Config.Player.StaminaEnabled or stamina > 0

	if wantsSprint and canSprint and TeamService.isAlive(player) then
		speed = Config.Player.SprintSpeed
	end

	-- Crosses weigh you down: each one you're carrying compounds the penalty,
	-- up to six.
	local crosses = (player:GetAttribute(StateKeys.Player.CarriedCrosses) or 0) :: number
	if crosses > 0 then
		speed *= Config.Objectives.Crosses.CarrySlowdown ^ math.min(crosses, 6)
	end

	-- Speed potion.
	local boostUntil = (player:GetAttribute(StateKeys.Player.SpeedBoostUntil) or 0) :: number
	if boostUntil > Util.now() then
		speed *= Config.Shop.SpeedPotion.Multiplier
	end

	return math.max(6, speed)
end

--- Recomputes and applies a player's movement speed immediately.
function PlayerService.refreshSpeed(player: Player)
	local _, humanoid = Util.getCharacterParts(player)
	if not humanoid then
		return
	end

	local target = resolveSpeed(player)
	if math.abs(humanoid.WalkSpeed - target) > 0.05 then
		humanoid.WalkSpeed = target
	end

	local shouldJump = target > 0
		and player:GetAttribute(StateKeys.Player.Hidden) ~= true
		and player:GetAttribute(StateKeys.Player.Injured) ~= true
	local desiredJump = shouldJump and Config.Player.JumpPower or 0
	if humanoid.JumpPower ~= desiredJump then
		humanoid.JumpPower = desiredJump
	end
end

--==========================================================================
-- Stamina
--==========================================================================

local function stepStamina(player: Player, dt: number)
	if not Config.Player.StaminaEnabled then
		return
	end

	local stamina = (player:GetAttribute(StateKeys.Player.Stamina) or Config.Player.MaxStamina) :: number

	local _, humanoid, root = Util.getCharacterParts(player)
	local moving = false
	if root then
		local velocity = root.AssemblyLinearVelocity
		moving = Vector3.new(velocity.X, 0, velocity.Z).Magnitude > Config.Player.WalkSpeed + 1
	end

	local isSprinting = sprintRequested[player] == true and moving and stamina > 0 and TeamService.isAlive(player)

	if isSprinting then
		stamina -= Config.Player.StaminaDrainPerSecond * dt
		lastSprintAt[player] = Util.now()
	elseif Util.now() - (lastSprintAt[player] or 0) >= Config.Player.StaminaRegenDelay then
		stamina += Config.Player.StaminaRegenPerSecond * dt
	end

	stamina = math.clamp(stamina, 0, Config.Player.MaxStamina)
	player:SetAttribute(StateKeys.Player.Stamina, math.floor(stamina * 10 + 0.5) / 10)

	if stamina <= 0 and sprintRequested[player] then
		-- Out of breath. Drop the request so they have to press again once
		-- they've recovered, rather than stuttering at the threshold.
		sprintRequested[player] = false
		player:SetAttribute(StateKeys.Player.Sprinting, false)
	end
end

--==========================================================================
-- Consumables
--==========================================================================

function PlayerService.applySpeedPotion(player: Player, durationSeconds: number)
	player:SetAttribute(StateKeys.Player.SpeedBoostUntil, Util.now() + durationSeconds)
	PlayerService.refreshSpeed(player)
end

--- Clears round-scoped movement modifiers (crosses, hiding). The speed potion
--- is deliberately NOT cleared -- it's bought with coins and runs on real time.
function PlayerService.resetRoundModifiers(player: Player)
	player:SetAttribute(StateKeys.Player.CarriedCrosses, 0)
	sprintRequested[player] = false
	player:SetAttribute(StateKeys.Player.Sprinting, false)
	player:SetAttribute(StateKeys.Player.Stamina, Config.Player.MaxStamina)
	NoiseService.setCrouching(player, false)
	PlayerService.refreshSpeed(player)
end

--==========================================================================
-- Lifecycle
--==========================================================================

function PlayerService.start()
	Net.Events.SetSprinting.OnServerEvent:Connect(function(player, wantsSprint)
		sprintRequested[player] = wantsSprint == true
		player:SetAttribute(StateKeys.Player.Sprinting, sprintRequested[player])
		PlayerService.refreshSpeed(player)
	end)

	Net.Events.SetCrouching.OnServerEvent:Connect(function(player, wantsCrouch)
		-- Crouching only changes how much noise you make; NoiseService owns it.
		NoiseService.setCrouching(player, wantsCrouch == true)
	end)

	local function onPlayerAdded(player: Player)
		player:SetAttribute(StateKeys.Player.Stamina, Config.Player.MaxStamina)
		player:SetAttribute(StateKeys.Player.Sprinting, false)
		player:SetAttribute(StateKeys.Player.CarriedCrosses, 0)
		player:SetAttribute(StateKeys.Player.SpeedBoostUntil, 0)

		player.CharacterAdded:Connect(function()
			task.wait(0.2)
			PlayerService.refreshSpeed(player)
		end)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		sprintRequested[player] = nil
		lastSprintAt[player] = nil
	end)

	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.1)
			local now = os.clock()
			local dt = now - last
			last = now

			for _, player in Players:GetPlayers() do
				local ok, err = pcall(function()
					stepStamina(player, dt)
					PlayerService.refreshSpeed(player)
				end)
				if not ok then
					Util.warn("PlayerService", "update failed for %s: %s", player.Name, tostring(err))
				end
			end
		end
	end)
end

return PlayerService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX29">
				<Properties>
					<string name="Name">RevivalService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	RevivalService.luau
	--------------------------------------------------------------------------
	Nobody dies instantly in Dolly's Home. Reaching zero health puts you down
	with thirty seconds on the clock, and a teammate holding E for three seconds
	brings you back at half health. If nobody comes, you're out for the round.

	A downed player is a decision problem for the whole team: three people
	sprinting to a rescue is three noise meters climbing at once.

	Note that players never actually reach Humanoid.Health == 0 -- health is
	pinned at 1 while downed. Letting the Humanoid die would tear down the
	character model and Roblox would respawn them, which is not what "downed"
	means here.
	--------------------------------------------------------------------------
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local StateKeys = require(Shared.StateKeys)
local Util = require(Shared.Util)

local NoiseService = require(script.Parent.NoiseService)
local TeamService = require(script.Parent.TeamService)

local RevivalService = {}

type DownRecord = {
	Player: Player,
	DownedAt: number,
	ExpiresAt: number,
	Prompt: ProximityPrompt?,
	Highlight: Highlight?,
	Billboard: BillboardGui?,
	Thread: thread?,
	DownedBy: string?,
}

local downed: { [Player]: DownRecord } = {}
local immuneUntil: { [Player]: number } = {}
local reviving: { [Player]: Player } = {} -- target -> reviver

-- Round-scoped callback so GameStateManager can react to a wipe without
-- RevivalService having to know the round loop exists.
local onRosterChanged: (() -> ())? = nil

--==========================================================================
-- Queries
--==========================================================================

function RevivalService.isDowned(player: Player): boolean
	return downed[player] ~= nil
end

function RevivalService.getRemaining(player: Player): number
	local record = downed[player]
	if not record then
		return 0
	end
	return math.max(0, record.ExpiresAt - Util.now())
end

function RevivalService.setRosterChangedCallback(callback: (() -> ())?)
	onRosterChanged = callback
end

local function notifyRosterChanged()
	if onRosterChanged then
		task.spawn(onRosterChanged)
	end
end

--==========================================================================
-- Damage
--==========================================================================

--[[
	The single entry point for hurting a player. Everything -- killer swipes,
	traps, falls -- routes through here so the downed state can never be
	bypassed.
]]
function RevivalService.applyDamage(player: Player, amount: number, sourceName: string?)
	if amount <= 0 then
		return
	end
	if not TeamService.isAlive(player) then
		return
	end
	if (immuneUntil[player] or 0) > Util.now() then
		return
	end

	local _, humanoid = Util.getCharacterParts(player)
	if not humanoid then
		return
	end

	local remaining = humanoid.Health - amount
	if remaining > 1 then
		humanoid.Health = remaining
		Net.fire(player, "Announce", { Kind = "Hurt", Text = "", Amount = amount })
		return
	end

	humanoid.Health = 1
	RevivalService.down(player, sourceName)
end

function RevivalService.heal(player: Player, amount: number)
	local _, humanoid = Util.getCharacterParts(player)
	if not humanoid or downed[player] then
		return
	end
	humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + amount)
end

function RevivalService.fullHeal(player: Player)
	local _, humanoid = Util.getCharacterParts(player)
	if not humanoid then
		return
	end
	if downed[player] then
		RevivalService.revive(nil, player)
		return
	end
	humanoid.Health = humanoid.MaxHealth
end

--==========================================================================
-- Down
--==========================================================================

local function buildDownedUI(player: Player, record: DownRecord)
	local character, _, root = Util.getCharacterParts(player)
	if not character or not root then
		return
	end

	-- Visible through walls to teammates -- the design doc's "wounded symbol
	-- visible through walls".
	local highlight = Instance.new("Highlight")
	highlight.Name = "InjuredHighlight"
	highlight.FillColor = Color3.fromRGB(200, 40, 40)
	highlight.FillTransparency = 0.55
	highlight.OutlineColor = Color3.fromRGB(255, 110, 110)
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = character
	record.Highlight = highlight

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "InjuredBillboard"
	billboard.Size = UDim2.fromScale(9, 2.4)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 200
	billboard.Parent = character
	record.Billboard = billboard

	local label = Instance.new("TextLabel")
	label.Name = "Countdown"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = Color3.fromRGB(255, 120, 120)
	label.TextStrokeTransparency = 0.2
	label.TextScaled = true
	label.Text = "INJURED"
	label.Parent = billboard

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RevivePrompt"
	prompt.ActionText = "Revive"
	prompt.ObjectText = player.DisplayName
	prompt.HoldDuration = Config.Revival.ReviveHoldSeconds
	prompt.MaxActivationDistance = Config.Revival.ReviveRange
	prompt.RequiresLineOfSight = false
	prompt.Parent = root
	record.Prompt = prompt

	prompt.PromptButtonHoldBegan:Connect(function(reviver)
		if TeamService.isAlive(reviver) then
			reviving[player] = reviver
			-- Kneeling to revive is not quiet.
			NoiseService.addOverTime(reviver, Config.Noise.Actions.Revive, Config.Revival.ReviveHoldSeconds, "revive")
		end
	end)
	prompt.PromptButtonHoldEnded:Connect(function(reviver)
		if reviving[player] == reviver then
			reviving[player] = nil
		end
	end)
	prompt.Triggered:Connect(function(reviver)
		RevivalService.revive(reviver, player)
	end)

	-- Live countdown on the billboard.
	task.spawn(function()
		while downed[player] == record and billboard.Parent do
			local remaining = math.ceil(RevivalService.getRemaining(player))
			label.Text = `INJURED  -  {remaining}s`
			label.TextColor3 = remaining <= 10 and Color3.fromRGB(255, 70, 70) or Color3.fromRGB(255, 150, 120)
			task.wait(0.25)
		end
	end)
end

function RevivalService.down(player: Player, sourceName: string?)
	if downed[player] or not TeamService.isInRound(player) then
		return
	end

	local character, humanoid, root = Util.getCharacterParts(player)
	if not character or not humanoid or not root then
		return
	end

	-- Hiding doesn't survive being downed.
	local HidingService = require(script.Parent.HidingService)
	if HidingService.isHidden(player) then
		HidingService.forceOut(player)
	end

	humanoid.Health = 1
	humanoid.WalkSpeed = Config.Revival.CrawlSpeed
	humanoid.JumpPower = 0
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)

	local record: DownRecord = {
		Player = player,
		DownedAt = Util.now(),
		ExpiresAt = Util.now() + Config.Revival.BleedOutSeconds,
		DownedBy = sourceName,
	}
	downed[player] = record

	player:SetAttribute(StateKeys.Player.Injured, true)
	player:SetAttribute(StateKeys.Player.Alive, false)
	player:SetAttribute(StateKeys.Player.ReviveEndsAt, record.ExpiresAt)

	buildDownedUI(player, record)
	NoiseService.reset(player)

	Net.fireAll("InjuredAlert", {
		Kind = "Downed",
		UserId = player.UserId,
		Name = player.DisplayName,
		Position = root.Position,
		ExpiresAt = record.ExpiresAt,
		By = sourceName,
	})

	Util.log("RevivalService", "%s downed by %s", player.Name, sourceName or "?")
	notifyRosterChanged()

	-- Bleed-out timer.
	record.Thread = task.spawn(function()
		while downed[player] == record do
			if Util.now() >= record.ExpiresAt then
				RevivalService.eliminate(player)
				return
			end
			task.wait(0.25)
		end
	end)
end

--==========================================================================
-- Revive
--==========================================================================

local function teardownDownedUI(record: DownRecord)
	if record.Prompt then
		record.Prompt:Destroy()
	end
	if record.Highlight then
		record.Highlight:Destroy()
	end
	if record.Billboard then
		record.Billboard:Destroy()
	end
end

--- `reviver` may be nil for a self-revive (health potion).
function RevivalService.revive(reviver: Player?, target: Player): boolean
	local record = downed[target]
	if not record then
		return false
	end
	if reviver and not TeamService.isAlive(reviver) then
		return false
	end

	-- Verify the reviver is actually next to them. ProximityPrompt already
	-- enforces this, but a forged remote wouldn't.
	if reviver then
		local reviverPos = Util.getPosition(reviver)
		local targetPos = Util.getPosition(target)
		if not reviverPos or not targetPos then
			return false
		end
		if (reviverPos - targetPos).Magnitude > Config.Revival.ReviveRange + 4 then
			return false
		end
	end

	downed[target] = nil
	reviving[target] = nil
	teardownDownedUI(record)

	local _, humanoid = Util.getCharacterParts(target)
	if humanoid then
		humanoid.Health = math.max(1, humanoid.MaxHealth * Config.Revival.ReviveHealthPercent)
		humanoid.WalkSpeed = Config.Player.WalkSpeed
		humanoid.JumpPower = Config.Player.JumpPower
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
	end

	target:SetAttribute(StateKeys.Player.Injured, false)
	target:SetAttribute(StateKeys.Player.Alive, true)
	target:SetAttribute(StateKeys.Player.ReviveEndsAt, 0)

	local immunityEnd = Util.now() + Config.Revival.PostReviveImmunitySeconds
	immuneUntil[target] = immunityEnd
	if reviver then
		immuneUntil[reviver] = immunityEnd
		local count = (reviver:GetAttribute(StateKeys.Player.RoundRevives) or 0) :: number
		reviver:SetAttribute(StateKeys.Player.RoundRevives, count + 1)
	end

	Net.fireAll("InjuredAlert", {
		Kind = "Revived",
		UserId = target.UserId,
		Name = target.DisplayName,
		ReviverName = reviver and reviver.DisplayName or nil,
	})

	Util.log("RevivalService", "%s revived by %s", target.Name, reviver and reviver.Name or "self")
	notifyRosterChanged()
	return true
end

--==========================================================================
-- Eliminate
--==========================================================================

function RevivalService.eliminate(player: Player)
	local record = downed[player]
	if record then
		downed[player] = nil
		reviving[player] = nil
		teardownDownedUI(record)
	end

	if not TeamService.isInRound(player) then
		return
	end

	TeamService.exitRound(player, true)

	local _, humanoid = Util.getCharacterParts(player)
	if humanoid then
		humanoid.WalkSpeed = Config.Player.WalkSpeed
		humanoid.JumpPower = Config.Player.JumpPower
		humanoid.Health = humanoid.MaxHealth
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
	end

	NoiseService.reset(player)

	Net.fireAll("InjuredAlert", {
		Kind = "Eliminated",
		UserId = player.UserId,
		Name = player.DisplayName,
	})

	-- MapService is required lazily: RevivalService is loaded before the map
	-- exists, and a top-level require would fix the load order unnecessarily.
	local MapService = require(script.Parent.MapService)
	local spawns = MapService.getLobbySpawns()
	local destination = spawns[math.random(1, math.max(1, #spawns))]
	if destination then
		local character = player.Character
		if character and character.PrimaryPart then
			character:PivotTo(destination)
		end
	end

	Util.log("RevivalService", "%s eliminated", player.Name)
	notifyRosterChanged()
end

--- Clears every downed state without eliminating anyone (round ended).
function RevivalService.clearAll()
	for player, record in downed do
		teardownDownedUI(record)
		downed[player] = nil
		player:SetAttribute(StateKeys.Player.Injured, false)
		player:SetAttribute(StateKeys.Player.ReviveEndsAt, 0)

		local _, humanoid = Util.getCharacterParts(player)
		if humanoid then
			humanoid.WalkSpeed = Config.Player.WalkSpeed
			humanoid.JumpPower = Config.Player.JumpPower
			humanoid.Health = humanoid.MaxHealth
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		end
	end
	table.clear(reviving)
	table.clear(immuneUntil)
end

--==========================================================================
-- Lifecycle
--==========================================================================

function RevivalService.start()
	local function watchCharacter(player: Player, character: Model)
		local humanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
		if not humanoid then
			return
		end

		humanoid.MaxHealth = Config.Player.MaxHealth
		humanoid.Health = Config.Player.MaxHealth
		humanoid.WalkSpeed = Config.Player.WalkSpeed
		humanoid.JumpPower = Config.Player.JumpPower
		humanoid.UseJumpPower = true
		humanoid.BreakJointsOnDeath = false

		-- Safety net: anything that drains health without going through
		-- applyDamage (falling, a stray script) still results in a down rather
		-- than a death.
		humanoid.HealthChanged:Connect(function(health)
			if health <= 0.5 and TeamService.isAlive(player) and not downed[player] then
				humanoid.Health = 1
				RevivalService.down(player, "the house")
			end
		end)

		humanoid.Died:Connect(function()
			if TeamService.isInRound(player) then
				RevivalService.eliminate(player)
			end
		end)
	end

	local function onPlayer(player: Player)
		if player.Character then
			task.spawn(watchCharacter, player, player.Character)
		end
		player.CharacterAdded:Connect(function(character)
			task.spawn(watchCharacter, player, character)
		end)
	end

	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		local record = downed[player]
		if record then
			teardownDownedUI(record)
			downed[player] = nil
		end
		immuneUntil[player] = nil
		reviving[player] = nil
		notifyRosterChanged()
	end)
end

return RevivalService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX30">
				<Properties>
					<string name="Name">SafeZoneService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	SafeZoneService.luau
	--------------------------------------------------------------------------
	Tracks which players are standing inside an active safe zone and sets the
	InSafeZone attribute accordingly.

	Two things read that attribute: KillerAgent (which refuses to target or
	attack anyone inside one) and the HUD (which shows the player they're safe).
	Keeping the check in one place means the permanent map safe zones and
	Robby's temporary ones behave identically without either system knowing
	about the other.
	--------------------------------------------------------------------------
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local StateKeys = require(Shared.StateKeys)
local Tags = require(Shared.Tags)
local Util = require(Shared.Util)

local SafeZoneService = {}

local ZONE_TAGS = { Tags.SafeZone, Tags.TempSafeZone }

--- Radius of a zone part -- explicit attribute if set, otherwise inferred.
local function radiusOf(zone: BasePart): number
	local explicit = zone:GetAttribute("Radius") :: number?
	if explicit then
		return explicit
	end
	return math.max(zone.Size.X, zone.Size.Z) / 2
end

--- Returns the zone containing this position, or nil.
function SafeZoneService.zoneAt(position: Vector3): BasePart?
	for _, tag in ZONE_TAGS do
		for _, zone in CollectionService:GetTagged(tag) do
			if not zone:IsA("BasePart") or not zone.Parent then
				continue
			end
			-- Skip zones inside ServerStorage map templates; only the live map
			-- counts. (CollectionService returns everything under `game`.)
			if not zone:IsDescendantOf(workspace) then
				continue
			end
			if zone:GetAttribute("Active") == false then
				continue
			end
			-- Compare in the zone's own space so rotated / rectangular zones
			-- behave sensibly rather than always being treated as circles.
			local localPoint = zone.CFrame:PointToObjectSpace(position)
			local half = zone.Size / 2
			if
				math.abs(localPoint.X) <= half.X
				and math.abs(localPoint.Z) <= half.Z
				and math.abs(localPoint.Y) <= math.max(half.Y, 8)
			then
				return zone
			end
		end
	end
	return nil
end

--- Creates a temporary safe zone (Robby's doing). Returns the part.
function SafeZoneService.createTemporary(position: Vector3, radius: number, duration: number): BasePart
	local zone = Instance.new("Part")
	zone.Name = "TemporarySafeZone"
	zone.Shape = Enum.PartType.Cylinder
	zone.Size = Vector3.new(14, radius * 2, radius * 2)
	zone.CFrame = CFrame.new(position + Vector3.new(0, 5, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	zone.Anchored = true
	zone.CanCollide = false
	zone.CanQuery = false
	zone.Material = Enum.Material.Neon
	zone.Color = Color3.fromRGB(140, 190, 255)
	zone.Transparency = 0.82
	zone:SetAttribute("Active", true)
	zone:SetAttribute("Radius", radius)
	zone.Parent = workspace
	CollectionService:AddTag(zone, Tags.TempSafeZone)

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(150, 200, 255)
	light.Brightness = 2.5
	light.Range = radius * 2
	light.Parent = zone

	task.delay(duration, function()
		if zone.Parent then
			-- Fade out so it doesn't just vanish out from under someone.
			for step = 1, 10 do
				zone.Transparency = 0.82 + (step / 10) * 0.18
				light.Brightness = 2.5 * (1 - step / 10)
				task.wait(0.05)
			end
			zone:Destroy()
		end
	end)

	return zone
end

function SafeZoneService.clearTemporary()
	for _, zone in CollectionService:GetTagged(Tags.TempSafeZone) do
		zone:Destroy()
	end
end

function SafeZoneService.start()
	task.spawn(function()
		while true do
			task.wait(0.2)
			for _, player in Players:GetPlayers() do
				local position = Util.getPosition(player)
				local inZone = position ~= nil and SafeZoneService.zoneAt(position) ~= nil
				if player:GetAttribute(StateKeys.Player.InSafeZone) ~= inZone then
					player:SetAttribute(StateKeys.Player.InSafeZone, inZone)
				end
			end
		end
	end)
end

return SafeZoneService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX31">
				<Properties>
					<string name="Name">ShopService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	ShopService.luau
	--------------------------------------------------------------------------
	Stakes (permanent unlocks) and potions (consumables), bought with coins in
	the lobby.

	The design doc flags the shop as "later", so this is deliberately minimal:
	server-validated purchases, an inventory that persists, and a catalogue the
	client renders. It is not a storefront with rotating stock and bundles --
	when you want that, the catalogue below is the only thing that has to grow.
	--------------------------------------------------------------------------
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local StateKeys = require(Shared.StateKeys)
local Util = require(Shared.Util)

local DataService = require(script.Parent.DataService)
local MapService = require(script.Parent.MapService)
local PlayerService = require(script.Parent.PlayerService)
local RevivalService = require(script.Parent.RevivalService)
local TeamService = require(script.Parent.TeamService)

local ShopService = {}

--==========================================================================
-- Catalogue
--==========================================================================

--- Everything buyable, built from Config so prices live in one place.
function ShopService.getCatalogue()
	local stakes = {}
	for _, tier in Config.Stakes.Tiers do
		table.insert(stakes, {
			Id = tier.Id,
			Kind = "Stake",
			Name = tier.Name,
			Rarity = tier.Id,
			Cost = tier.Cost,
			Damage = tier.Damage,
			StunSeconds = tier.StunSeconds,
			Colour = tier.Color,
			Order = tier.Order,
			Description = `{tier.Damage} damage, stuns for {tier.StunSeconds} seconds.`,
		})
	end
	table.sort(stakes, function(a, b)
		return a.Order < b.Order
	end)

	local consumables = {
		{
			Id = Config.Shop.SpeedPotion.Id,
			Kind = "Consumable",
			Name = Config.Shop.SpeedPotion.Name,
			Cost = Config.Shop.SpeedPotion.Cost,
			Description = Config.Shop.SpeedPotion.Description,
			Colour = Color3.fromRGB(110, 180, 255),
		},
		{
			Id = Config.Shop.HealthPotion.Id,
			Kind = "Consumable",
			Name = Config.Shop.HealthPotion.Name,
			Cost = Config.Shop.HealthPotion.Cost,
			Description = Config.Shop.HealthPotion.Description,
			Colour = Color3.fromRGB(120, 230, 150),
		},
	}

	return { Stakes = stakes, Consumables = consumables }
end

--==========================================================================
-- Purchasing
--==========================================================================

local function findStake(id: string)
	return Config.getStakeTier(id)
end

local function findConsumable(id: string)
	if id == Config.Shop.SpeedPotion.Id then
		return Config.Shop.SpeedPotion
	elseif id == Config.Shop.HealthPotion.Id then
		return Config.Shop.HealthPotion
	end
	return nil
end

--- Returns (success, message).
function ShopService.purchase(player: Player, itemId: string): (boolean, string)
	if type(itemId) ~= "string" then
		return false, "Unknown item."
	end

	local profile = DataService.peek(player)
	if not profile then
		return false, "Your data is still loading."
	end

	local stake = findStake(itemId)
	if stake then
		if profile.OwnedStakes[itemId] then
			return false, "You already own that."
		end
		if not DataService.trySpend(player, stake.Cost) then
			return false, `Not enough coins ({stake.Cost} needed).`
		end
		DataService.grantStake(player, itemId)
		DataService.setEquippedStake(player, itemId)
		player:SetAttribute(StateKeys.Player.EquippedStake, itemId)
		return true, `{stake.Name} unlocked and equipped.`
	end

	local consumable = findConsumable(itemId)
	if consumable then
		if not DataService.trySpend(player, consumable.Cost) then
			return false, `Not enough coins ({consumable.Cost} needed).`
		end
		DataService.addItem(player, itemId, 1)
		return true, `{consumable.Name} added to your satchel.`
	end

	return false, "Unknown item."
end

--==========================================================================
-- Using consumables
--==========================================================================

function ShopService.useConsumable(player: Player, itemId: string): (boolean, string)
	local consumable = findConsumable(itemId)
	if not consumable then
		return false, "You can't use that."
	end

	if itemId == Config.Shop.HealthPotion.Id then
		if not TeamService.isInRound(player) then
			return false, "Only during a round."
		end
		local _, humanoid = Util.getCharacterParts(player)
		local isDowned = RevivalService.isDowned(player)
		if humanoid and humanoid.Health >= humanoid.MaxHealth and not isDowned then
			return false, "You're already at full health."
		end
		if not DataService.consumeItem(player, itemId) then
			return false, "You don't have one."
		end
		RevivalService.fullHeal(player)
		return true, "Restored to full health."
	end

	if itemId == Config.Shop.SpeedPotion.Id then
		if not DataService.consumeItem(player, itemId) then
			return false, "You don't have one."
		end
		PlayerService.applySpeedPotion(player, Config.Shop.SpeedPotion.DurationSeconds)
		return true, `Double speed for {math.floor(Config.Shop.SpeedPotion.DurationSeconds / 60)} minutes.`
	end

	return false, "You can't use that."
end

--==========================================================================
-- Lobby stand
--==========================================================================

local function attachStandPrompt()
	local lobby = MapService.getLobby()
	if not lobby then
		return
	end

	for _, descendant in lobby:GetDescendants() do
		if descendant:IsA("BasePart") and descendant:GetAttribute("DollysHomeShop") then
			if descendant:FindFirstChildOfClass("ProximityPrompt") then
				continue
			end
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "ShopPrompt"
			prompt.ActionText = "Browse"
			prompt.ObjectText = "Peddler's Cart"
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = 12
			prompt.RequiresLineOfSight = false
			prompt.Parent = descendant

			prompt.Triggered:Connect(function(player)
				Net.fire(player, "Announce", { Kind = "OpenShop" })
			end)
		end
	end
end

--==========================================================================
-- Lifecycle
--==========================================================================

function ShopService.start()
	Net.Functions.GetProfile.OnServerInvoke = function(player)
		return {
			Profile = DataService.toClientPayload(player),
			Catalogue = ShopService.getCatalogue(),
		}
	end

	Net.Events.Purchase.OnServerEvent:Connect(function(player, itemId)
		local ok, message = ShopService.purchase(player, itemId)
		Net.fire(player, "Announce", {
			Kind = ok and "ShopSuccess" or "ShopError",
			Text = message,
			Profile = DataService.toClientPayload(player),
		})
	end)

	Net.Events.UseConsumable.OnServerEvent:Connect(function(player, itemId)
		if type(itemId) ~= "string" then
			return
		end
		local ok, message = ShopService.useConsumable(player, itemId)
		Net.fire(player, "Announce", {
			Kind = ok and "ShopSuccess" or "ShopError",
			Text = message,
			Profile = DataService.toClientPayload(player),
		})
	end)

	Players.PlayerAdded:Connect(function(player)
		task.spawn(function()
			DataService.getProfile(player, 15)
			local profile = DataService.peek(player)
			if profile then
				player:SetAttribute(StateKeys.Player.EquippedStake, profile.EquippedStake)
			end
		end)
	end)

	task.defer(attachStandPrompt)
end

return ShopService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX32">
				<Properties>
					<string name="Name">StatsService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	StatsService.luau
	--------------------------------------------------------------------------
	End-of-round scoring: who did what, what it's worth, and the ranked list the
	results screen renders.

	Ranking is tasks + revives, deliberately weighting revives higher, because
	sprinting across a dark house to pick a teammate up is a bigger ask than
	grabbing a bottle off a shelf.
	--------------------------------------------------------------------------
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local StateKeys = require(Shared.StateKeys)
local Util = require(Shared.Util)

local DataService = require(script.Parent.DataService)

local StatsService = {}

local REVIVE_RANK_WEIGHT = 2

export type PlayerResult = {
	UserId: number,
	Name: string,
	DisplayName: string,
	Tasks: number,
	Revives: number,
	Survived: boolean,
	Eliminated: boolean,
	Coins: number,
	Wins: number,
	Rank: number,
	IsTopPerformer: boolean,
}

-- Everyone who was in the round when it started, so a player who was
-- eliminated (and is therefore off the Survivors team by now) still appears on
-- the scoreboard and still gets paid.
local roster: { [Player]: boolean } = {}

--==========================================================================
-- Roster
--==========================================================================

function StatsService.beginRound(participants: { Player })
	table.clear(roster)
	for _, player in participants do
		roster[player] = true
		player:SetAttribute(StateKeys.Player.RoundTasks, 0)
		player:SetAttribute(StateKeys.Player.RoundRevives, 0)
	end
end

function StatsService.addParticipant(player: Player)
	roster[player] = true
end

--==========================================================================
-- Scoring
--==========================================================================

local function scoreOf(tasks: number, revives: number): number
	return tasks + revives * REVIVE_RANK_WEIGHT
end

--[[
	Tallies the round, pays everyone, and returns the payload for the results
	screen.

	Payouts follow the design doc's award table:
	  participation  +25   (everyone who was in the round, dead or alive)
	  victory        +50   (survivors only)
	  per task       +10
	  per revive     +20
	  top performer  +50
]]
function StatsService.endRound(victory: boolean): { PlayerResult }
	local results: { PlayerResult } = {}

	for player in roster do
		if not player.Parent then
			continue
		end

		local tasks = (player:GetAttribute(StateKeys.Player.RoundTasks) or 0) :: number
		local revives = (player:GetAttribute(StateKeys.Player.RoundRevives) or 0) :: number
		local eliminated = player:GetAttribute(StateKeys.Player.Eliminated) == true
		local survived = not eliminated

		table.insert(results, {
			UserId = player.UserId,
			Name = player.Name,
			DisplayName = player.DisplayName,
			Tasks = tasks,
			Revives = revives,
			Survived = survived,
			Eliminated = eliminated,
			Coins = 0,
			Wins = 0,
			Rank = 0,
			IsTopPerformer = false,
		})
	end

	table.sort(results, function(a, b)
		local scoreA, scoreB = scoreOf(a.Tasks, a.Revives), scoreOf(b.Tasks, b.Revives)
		if scoreA ~= scoreB then
			return scoreA > scoreB
		end
		if a.Survived ~= b.Survived then
			return a.Survived
		end
		return a.DisplayName < b.DisplayName
	end)

	-- Nobody who did nothing gets a "top performer" bonus, even if they came
	-- first in an empty field.
	local topScore = #results > 0 and scoreOf(results[1].Tasks, results[1].Revives) or 0

	local byUserId: { [number]: Player } = {}
	for player in roster do
		byUserId[player.UserId] = player
	end

	for index, result in results do
		result.Rank = index

		local coins = Config.Economy.ParticipationCoins
		coins += result.Tasks * Config.Economy.CoinsPerTask
		coins += result.Revives * Config.Economy.CoinsPerRevive

		if victory and result.Survived then
			coins += Config.Economy.WinCoins
		end

		if index == 1 and topScore > 0 then
			coins += Config.Economy.TopRankBonus
			result.IsTopPerformer = true
		end

		result.Coins = coins

		local player = byUserId[result.UserId]
		if player then
			DataService.addCoins(player, coins)
			DataService.recordRound(player, result.Tasks, result.Revives)
			if victory and result.Survived then
				DataService.addWin(player)
			end
			local profile = DataService.peek(player)
			result.Wins = profile and profile.Wins or 0
		end
	end

	Util.log("StatsService", "round scored: %d players, victory=%s", #results, tostring(victory))
	return results
end

function StatsService.clear()
	table.clear(roster)
	for _, player in Players:GetPlayers() do
		player:SetAttribute(StateKeys.Player.RoundTasks, 0)
		player:SetAttribute(StateKeys.Player.RoundRevives, 0)
	end
end

function StatsService.start()
	Players.PlayerRemoving:Connect(function(player)
		roster[player] = nil
	end)
end

return StatsService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX33">
				<Properties>
					<string name="Name">TeamService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	TeamService.luau
	--------------------------------------------------------------------------
	Two teams: Survivors (in the round, on their feet) and Lost (lobby,
	spectating, eliminated). Killers are NPCs, not players, so they need no team.

	The team a player is on is the single source of truth for "are they in the
	round". Player attributes (Alive/Injured/Eliminated) describe *how* they are
	in it.
	--------------------------------------------------------------------------
]]

local Players = game:GetService("Players")
local Teams = game:GetService("Teams")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local StateKeys = require(Shared.StateKeys)
local Util = require(Shared.Util)

local TeamService = {}

local survivors: Team
local lost: Team

local SURVIVOR_COLOR = BrickColor.new("Bright green")
local LOST_COLOR = BrickColor.new("Really black")

--==========================================================================
-- Setup
--==========================================================================

local function ensureTeam(name: string, color: BrickColor, autoAssign: boolean): Team
	local team = Teams:FindFirstChild(name) :: Team?
	if not team then
		team = Instance.new("Team")
		team.Name = name
		team.Parent = Teams
	end
	team.TeamColor = color
	team.AutoAssignable = autoAssign
	return team
end

--==========================================================================
-- Queries
--==========================================================================

function TeamService.getSurvivorTeam(): Team
	return survivors
end

function TeamService.getLostTeam(): Team
	return lost
end

--- Is this player in the current round at all (alive or injured)?
function TeamService.isInRound(player: Player): boolean
	return player.Team == survivors and player:GetAttribute(StateKeys.Player.Eliminated) ~= true
end

--- On their feet and playable.
function TeamService.isAlive(player: Player): boolean
	return TeamService.isInRound(player) and player:GetAttribute(StateKeys.Player.Injured) ~= true
end

function TeamService.isInjured(player: Player): boolean
	return TeamService.isInRound(player) and player:GetAttribute(StateKeys.Player.Injured) == true
end

--- Everyone still in the round, standing or downed.
function TeamService.getParticipants(): { Player }
	local out = {}
	for _, player in Players:GetPlayers() do
		if TeamService.isInRound(player) then
			table.insert(out, player)
		end
	end
	return out
end

--- Everyone on their feet.
function TeamService.getAlive(): { Player }
	local out = {}
	for _, player in Players:GetPlayers() do
		if TeamService.isAlive(player) then
			table.insert(out, player)
		end
	end
	return out
end

function TeamService.getInjured(): { Player }
	local out = {}
	for _, player in Players:GetPlayers() do
		if TeamService.isInjured(player) then
			table.insert(out, player)
		end
	end
	return out
end

function TeamService.countAlive(): number
	return #TeamService.getAlive()
end

--- True once nobody is left standing *and* nobody is still bleeding out.
function TeamService.isWipe(): boolean
	return #TeamService.getParticipants() == 0
end

--==========================================================================
-- Assignment
--==========================================================================

--- Puts a player into the round with a clean slate.
function TeamService.enterRound(player: Player)
	player.Team = survivors
	player.Neutral = false
	player:SetAttribute(StateKeys.Player.Alive, true)
	player:SetAttribute(StateKeys.Player.Injured, false)
	player:SetAttribute(StateKeys.Player.Eliminated, false)
	player:SetAttribute(StateKeys.Player.Spectating, false)
	player:SetAttribute(StateKeys.Player.ReviveEndsAt, 0)
	player:SetAttribute(StateKeys.Player.RoundTasks, 0)
	player:SetAttribute(StateKeys.Player.RoundRevives, 0)
	player:SetAttribute(StateKeys.Player.CarriedCrosses, 0)
	player:SetAttribute(StateKeys.Player.Noise, 0)
	player:SetAttribute(StateKeys.Player.Hidden, false)
	player:SetAttribute(StateKeys.Player.InSafeZone, false)
	Util.log("TeamService", "%s entered the round", player.Name)
end

--- Removes a player from the round (eliminated, or the round just ended).
function TeamService.exitRound(player: Player, eliminated: boolean)
	player.Team = lost
	player.Neutral = false
	player:SetAttribute(StateKeys.Player.Alive, false)
	player:SetAttribute(StateKeys.Player.Injured, false)
	player:SetAttribute(StateKeys.Player.Eliminated, eliminated)
	player:SetAttribute(StateKeys.Player.ReviveEndsAt, 0)
	player:SetAttribute(StateKeys.Player.Hidden, false)
	player:SetAttribute(StateKeys.Player.InSafeZone, false)
	player:SetAttribute(StateKeys.Player.Spectating, eliminated)
end

--- Everyone back to the lobby, round stats cleared.
function TeamService.resetAll()
	for _, player in Players:GetPlayers() do
		TeamService.exitRound(player, false)
		player:SetAttribute(StateKeys.Player.Spectating, false)
		player:SetAttribute(StateKeys.Player.RoundTasks, 0)
		player:SetAttribute(StateKeys.Player.RoundRevives, 0)
		player:SetAttribute(StateKeys.Player.CarriedCrosses, 0)
		player:SetAttribute(StateKeys.Player.Noise, 0)
	end
end

--==========================================================================
-- Lifecycle
--==========================================================================

function TeamService.start()
	survivors = ensureTeam("Survivors", SURVIVOR_COLOR, false)
	lost = ensureTeam("Lost", LOST_COLOR, true)

	local function onPlayerAdded(player: Player)
		player.Team = lost
		player.Neutral = false
		player:SetAttribute(StateKeys.Player.Alive, false)
		player:SetAttribute(StateKeys.Player.Injured, false)
		player:SetAttribute(StateKeys.Player.Eliminated, false)
		player:SetAttribute(StateKeys.Player.Noise, 0)
		player:SetAttribute(StateKeys.Player.NoiseTier, "Quiet")
		player:SetAttribute(StateKeys.Player.Stamina, 100)
		player:SetAttribute(StateKeys.Player.RoundTasks, 0)
		player:SetAttribute(StateKeys.Player.RoundRevives, 0)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end
end

return TeamService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX34">
				<Properties>
					<string name="Name">VoteService</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	VoteService.luau
	--------------------------------------------------------------------------
	Map voting during the intermission.

	Vote counts live as attributes on ReplicatedStorage.DollysHome.State.Votes,
	one per map id, so the tally updates on every client the instant it changes
	without a single RemoteEvent firing.
	--------------------------------------------------------------------------
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local StateKeys = require(Shared.StateKeys)
local Util = require(Shared.Util)

local VoteService = {}

local votes: { [Player]: string } = {}
local open = false
local rng = Random.new()

--==========================================================================
-- Tally
--==========================================================================

local function publishTally()
	local counts: { [string]: number } = {}
	for _, map in Config.getEnabledMaps() do
		counts[map.Id] = 0
	end
	for _, mapId in votes do
		if counts[mapId] ~= nil then
			counts[mapId] += 1
		end
	end

	local folder = Net.getVotesFolder()
	for mapId, count in counts do
		if folder:GetAttribute(mapId) ~= count then
			folder:SetAttribute(mapId, count)
		end
	end
end

local function isVotable(mapId: string): boolean
	for _, map in Config.getEnabledMaps() do
		if map.Id == mapId then
			return true
		end
	end
	return false
end

--==========================================================================
-- Public
--==========================================================================

function VoteService.openVoting()
	table.clear(votes)
	open = true
	Net.setStateValue(StateKeys.Game.VotingOpen, true)
	publishTally()
end

--- Closes voting and returns the winning map id. Ties break randomly.
function VoteService.closeVoting(): string
	open = false
	Net.setStateValue(StateKeys.Game.VotingOpen, false)

	local enabled = Config.getEnabledMaps()
	if #enabled == 0 then
		Util.warn("VoteService", "no maps are enabled in Config.Maps")
		return "TheHouse"
	end

	local counts: { [string]: number } = {}
	for _, map in enabled do
		counts[map.Id] = 0
	end
	for _, mapId in votes do
		if counts[mapId] ~= nil then
			counts[mapId] += 1
		end
	end

	local best = -1
	local leaders: { string } = {}
	for _, map in enabled do
		local count = counts[map.Id]
		if count > best then
			best = count
			leaders = { map.Id }
		elseif count == best then
			table.insert(leaders, map.Id)
		end
	end

	local winner = Util.pick(leaders, rng) or enabled[1].Id
	Net.setStateValue(StateKeys.Game.NextMapId, winner)
	Util.log("VoteService", "map vote won by %s (%d votes)", winner, best)
	return winner
end

function VoteService.getVote(player: Player): string?
	return votes[player]
end

function VoteService.isOpen(): boolean
	return open
end

--==========================================================================
-- Lifecycle
--==========================================================================

function VoteService.start()
	Net.Events.CastVote.OnServerEvent:Connect(function(player, mapId)
		if not open or type(mapId) ~= "string" or not isVotable(mapId) then
			return
		end
		-- Voting again just moves your vote.
		votes[player] = mapId
		publishTally()
	end)

	Players.PlayerRemoving:Connect(function(player)
		if votes[player] then
			votes[player] = nil
			publishTally()
		end
	end)

	publishTally()
end

return VoteService
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
</roblox>
